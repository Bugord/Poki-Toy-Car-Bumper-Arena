/* Sizes are in reference pixels of a 1080x1920 portrait screen (the panel scales with the screen, expanding on the
   other axis, so a landscape screen is as tall as the portrait one and wider). They are the numbers of the Claude
   Design canvas "Toy Car Arena UI", whose stage is drawn in these same pixels. Colours are the palette in ui_theme
   (var(--navy) and the rest).

   The shared vocabulary, as in SMUP:
   - screen: a full-screen layer, white text over the game; screen--dimmed puts the navy dim under it.
   - card: the white rounded sticker the result sits on, navy text. inset: a flat soft panel inside a card. rule: a
     soft line across a card.
   - pill: a white sticker pill, navy text.
   - display: outlined title text. stroke: outlined text with the outline outside the letters, as the design draws
     it: the text twice, the second label (stroke__face) without outline and drop over the first.
   - caption: small muted spaced-out text.
   - watch: the stopwatch icon, built from elements so the build carries no image for it.
   - button: a sticker button; button--green is the one to press, button--big the tall one. Its first child is always
     button__face, the coloured face over the darker band along its bottom; button__label is its text over the face.
   - key: a keyboard key cap (the SPACE hint).
   - pip: a little car seen from above, wheels and all (the PUSHED OFF BY badge); its pip__body takes the colour.
   - ko-star: the knock-out mark, a jagged gold burst in a navy outline drawn in code (HudView.DrawBurst);
     ko-star--big is the one on the KNOCKOUT! sticker.
   - best: a small chip with the player's best (BEST #2); best--new is the gold NEW BEST! sticker.
   - car-color--N: the body colour of car N of the round (0 the player, 1..N the bots), as CarLook paints it.

   A sticker's hard drop is a thicker navy bottom border: 9 px of outline and the drop under it (20 in all on pills,
   25 on cards). That border would squash the bottom corners of the fill inside it, so PillShape redraws such an
   element with them round, and gives an element with border-radius: 999px round ends (UI Toolkit would draw an
   ellipse). UI Toolkit draws no box-shadow, gap or gradient: spacing between siblings is their margins. */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    color: var(--white);
}

.screen--dimmed {
    background-color: rgba(29, 43, 79, 0.6);
}

.card {
    align-items: center;
    width: 981px;
    padding: 46px 50px 50px 50px;
    border-width: 9px;
    border-bottom-width: 25px;
    border-color: var(--navy);
    border-radius: 58px;
    background-color: var(--white);
    color: var(--navy);
}

.inset {
    flex-direction: row;
    align-self: stretch;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px 24px 30px;
    border-radius: 40px;
    background-color: var(--soft);
}

.rule {
    flex-shrink: 0;
    align-self: stretch;
    height: 7px;
    margin: 40px 0;
    border-radius: 4px;
    background-color: var(--soft);
}

.pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    color: var(--navy);
}

.display {
    color: var(--white);
    -unity-text-outline-width: 18px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.caption {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 3px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The stopwatch: a gold dial in a navy ring, the knob on top of the ring and the hand pointing up. */
.watch {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    margin-top: 12px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 32px;
    background-color: var(--gold);
}

.watch__knob {
    position: absolute;
    left: 14px;
    top: -22px;
    width: 20px;
    height: 14px;
    border-radius: 4px;
    background-color: var(--navy);
}

.watch__hand {
    position: absolute;
    left: 20px;
    top: 5px;
    width: 8px;
    height: 22px;
    border-radius: 4px;
    background-color: var(--navy);
}

/* The sticker button. Its height comes from its padding and content, never height or min-height. Every view drops the
   theme's unity-button class (Button.ussClassName), so this styles alone. The face covers the button but the bottom
   16 px, which show the button's own colour as the darker band; the label comes after it, so it draws over it. A
   button's text goes in a button__label, never in its text attribute, which the face would cover. Pressed, it sinks
   onto its drop and keeps its layout: its border and fill go transparent and PillShape draws it without the drop. */
.button {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-width: 504px;
    margin: 0;
    padding: 19px 50px 35px 50px;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 50px;
    background-color: var(--shade);
    background-image: none;
    color: var(--navy);
    font-size: 63px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.button__face {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 16px;
    border-radius: 41px;
    background-color: var(--white);
}

.button:hover > .button__face,
.button:focus > .button__face {
    background-color: var(--soft);
}

.button:active {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    translate: 0 11px;
}

.button__label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The one to press. White label with a navy stroke. */
.button--green {
    background-color: var(--green-shade);
}

.button--green > .button__face {
    background-color: var(--green);
}

.button--green:hover > .button__face,
.button--green:focus > .button__face {
    background-color: var(--green-hover);
}

.button--green .button__label {
    color: var(--white);
    -unity-text-outline-width: 16px;
    -unity-text-outline-color: var(--navy);
}

/* The tall button at the bottom of the result screen. */
.button--big {
    padding: 24px 50px 46px 50px;
    border-width: 11px;
    border-bottom-width: 27px;
    border-radius: 68px;
}

.button--big > .button__face {
    bottom: 23px;
    border-radius: 57px;
}

.button--big .button__label {
    font-size: 104px;
}

.button--big:active {
    translate: 0 16px;
}

.key {
    margin-left: 20px;
    padding: 0 26px 4px 26px;
    border-width: 7px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 18px;
    background-color: var(--white);
}

.key__text {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 2px;
    color: var(--navy);
    -unity-text-align: middle-center;
}

/* The knock-out burst (HudView.DrawBurst): its fill is this colour, its outline navy. */
.ko-star {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    color: var(--gold);
}

.ko-star--big {
    width: 124px;
    height: 124px;
}

/* Hidden until the view gives it best--shown. NEW BEST! springs in after the card (round-over--enter). */
.best {
    display: none;
    margin: 0;
    padding: 4px 22px 8px 22px;
    border-radius: 999px;
    background-color: var(--soft);
    font-size: 36px;
    letter-spacing: 2px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    transition-delay: 0.35s;
}

.best--shown {
    display: flex;
}

.best--new {
    border-width: 6px;
    border-color: var(--navy);
    background-color: var(--gold);
    color: var(--navy);
    rotate: -4deg;
}

/* The opaque cover while the arena scene loads. It takes every click and touch, so nothing under it is pressed. */
.curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--navy);
}

/* Lobby uses the same reference height in portrait and landscape (PanelSettings Expand). The seven seats fit in
   one centred column; departed seats outside a smaller next round collapse out of that column. */
.lobby {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 60px 40px;
}

.lobby__title {
    height: 140px;
    margin: 0 0 48px 0;
    padding: 0;
    rotate: -3deg;
}

.lobby__title-text {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 112px;
    -unity-text-align: middle-center;
    color: var(--gold);
    -unity-text-outline-width: 10px;
}

.lobby__title-text.stroke__drop { translate: 0 10px; display: flex; }

.lobby__title--ready .lobby__title-text { color: var(--green); }

/* FINDING PLAYERS is longer than the other titles, and longer still in French or Portuguese: smaller, in a title of
   the same height, so the seats below do not jump when it turns to MATCH FOUND!. */
.lobby__title--search .lobby__title-text { font-size: 84px; }

/* The arena of the coming round, a compact pill between the title and the seven seats (about 150 px with its margins). */
.lobby__arena {
    flex-direction: row;
    align-items: center;
    height: 96px;
    margin: -20px 0 36px 0;
    padding: 0 30px;
    border-width: 6px;
    border-bottom-width: 12px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}
.lobby__arena-label { height: 52px; margin-right: 16px; }
.lobby__arena-label .sticker-text__text {
    font-size: 36px;
    color: var(--muted);
    -unity-text-outline-width: 0;
}
.lobby__arena-name { height: 66px; }
.lobby__arena-name .sticker-text__text {
    font-size: 54px;
    color: var(--navy);
    -unity-text-outline-width: 0;
}
.lobby__arena .lobby__badge {
    width: auto;
    min-width: 100px;
    height: 62px;
    margin-left: 18px;
    padding: 0 12px;
}
.lobby__arena .lobby__badge .sticker-text__text { font-size: 30px; }
/* A special round's card under the arena pill: its name on a tilted orange tag over the card's top edge, the rule big
   on the white card. */
.lobby__special {
    align-items: center;
    width: 920px;
    max-width: 100%;
    margin: 20px 0 34px 0;
    padding: 0 36px 26px 36px;
    border-width: 6px;
    border-bottom-width: 12px;
    border-color: var(--navy);
    border-radius: 44px;
    background-color: var(--white);
}

.lobby__special .lobby__badge--special {
    width: auto;
    height: 76px;
    margin: -40px 0 14px 0;
    padding: 0 30px;
    background-color: var(--orange);
    rotate: -3deg;
}

.lobby__special .lobby__badge--special .sticker-text__text {
    font-size: 42px;
    color: var(--white);
    -unity-text-outline-width: 8px;
    -unity-text-outline-color: var(--navy);
}

/* Only the lower layer carries the outline: on the face it would eat into the letters from inside. */
.lobby__special .lobby__badge--special .sticker-text__text.stroke__face { -unity-text-outline-width: 0; }

.lobby__special-rule {
    margin: 0;
    padding: 0;
    font-size: 46px;
    color: var(--navy);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* The REVENGE rival's row: pale red, with a red plaque at its end. */
.lobby__row.lobby__row--rival { background-color: rgb(255, 226, 226); }

.lobby__row .lobby__badge--revenge {
    width: auto;
    padding: 0 22px;
    background-color: var(--red);
}

.lobby__row .lobby__badge--revenge .sticker-text__text { color: var(--white); }

.lobby__rows {
    width: 920px;
    max-width: 100%;
}

.lobby__slot {
    flex-shrink: 0;
    height: 122px;
    margin-bottom: 12px;
}

/* A found seat is a white sticker with a navy outline and a hard shadow under it, as the menu's cards; the player's
   own is pale gold. The radius is set, not 999px: rows are built after PillShape looked at the screen. */
.lobby__row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 122px;
    flex-direction: row;
    align-items: center;
    padding: 0 26px 0 14px;
    border-width: 6px;
    border-bottom-width: 12px;
    border-color: var(--navy);
    border-radius: 40px;
    background-color: var(--white);
}

.lobby__row--you { background-color: rgb(255, 236, 168); }

.lobby__name {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: 54px;
    color: var(--navy);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.lobby__name--revenge, .lobby__name--revenge > .stroke__face { color: var(--red); }

.lobby__row .revenge-target {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    margin-left: 12px;
    margin-right: 12px;
}

.lobby__badge {
    flex-shrink: 0;
    width: 122px;
    margin: 0 0 0 12px;
    padding: 8px 0;
    border-width: 5px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    border-radius: 22px;
    background-color: var(--gold);
    color: var(--navy);
    font-size: 36px;
    -unity-text-align: middle-center;
}

.lobby__row--left { background-color: var(--track); }
.lobby__row--left .lobby__name { color: var(--muted); }
.lobby__badge--left { background-color: var(--silver); }
.lobby__badge--streak { width: auto; padding: 8px 18px; rotate: -3deg; }

/* A seat still searching: a quiet translucent strip without an outline, a spinning ring and SEARCHING..., until the
   white sticker of a found player pops in over it. */
.lobby__row.lobby__row--searching {
    padding-left: 28px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.08);
}

.lobby__spinner {
    flex-shrink: 0;
    width: 66px;
    height: 66px;
    margin-right: 22px;
    border-width: 9px;
    border-radius: 33px;
    border-color: rgba(255, 255, 255, 0.18);
    border-top-color: var(--gold);
}

.lobby__searching-text {
    margin: 0;
    padding: 0;
    font-size: 46px;
    color: var(--silver);
    opacity: 0.75;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.lobby__badge > .stroke__face {
    width: auto;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* The HUD: one white bar at the top centre, 54 px from the edge: the stopwatch, a chip per car still in the round with
   their count, and from the first knock-out the player's KOs, each part split off by a short rule. On a wide screen it
   stays in the middle, over the arena. Each part keeps its own name, so the name tags and the feed keep clear of it. */
.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding-top: 54px;
}

.hud__bar {
    flex-shrink: 0;
    height: 136px;
    padding: 0 30px 0 12px;
    /* A match's last seconds grow the bar (HudEndTimer) from its top centre, so it stays under the screen's edge. */
    transform-origin: 50% 0;
}

.hud__section {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 100%;
    border-radius: 999px;
}

.hud__sep {
    flex-shrink: 0;
    width: 8px;
    height: 64px;
    margin: 0 22px 0 18px;
    border-radius: 4px;
    background-color: var(--shade);
}

.hud__timer {
    padding: 0 16px 0 12px;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* The time, wide enough for any m:ss so the pill does not change width every second. */
.hud__time {
    min-width: 130px;
    margin-left: 14px;
}

.hud__time-text {
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 76px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The last seconds: the pill turns red, the time white with a navy stroke, the dial white, and the pill beats once a
   second (HudView sets hud__timer--beat for a moment). */
.hud__timer--urgent {
    background-color: var(--red);
}

.hud__timer--urgent .watch {
    background-color: var(--white);
}

.hud__timer--urgent .hud__time-text {
    color: var(--white);
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
}

.hud__timer--beat {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

/* At 0:30 of a match the time flashes gold once (HudEndTimer). */
.hud__timer--flash {
    background-color: var(--gold);
    transition-property: scale, background-color;
    transition-duration: 0.05s;
}

/* The cars left: the middle of the bar, a stack of overlapping round
   chips, one per car still in (HudView builds them), each in the car's colour (car-color) with a little white car seen
   from above in it, and the count after them. The bots come first and the player's chip last, in front on the
   right, with the white ring of its marker on the arena inside its outline. The pill pops when a car goes out
   (hud__cars--pop) and the count punches (hud__cars-count--punch). */
.hud__cars {
    padding: 0;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__cars--pop {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

/* Every chip overlaps the one before it by 30 px; the row's padding gives the first one's overlap back. */
.hud__chips {
    flex-direction: row;
    align-items: center;
    padding-left: 30px;
}

/* A chip's place in the stack. The chip itself is laid over it, so when a car goes out its place narrows to nothing
   (hud__chip-slot--closing: what is left is the overlap) and the chips after it slide over, while the chip keeps its
   round shape. */
.hud__chip-slot {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    margin-left: -30px;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__chip-slot--closing {
    width: 30px;
}

/* Leaving, the chip hops up from the stack spinning (hud__chip--hop), then falls as it shrinks to nothing
   (hud__chip--fall), as the effects on the arena vanish: 0.4 s in all (HudView times the two). */
.hud__chip {
    position: absolute;
    left: 0;
    top: 0;
    width: 80px;
    height: 80px;
    align-items: center;
    justify-content: center;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 40px;
    transition-property: translate, rotate, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud__chip--hop {
    translate: 0 -60px;
    rotate: 100deg;
    scale: 0.9 0.9;
}

.hud__chip--fall {
    translate: 0 10px;
    rotate: 200deg;
    scale: 0 0;
    transition-duration: 0.25s;
    transition-timing-function: ease-in;
}

/* The player's chip: a white ring just inside its navy outline. */
.hud__chip-ring {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 6px;
    border-color: var(--white);
    border-radius: 33px;
}

.hud__chip--player > .hud__chip-ring { display: flex; }

/* The car from the side, drawn in code (CarColor.DrawCar); a little low so the wheels sit on the chip's middle. */
.hud__chip-car {
    width: 50px;
    height: 36px;
    margin-top: 4px;
}

.hud__cars-count {
    margin: 0 0 0 14px;
    padding: 0 0 6px 0;
    font-size: 68px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__cars-count--punch {
    scale: 1.3 1.3;
    transition-duration: 0.05s;
}

/* The little car of the PUSHED OFF BY badge: four wheels under a body with a windscreen. */
.pip {
    flex-shrink: 0;
    width: 52px;
    height: 68px;
}

.pip__wheel {
    position: absolute;
    width: 12px;
    height: 20px;
    border-radius: 4px;
    background-color: var(--navy);
}

.pip__wheel--front-left {
    left: 0;
    top: 8px;
}

.pip__wheel--front-right {
    right: 0;
    top: 8px;
}

.pip__wheel--back-left {
    left: 0;
    bottom: 8px;
}

.pip__wheel--back-right {
    right: 0;
    bottom: 8px;
}

.pip__body {
    position: absolute;
    left: 6px;
    top: 0;
    width: 40px;
    height: 68px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 13px;
    background-color: var(--white);
}

.pip__glass {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 10px;
    height: 12px;
    border-radius: 3px;
    background-color: var(--navy);
}

/* The player's knock-outs: a small white pill with the star under the cars pill, there from the first knock-out on
   (HudView sets hud__ko--shown), popping at each one. */
.hud__ko {
    display: none;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__ko--shown {
    display: flex;
}

.hud__ko--pop {
    scale: 1.25 1.25;
    transition-duration: 0.05s;
}

.hud__ko-text {
    margin: 0 0 0 12px;
    padding: 0 0 6px 0;
    font-size: 68px;
    color: var(--navy);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* KNOCKOUT! when the player knocks a car out (HudView builds one per knock-out and places it over where the car went
   over the edge): the star and the word on a tilted sticker that springs in from small (ko-pop--start, taken off once
   it is laid out), holds, and flies up as it fades (ko-pop--leave). The outer ko-pop is centred on its point. */
.hud__popups {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Scaled down as a whole: the sticker's own scale is its animation. */
.ko-pop {
    position: absolute;
    translate: -50% -50%;
    scale: 0.65 0.65;
}

.ko-pop__sticker {
    flex-direction: row;
    align-items: center;
    transition-property: scale, translate, opacity;
    transition-duration: 0.3s, 0.3s, 0.12s;
    transition-timing-function: ease-out-back, ease-out, linear;
}

.ko-pop--start .ko-pop__sticker {
    scale: 0.2 0.2;
    opacity: 0;
}

.ko-pop--leave .ko-pop__sticker {
    scale: 1.15 1.15;
    translate: 0 -160px;
    opacity: 0;
    transition-duration: 0.35s;
    transition-timing-function: ease-in;
}

.ko-pop__text {
    margin: 0 0 0 16px;
    padding: 0;
    font-size: 120px;
    color: var(--gold);
}

.ko-pop__text.stroke__drop { translate: 0 18px; display: flex; }

.ko-pop--revenge .ko-pop__text {
    color: var(--red);
}

.ko-pop--revenge .ko-star {
    color: var(--orange);
}

/* The player's knock-outs in a row: DOUBLE! in orange and bigger, TRIPLE! and RAMPAGE! bigger still, in pink. */
.ko-pop--combo .ko-pop__text {
    font-size: 144px;
    color: var(--orange);
}

.ko-pop--combo-big .ko-pop__text {
    font-size: 168px;
    color: rgb(255, 92, 160);
}

/* A match's item used by the player (MEGA!, SHOCKWAVE!, BOMB!, BOWLING!, BALLOON!, OIL SLICK! and the rest): the word alone, in the
   kind's colour, the same sticker as KNOCKOUT! otherwise. */
.ko-pop--power .ko-pop__text {
    margin-left: 0;
    font-size: 100px;
}

.ko-pop--mega .ko-pop__text { color: rgb(127, 147, 234); }
.ko-pop--shockwave .ko-pop__text { color: rgb(79, 214, 220); }
.ko-pop--shield .ko-pop__text { color: var(--blue); }
.ko-pop--turbo .ko-pop__text { color: var(--gold); }
.ko-pop--bomb .ko-pop__text { color: rgb(255, 106, 85); }
.ko-pop--glove .ko-pop__text { color: var(--red); }
.ko-pop--bowling .ko-pop__text { color: rgb(62, 196, 160); }
.ko-pop--balloon .ko-pop__text { color: rgb(255, 92, 160); }
.ko-pop--oil .ko-pop__text { color: rgb(255, 184, 46); }
.ko-pop--boost .ko-pop__text { color: var(--orange); }

/* Visit handles follow the bots; the inner sticker animates independently of its projected anchor. */
.car-name {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
}

.car-name__sticker {
    align-items: center;
    border-radius: 24px;
    background-color: var(--name-backdrop);
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.car-name__line {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
}

/* The tail under a handle, pointing at its car; hangs below the sticker so the tag's bottom is its tip. */
.car-name__tail {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 28px;
    height: 16px;
    margin-left: -14px;
    color: var(--name-backdrop);
}

.car-name { padding-bottom: 16px; }

/* Before GO! the handles are faint, under the countdown. Colours, not opacity: a translucent outlined text lets its
   stroke layer show through the face as a dark rim inside every letter. */
.car-names--waiting .car-name__sticker { background-color: rgba(29, 43, 79, 0.3); }
.car-names--waiting .car-name__tail { color: rgba(29, 43, 79, 0.3); }
.car-names--waiting .car-name__text { color: rgb(196, 204, 222); }
.car-names--waiting .car-name--revenge .car-name__text { color: rgb(236, 150, 150); }
.car-names--waiting .car-name__level { opacity: 0.6; }

.car-name__level {
    min-width: 46px;
    height: 40px;
    padding: 0 6px;
    border-width: 4px;
    border-bottom-width: 7px;
    border-radius: 12px;
}

.car-name__level .level-badge__value {
    font-size: 26px;
}

.car-name__text {
    margin: 0;
    padding: 0 14px 3px 14px;
    font-size: 44px;
    color: var(--white);
    -unity-text-outline-width: 6px;
}

/* A bot that joined on a win streak: the player's crown and ×N, after the name. */
.car-name__crown {
    flex-shrink: 0;
    width: 46px;
    height: 32px;
    margin-left: -6px;
}

.car-name__streak {
    margin: 0 10px 0 2px;
    padding: 0 0 3px 0;
    font-size: 38px;
    color: var(--gold);
    -unity-text-outline-width: 6px;
}

.car-name__revenge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 2px 10px 0 10px;
}

.car-name__revenge-text {
    margin: 0;
    padding: 0;
    font-size: 32px;
    letter-spacing: 1px;
    color: var(--orange);
    -unity-text-outline-width: 5px;
}

.car-name--revenge .car-name__text {
    color: var(--red);
}

/* A tiny bullseye, built from concentric rings and a centre dot. */
.revenge-target {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-right: 8px;
    border-width: 4px;
    border-color: var(--orange);
    border-radius: 14px;
    background-color: var(--navy);
}

.revenge-target__center {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--red);
}

.car-name--enter .car-name__sticker {
    scale: 0.2 0.2;
    opacity: 0;
}

.car-name--pulse .car-name__sticker {
    scale: 1.15 1.15;
    transition-duration: 0.12s;
}

.car-name--leave .car-name__sticker {
    scale: 0 0;
    opacity: 0;
    transition-duration: 0.4s;
    transition-timing-function: ease-in;
}

/* A match: while the player's car is out, BACK IN and the seconds to its comeback on a tilted white sticker in the
   middle of the screen, where the car is not (HudView shows it with hud__respawn--shown and pops it each second). */
.hud__respawn {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    align-items: center;
}

.hud__respawn--shown {
    display: flex;
}

.hud__respawn-sticker {
    padding: 0 44px 0 48px;
    rotate: -3deg;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.hud__respawn--pop .hud__respawn-sticker {
    scale: 1.15 1.15;
    transition-duration: 0.05s;
}

.hud__respawn-text {
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 64px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__respawn-count {
    min-width: 76px;
    margin-left: 22px;
}

.hud__respawn-number {
    margin: 0;
    padding: 0 0 10px 0;
    font-size: 112px;
    color: var(--orange);
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__respawn-number.stroke__drop { translate: 0 10px; display: flex; }

/* HOT POTATO: the fuse's seconds over the bomb (HudPotato places it), red and beating in its last seconds, and the
   tilted PASS IT! under the bar while the player holds the bomb. */
.hud__fuse {
    display: none;
    position: absolute;
    translate: -50% -50%;
    align-items: center;
}

.hud__fuse--shown {
    display: flex;
}

.hud__fuse-sticker {
    min-width: 92px;
    height: 76px;
    padding: 0 18px;
    align-items: center;
    justify-content: center;
    border-radius: 38px;
    border-width: 5px 5px 11px 5px;
    border-color: var(--navy);
    background-color: var(--white);
}

.hud__fuse-text {
    margin: 0;
    padding: 0;
    font-size: 50px;
    color: var(--navy);
    -unity-text-outline-width: 0;
    -unity-text-align: middle-center;
}

.hud__fuse--short .hud__fuse-sticker {
    background-color: var(--red);
}

.hud__fuse--short .hud__fuse-text {
    color: var(--white);
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: var(--navy);
}

/* Only the white digits of the last seconds have a drop: under the navy digits on white it would only double them. */
.hud__fuse--short .hud__fuse-text.stroke__drop { translate: 0 6px; display: flex; }

.hud__pass {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
    scale: 0.4 0.4;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.3s, 0.15s;
    transition-timing-function: ease-out-back, linear;
}

.hud__pass--shown {
    scale: 1 1;
    opacity: 1;
}

.hud__pass-sticker {
    padding: 6px 40px 10px 40px;
    border-radius: 28px;
    border-width: 6px 6px 14px 6px;
    border-color: var(--navy);
    background-color: var(--orange);
    rotate: -4deg;
}

.hud__pass-text {
    margin: 0;
    padding: 0;
    font-size: 78px;
    color: var(--white);
    -unity-text-outline-width: 8px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__pass-text.stroke__drop { translate: 0 10px; display: flex; }

/* A match: SAFE over the player's car while it is safe after coming back (HudView places it over the car's marker),
   on the dark backdrop of the bots' handles, with a bar that runs down with the safe time. */
.hud__shield {
    display: none;
    position: absolute;
    translate: -50% -100%;
    align-items: center;
}

.hud__shield--shown {
    display: flex;
}

.hud__shield-sticker {
    align-items: center;
    padding: 2px 20px 12px 20px;
    border-radius: 24px;
    background-color: var(--name-backdrop);
}

.hud__shield-text {
    margin: 0;
    padding: 0 0 3px 0;
    font-size: 44px;
    color: var(--blue);
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__shield-bar {
    width: 140px;
    height: 18px;
    margin-top: 2px;
    border-width: 4px;
    border-color: var(--navy);
    border-radius: 9px;
    background-color: var(--white);
    overflow: hidden;
}

/* The win streak over the player's car (HudView places it like SAFE): a gold crown over ×N. */
.hud__streak {
    display: none;
    position: absolute;
    translate: -50% -100%;
    align-items: center;
}

.hud__streak--shown {
    display: flex;
}

.hud__streak-crown {
    width: 72px;
    height: 50px;
}

.hud__streak-text {
    margin: -6px 0 0 0;
    padding: 0;
    font-size: 44px;
    color: var(--gold);
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__streak-text.stroke__drop { translate: 0 6px; display: flex; }

.hud__shield-fill {
    width: 100%;
    height: 100%;
    background-color: var(--blue);
}

/* The joystick under a steering finger (HudView places and sizes both parts from the driver's joystick): a pale
   see-through disc with a navy outline where the finger came down, and on it a white knob sticker with its navy drop
   under the finger. They spring in as the finger starts to steer and shrink away as it lets go. The layer covers the
   screen so both are placed in its pixels. */
.hud__stick {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__stick-base,
.hud__stick-knob {
    position: absolute;
    border-radius: 999px;
    border-color: var(--navy);
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.hud__stick-base {
    border-width: 8px;
    background-color: rgba(255, 255, 255, 0.3);
}

.hud__stick-knob {
    border-width: 8px;
    border-bottom-width: 16px;
    background-color: var(--white);
}

.hud__stick--shown .hud__stick-base {
    opacity: 0.8;
    scale: 1 1;
    transition-timing-function: ease-out-back;
}

.hud__stick--shown .hud__stick-knob {
    opacity: 1;
    scale: 1 1;
    transition-timing-function: ease-out-back;
}

/* The boost button, on a touch screen only (HudView shows it once the screen is one): a round white sticker at the
   bottom right by default, opposite each new steering touch. Its slot shrinks before switching sides so the ready
   pop and pressed motion can stay on the button itself. The charge is an orange disc in it that grows from
   the middle as the boost cools down (HudView scales it); once it fills the button, the button turns orange, its label
   white with a navy stroke, and it pops (hud__boost--pop for a moment). Pressed, it sinks onto its drop. */
.hud__boost-slot {
    position: absolute;
    right: 64px;
    bottom: 220px;
    width: 300px;
    height: 300px;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.hud__boost-slot--left {
    left: 64px;
    right: auto;
}

.hud__boost-slot--moving {
    scale: 0 0;
    opacity: 0;
}

/* A match: the ability the player's car runs, as a white sticker above the boost button (so the thumb on the button
   does not cover it) in the slot, which follows the thumb's side in both orientations. Icon, name and a bar that drains
   with the time say it without colour alone. It springs in over 0.2 s and leaves faster (HudView toggles
   hud__power--shown; the kind's class colours the bar and icon). It takes no touch. */
.hud__power {
    position: absolute;
    left: -10px;
    top: -140px;
    width: 320px;
    height: 112px;
    padding: 0 20px 0 14px;
    justify-content: flex-start;
    scale: 0 0;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-in;
}

.hud__power--shown {
    scale: 1 1;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.hud__power-icon {
    flex-shrink: 0;
    width: 68px;
    height: 68px;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--soft);
}

.hud__power-icon--mega { background-color: rgb(95, 116, 203); }
.hud__power-icon--shield { background-color: var(--blue); }
.hud__power-icon--turbo { background-color: var(--gold); }
.hud__power-icon--balloon { background-color: rgb(255, 92, 160); }

/* A weight, a bubble and a diamond (a spark), in navy and white on the kind's colour. */
.hud__power-glyph {
    width: 26px;
    height: 26px;
}

.hud__power-icon--mega .hud__power-glyph {
    height: 22px;
    border-radius: 8px;
    background-color: var(--navy);
}

.hud__power-icon--shield .hud__power-glyph {
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

/* A balloon: a white oval with a navy rim. */
.hud__power-icon--balloon .hud__power-glyph {
    width: 22px;
    height: 28px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

.hud__power-icon--turbo .hud__power-glyph {
    width: 20px;
    height: 20px;
    rotate: 45deg;
    background-color: var(--navy);
}

.hud__power-info {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    margin-left: 14px;
}

.hud__power-name {
    margin: 0;
    padding: 0 0 2px 0;
    font-size: 40px;
    color: var(--navy);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.hud__power-bar {
    height: 18px;
    border-width: 4px;
    border-color: var(--navy);
    border-radius: 9px;
    background-color: var(--track);
    overflow: hidden;
}

.hud__power-fill {
    width: 100%;
    height: 100%;
    background-color: var(--blue);
}

.hud__power--mega .hud__power-fill { background-color: rgb(95, 116, 203); }
.hud__power--shield .hud__power-fill { background-color: var(--blue); }
.hud__power--turbo .hud__power-fill { background-color: var(--gold); }
.hud__power--balloon .hud__power-fill { background-color: rgb(255, 92, 160); }

.hud__boost {
    display: none;
    width: 300px;
    height: 300px;
    align-items: center;
    justify-content: center;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    opacity: 0.85;
    transition-property: scale, translate, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud__boost--shown {
    display: flex;
}

/* Centred in the button's fill, which the thicker bottom border makes 282 x 271. */
.hud__boost-charge {
    position: absolute;
    left: 23px;
    top: 17px;
    width: 236px;
    height: 236px;
    border-radius: 118px;
    background-color: var(--orange);
}

.hud__boost-text {
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 72px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__boost--ready {
    background-color: var(--orange);
    opacity: 1;
}

/* Without a touch screen: a smaller gauge in the slot's bottom-right corner, its key under the word. */
.hud__boost--desktop {
    width: 230px;
    height: 230px;
    margin-left: 70px;
    margin-top: 70px;
}

.hud__boost--desktop .hud__boost-charge {
    left: 16px;
    top: 10px;
    width: 180px;
    height: 180px;
    border-radius: 90px;
}

.hud__boost--desktop .hud__boost-text {
    font-size: 50px;
    padding-bottom: 2px;
}

.hud__boost-key {
    display: none;
    margin: 2px 0 0 0;
    padding: 0 14px 2px 14px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
}

.hud__boost--desktop .hud__boost-key {
    display: flex;
}

.hud__boost-key-text {
    font-size: 26px;
}

.hud__boost--ready .hud__boost-text {
    color: var(--white);
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
}

.hud__boost--pop {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

.hud__boost--hint-pulse {
    scale: 1.08 1.08;
    transition-duration: 0.3s;
}

.hud__boost--pressed {
    translate: 0 11px;
    transition-duration: 0.05s;
}

/* A match's item slot: a round white sticker over BOOST on a touch screen (hud__boost-slot--items, below), so the
   thumb on BOOST never covers it and the steering thumb (on the other side) never reaches it; it follows BOOST's side
   (hud__boost-slot--left). 240 reference pixels is at least 44 pt on a phone held either way. The icon is a disc in the
   item's colour with a glyph of its own shape (a weight, a ring with a dot, a bubble, a diamond, a bomb, a glove), so
   the kind never rests on colour alone; an empty slot shows a faint "?". It spins through the items as a box is broken
   (hud__item--rolling), pops as it lands (hud__item--pop) and sinks as it is pressed. On a desktop it is smaller, to
   the left of the boost gauge, with its E key. */
.hud__item {
    display: none;
    position: absolute;
    left: -205px;
    top: -205px;
    width: 240px;
    height: 240px;
    align-items: center;
    justify-content: center;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    transition-property: scale, translate, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud__item--shown {
    display: flex;
}

.hud__boost-slot--left .hud__item {
    left: 265px;
}

/* With nothing in the slot the button is gone (it picks nothing either, see HudView), and pops back as a box
   is broken. */
.hud__item--empty {
    opacity: 0;
    scale: 0.5 0.5;
}

.hud__item--rolling {
    scale: 1.06 1.06;
}

.hud__item--pop {
    scale: 1.16 1.16;
    transition-duration: 0.06s;
}

.hud__item--pressed {
    translate: 0 11px;
    transition-duration: 0.05s;
}

.hud__item--hint-pulse {
    scale: 1.1 1.1;
    transition-duration: 0.3s;
}

.hud__item-icon {
    width: 160px;
    height: 160px;
    align-items: center;
    justify-content: center;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--soft);
}

.hud__item-icon--mega { background-color: rgb(95, 116, 203); }
.hud__item-icon--shockwave { background-color: rgb(79, 214, 220); }
.hud__item-icon--shield { background-color: var(--blue); }
.hud__item-icon--turbo { background-color: var(--gold); }
.hud__item-icon--bomb { background-color: rgb(255, 106, 85); }
.hud__item-icon--glove { background-color: var(--red); }
.hud__item-icon--bowling { background-color: rgb(62, 196, 160); }
.hud__item-icon--balloon { background-color: rgb(255, 92, 160); }
.hud__item-icon--oil { background-color: rgb(255, 184, 46); }

.hud__item-mark {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 100px;
    color: var(--navy);
    -unity-text-align: middle-center;
}

.hud__item-icon--mega .hud__item-mark,
.hud__item-icon--shockwave .hud__item-mark,
.hud__item-icon--shield .hud__item-mark,
.hud__item-icon--turbo .hud__item-mark,
.hud__item-icon--bomb .hud__item-mark,
.hud__item-icon--glove .hud__item-mark,
.hud__item-icon--bowling .hud__item-mark,
.hud__item-icon--balloon .hud__item-mark,
.hud__item-icon--oil .hud__item-mark {
    display: none;
}

.hud__item-glyph {
    display: none;
    width: 80px;
    height: 80px;
    align-items: center;
    justify-content: center;
}

.hud__item-icon--mega .hud__item-glyph,
.hud__item-icon--shockwave .hud__item-glyph,
.hud__item-icon--shield .hud__item-glyph,
.hud__item-icon--turbo .hud__item-glyph,
.hud__item-icon--bomb .hud__item-glyph,
.hud__item-icon--glove .hud__item-glyph,
.hud__item-icon--bowling .hud__item-glyph,
.hud__item-icon--balloon .hud__item-glyph,
.hud__item-icon--oil .hud__item-glyph {
    display: flex;
}

.hud__item-glyph-part {
    display: none;
    position: absolute;
}

/* Mega, shockwave, bomb, bowling, balloon and oil are drawn pictures (the round's items since v0.7.1): a big car with
   arrows out, a broken ring round a smaller one, a bomb with a lit fuse, a bowling ball, a balloon on a string and a
   drop of oil over a puddle. The others keep their glyphs from parts. */
.hud__item-icon--mega .hud__item-glyph,
.hud__item-icon--shockwave .hud__item-glyph,
.hud__item-icon--bomb .hud__item-glyph,
.hud__item-icon--bowling .hud__item-glyph,
.hud__item-icon--balloon .hud__item-glyph,
.hud__item-icon--oil .hud__item-glyph {
    width: 112px;
    height: 112px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud__item-icon--mega .hud__item-glyph { background-image: url("/Assets/Art/Sprites/UI/sprite_item_mega.svg"); }
.hud__item-icon--shockwave .hud__item-glyph { background-image: url("/Assets/Art/Sprites/UI/sprite_item_shockwave.svg"); }
.hud__item-icon--bomb .hud__item-glyph { background-image: url("/Assets/Art/Sprites/UI/sprite_item_bomb.svg"); }
.hud__item-icon--bowling .hud__item-glyph { background-image: url("/Assets/Art/Sprites/UI/sprite_item_bowling.svg"); }
.hud__item-icon--balloon .hud__item-glyph { background-image: url("/Assets/Art/Sprites/UI/sprite_item_balloon.svg"); }
.hud__item-icon--oil .hud__item-glyph { background-image: url("/Assets/Art/Sprites/UI/sprite_item_oil.svg"); }

/* A shield: a white bubble with a navy rim. */
.hud__item-icon--shield .hud__item-glyph {
    width: 84px;
    height: 84px;
    border-width: 10px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

/* A turbo: a navy diamond with a white spark. */
.hud__item-icon--turbo .hud__item-glyph {
    width: 60px;
    height: 60px;
    rotate: 45deg;
    background-color: var(--navy);
}

.hud__item-icon--turbo .hud__item-glyph-part {
    display: flex;
    width: 20px;
    height: 20px;
    background-color: var(--white);
}

/* A glove: a white fist with a thumb, outlined. */
.hud__item-icon--glove .hud__item-glyph {
    width: 80px;
    height: 70px;
    margin-left: 14px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 30px;
    background-color: var(--white);
}

.hud__item-icon--glove .hud__item-glyph-part {
    display: flex;
    left: -30px;
    top: 14px;
    width: 38px;
    height: 34px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

.hud__item-key {
    display: none;
    position: absolute;
    right: -26px;
    bottom: -30px;
    margin: 0;
    padding: 0 14px 2px 14px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
}

.hud__item-key-text {
    font-size: 32px;
}

.hud__item--desktop {
    left: -110px;
    top: 105px;
    width: 160px;
    height: 160px;
    border-width: 7px;
    border-bottom-width: 14px;
}

.hud__boost-slot--left .hud__item--desktop {
    left: 310px;
}

.hud__item--desktop .hud__item-icon {
    width: 110px;
    height: 110px;
    border-width: 6px;
}

.hud__item--desktop .hud__item-glyph {
    scale: 0.68 0.68;
}

.hud__item--desktop .hud__item-mark {
    font-size: 70px;
}

.hud__item--desktop .hud__item-key {
    display: flex;
}

/* On a touch screen the item button stands over BOOST and a little toward the screen's edge: up and inward of it, it
   covered the player's car at its start in portrait. The ability badge goes over the item, so neither covers the
   other. */
.hud__boost-slot--items .hud__item {
    left: 80px;
    top: -275px;
}

.hud__boost-slot--items.hud__boost-slot--left .hud__item {
    left: -20px;
}

.hud__boost-slot--items .hud__power {
    top: -400px;
}

/* TAP! and its arrow beside BOOST, on the screen's middle side, pointing at it: over BOOST lies the item button. */
.hud__boost-slot--items .hud__boost-hint {
    left: -330px;
    top: 90px;
    height: 120px;
    padding-right: 80px;
    justify-content: center;
}

.hud__boost-slot--items .hud__boost-hint .hud__boost-hint-arrow {
    left: 214px;
    top: 24px;
    rotate: -45deg;
}

.hud__boost-slot--items.hud__boost-slot--left .hud__boost-hint {
    left: 330px;
    padding-right: 0;
    padding-left: 80px;
}

.hud__boost-slot--items.hud__boost-slot--left .hud__boost-hint .hud__boost-hint-arrow {
    left: 14px;
    rotate: 135deg;
}

/* The first item of a visit: RIGHT CLICK and the E key cap under the desktop's item button, with an arrow up to it, for a moment (on a
   touch screen TAP TO USE stands beside the button, below). Below the button the screen is free on a desktop: above it
   lie the arena, the player's car and the item's timer badge. It keeps clear of BOOST on either side. */
.hud__item-hint {
    position: absolute;
    left: -410px;
    top: 50px;
    width: 400px;
    height: 170px;
    padding-top: 46px;
    align-items: center;
    opacity: 0;
    scale: 0 0;
    transition-property: scale, opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-in;
}

.hud__item-hint--shown {
    opacity: 1;
    scale: 1 1;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.hud__boost-slot--left .hud__item-hint {
    left: 310px;
}

.hud__item-hint--desktop {
    left: -360px;
    top: 280px;
}

.hud__boost-slot--left .hud__item-hint--desktop {
    left: 300px;
}

.hud__item-hint-label {
    padding: 4px 28px;
    background-color: var(--purple);
}

.hud__item-hint-text {
    font-size: 54px;
}

/* The arrow points up at the button, from the pill's end nearest to it; scoped under the hint so it outranks
   hud__boost-hint-arrow, which comes later in the file. */
.hud__item-hint .hud__item-hint-arrow {
    left: 300px;
    top: 6px;
    rotate: 225deg;
}

.hud__boost-slot--left .hud__item-hint .hud__item-hint-arrow {
    left: 30px;
}

.hud__item-hint--desktop .hud__item-hint-arrow {
    left: 260px;
}

.hud__boost-slot--left .hud__item-hint--desktop .hud__item-hint-arrow {
    left: 70px;
}

.hud__item-hint-arrow .hud__boost-hint-arrow-fill {
    border-color: var(--purple);
}

/* On a touch screen TAP TO USE stands over the item button, its arrow pointing down at it: beside the button it
   covered the player's car at its start in portrait. The ability badge, which also goes there, shows only once an item
   is used, and that hides the hint. */
.hud__boost-slot--items .hud__item-hint {
    left: -80px;
    top: -435px;
    padding-top: 0;
}

.hud__boost-slot--items .hud__item-hint .hud__item-hint-arrow {
    left: 244px;
    top: 86px;
    rotate: 45deg;
}

.hud__boost-slot--items.hud__boost-slot--left .hud__item-hint {
    left: -20px;
}

.hud__boost-slot--items.hud__boost-slot--left .hud__item-hint .hud__item-hint-arrow {
    left: 84px;
}

/* POW!: the comic word where the player's glove lands, in red on the sticker; STRIKE! where the bowling ball hits, in
   teal; SAVED! over the player's car its balloon catches, in pink. */
.ko-pop--pow .ko-pop__text,
.ko-pop--strike .ko-pop__text,
.ko-pop--saved .ko-pop__text {
    margin-left: 0;
    font-size: 120px;
    color: var(--red);
}

.ko-pop--strike .ko-pop__text { color: rgb(62, 196, 160); }
.ko-pop--saved .ko-pop__text { color: rgb(255, 92, 160); }

/* A mission done during the round: MISSION! over the player's car, green as the XP it pays. */
.ko-pop--mission .ko-pop__text {
    margin-left: 0;
    font-size: 96px;
    color: rgb(91, 214, 77);
}

/* A daily task done during the round: DAILY TASK! in the daily gift's orange. */
.ko-pop--daily .ko-pop__text {
    margin-left: 0;
    font-size: 88px;
    color: var(--orange);
}

/* The start prompt of a visit's first round, while the cars wait for the player's first steer or boost (HudView shows
   it): TAP TO START or CLICK TO START, outlined, and under it a dark plate: an orange dot and TAP TO BOOST on a touch
   screen (the full joystick demonstration sits separately in the thumb area), a mouse, HOLD TO DRIVE,
   the SPACE key and BOOST on a desktop (hud__start--desktop). Nothing dims the arena: the player's car and the HUD
   stay as in play. On a narrow screen it sits in the sky under the HUD, over the arena's far edge; on a wide one
   (hud__start--wide) inside the ring of cars, between the far bots and the player's car. It springs in once the curtain
   is up (hud__start--enter, taken off once it is laid out), bobs (hud__start--bob, toggled by HudView, with the mouse
   swinging with it), and flashes away as the round begins (hud__start--leave). */
.hud__start {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 250px;
    align-items: center;
    transition-property: scale, opacity;
    transition-duration: 0.35s, 0.2s;
    transition-timing-function: ease-out-back, linear;
    transition-delay: 0.3s;
}

.hud__start--shown {
    display: flex;
}

.hud__start--wide {
    top: 780px;
}

.hud__start--enter {
    scale: 0.5 0.5;
    opacity: 0;
}

.hud__start--leave {
    scale: 1.2 1.2;
    opacity: 0;
    transition-duration: 0.15s;
    transition-timing-function: ease-in;
    transition-delay: 0s;
}

/* The prompt and the goal span the screen less a margin, so a long translation shrinks to fit instead of running off
   a portrait screen. */
.hud__start-prompt {
    align-self: stretch;
    margin: 0 40px;
    align-items: center;
    transition-property: scale;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.hud__start--bob .hud__start-prompt {
    scale: 1.06 1.06;
}

.hud__start-goal {
    align-self: stretch;
    margin-left: 60px;
    margin-right: 60px;
    align-items: center;
    margin-bottom: 18px;
    rotate: -3deg;
}

.hud__start-goal-text {
    margin: 0;
    padding: 0;
    align-self: stretch;
    -unity-text-auto-size: best-fit 40px 76px;
    font-size: 76px;
    color: var(--gold);
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__start-goal-text.stroke__drop { translate: 0 10px; display: flex; }

.hud__start-text {
    align-self: stretch;
    margin: 0;
    padding: 0;
    -unity-text-auto-size: best-fit 56px 108px;
    font-size: 108px;
    color: var(--white);
    -unity-text-outline-width: 16px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__start-text.stroke__drop { translate: 0 14px; display: flex; }

.hud__start-hint {
    display: none;
    flex-direction: row;
    align-items: center;
    margin-top: 24px;
    padding: 16px 40px 20px 26px;
    border-radius: 999px;
    background-color: rgba(29, 43, 79, 0.75);
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-delay: 0.42s;
}

.hud__start--touch .hud__start-hint--touch {
    display: flex;
}

.hud__start--desktop .hud__start-hint--desktop {
    display: flex;
}

.hud__start--enter .hud__start-hint {
    translate: 0 40px;
    opacity: 0;
}

.hud__start--leave .hud__start-hint {
    transition-delay: 0s;
}

.hud__start-hint-text {
    margin: 0 0 0 20px;
    padding: 0 0 4px 0;
    font-size: 40px;
    letter-spacing: 2px;
    color: var(--white);
    white-space: nowrap;
}

.hud__start-boost-text {
    margin-left: 16px;
}

.hud__start-key {
    margin-left: 44px;
}

/* The boost button in small: an orange disc with a white rim, as the ready button at the bottom right. */
.hud__start-boost-dot {
    width: 56px;
    height: 56px;
    margin-left: 0;
    border-width: 6px;
    border-color: var(--white);
    border-radius: 28px;
    background-color: var(--orange);
}

/* First-round touch teaching. HudView places the ghost in the lower third, animates its opacity/scale and draws the
   disc and knob with the real joystick's classes. Only the pointing hand and captions are extra, all non-picking.
   The joystick wrapper is translucent; the finger and caption stay opaque once the whole demonstration is shown. */
.hud__ghost {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    scale: 0 0;
}

.hud__ghost-stick {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* Kenney's pointing hand (Input Prompts, CC0) as mobile games teach a drag: the fingertip (23% across, 7% down the
   picture) stays on the knob and the hand turns about it. */
.hud__ghost-finger {
    position: absolute;
    background-image: url("/Assets/Art/Sprites/UI/sprite_ui_hand_point.svg");
    -unity-background-scale-mode: scale-to-fit;
    transform-origin: 23% 7%;
}

.hud__ghost-caption {
    position: absolute;
    left: -320px;
    top: -266px;
    width: 640px;
    align-items: center;
}

.hud__teaching-text {
    margin: 0;
    padding: 0 0 8px 0;
    font-size: 66px;
    color: var(--white);
    -unity-text-outline-width: 12px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__teaching-text.stroke__drop { translate: 0 8px; display: flex; }

.hud__tap-hint {
    position: absolute;
    width: 560px;
    align-items: center;
    opacity: 0;
    scale: 0 0;
}

/* Lives inside the moving boost slot, so TAP! and its arrow always follow T5's chosen side. The arrow is two outlined
   chevrons, with no image or font glyph. Scale is on the teaching sticker, independent of the button's ready pop. */
.hud__boost-hint {
    position: absolute;
    left: 0;
    top: -240px;
    width: 300px;
    height: 220px;
    align-items: center;
    opacity: 0;
    scale: 0 0;
}

.hud__boost-hint-label {
    padding: 4px 28px;
    background-color: var(--orange);
}

/* Without a touch screen the sticker reads SPACE OR CLICK! over the smaller gauge in the slot's bottom-right corner:
   flush with the slot's outer edge so the longer words stay on screen, its arrow on the gauge's middle. */
.hud__boost-hint-desktop {
    display: none;
}

.hud__boost-hint--desktop .hud__boost-hint-desktop {
    display: flex;
}

.hud__boost-hint--desktop .hud__boost-hint-touch {
    display: none;
}

.hud__boost-hint--desktop {
    left: -260px;
    top: -170px;
    width: 560px;
    align-items: flex-end;
}

.hud__boost-slot--left .hud__boost-hint--desktop {
    left: 0;
    align-items: flex-start;
}

.hud__boost-hint--desktop .hud__teaching-text {
    font-size: 52px;
    white-space: nowrap;
}

.hud__boost-hint--desktop .hud__boost-hint-arrow {
    left: 409px;
}

.hud__boost-slot--left .hud__boost-hint--desktop .hud__boost-hint-arrow {
    left: 149px;
}

.hud__boost-hint-arrow {
    position: absolute;
    left: 114px;
    top: 120px;
    width: 72px;
    height: 72px;
    border-right-width: 16px;
    border-bottom-width: 16px;
    border-color: var(--navy);
    rotate: 45deg;
}

.hud__boost-hint-arrow-fill {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 56px;
    height: 56px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-color: var(--orange);
}

/* The mouse: a white outline with its left button orange, swaying as the prompt bobs. */
.hud__start-mouse {
    width: 46px;
    height: 64px;
    border-width: 6px;
    border-color: var(--white);
    border-radius: 23px;
    translate: -8px 0;
    transition-property: translate;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.hud__start--bob .hud__start-mouse {
    translate: 8px 0;
}

.hud__start-mouse-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 14px;
    height: 22px;
    border-top-left-radius: 16px;
    background-color: var(--orange);
}

.hud__start-mouse-line {
    position: absolute;
    left: 14px;
    top: 0;
    width: 6px;
    height: 22px;
    background-color: var(--white);
}

/* The round's result: the title near the top, tilted over the dimmed arena, a line under it, the card with the place
   and the time on the arena, and PLAY AGAIN at the bottom with the free height between them. Only the top spacer gives
   way when a screen is too short. While round-over--enter is on (RoundOverView takes it off once the screen shows),
   the title is small, the card low and the button lower, so they spring into place. */
.round-over {
    justify-content: flex-start;
}

.round-over__spacer-top {
    flex-shrink: 1;
    height: 160px;
    min-height: 60px;
}

/* The text fits its width (best-fit), but its thick outline and the tilt reach past it: the margins keep KNOCKED OUT
   (and a longer title in French or Russian) clear of the screen's sides. */
.round-over__title {
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 100px;
    margin-right: 100px;
    rotate: -3deg;
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.round-over__title-text {
    align-self: stretch;
    margin: 0;
    padding: 0;
    -unity-text-auto-size: best-fit 80px 171px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    font-size: 171px;
}

.round-over__title-text.stroke__drop { translate: 0 18px; display: flex; }

.round-over__title--won {
    color: var(--gold);
}

/* KNOCKED OUT is the long one: at the full size its outline would touch the sides of a portrait screen. */
.round-over__title--out {
    font-size: 148px;
    color: var(--red);
}

/* Confetti of a win, over the whole screen (ConfettiBurst moves each piece; its top left is offset so that it turns
   about its centre). */
.confetti-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.confetti {
    position: absolute;
    left: -12px;
    top: -23px;
    width: 24px;
    height: 46px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 6px;
}

.round-over__subtitle {
    flex-shrink: 0;
    align-self: stretch;
    margin: 34px 40px 0 40px;
    padding: 0;
    -unity-text-auto-size: best-fit 28px 52px;
    font-size: 52px;
    letter-spacing: 2px;
    color: var(--white);
    text-shadow: 0 6px 0 rgb(29, 43, 79);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* After a fall with a car to blame: PUSHED OFF BY, that car in its colour on a white badge, and its visit handle. */
.round-over__by {
    display: none;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 26px;
}

.round-over__by--shown {
    display: flex;
}

.round-over__by-text {
    margin: 0;
    font-size: 44px;
    letter-spacing: 1px;
}

.round-over__by-name {
    margin-left: 18px;
}

.round-over__by-name-text {
    margin: 0;
    padding: 0;
    font-size: 48px;
    -unity-text-outline-width: 7px;
}

.round-over__by-badge {
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    margin-left: 22px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 52px;
    background-color: var(--white);
    rotate: 10deg;
}

/* REVENGE! under the title, after a round the player knocked out the bot marked for it. Shares the stickers' entrance. */
.round-over__revenge {
    flex-shrink: 0;
    margin-top: 30px;
    background-color: var(--red);
    color: var(--white);
    rotate: 5deg;
}

.round-over__spacer {
    flex-grow: 1;
    flex-shrink: 0;
    min-height: 40px;
}

/* The level card: the player's level badge, the XP the round gave and how far the level is, over the level track
   (RoundOverProgress builds its stops). The meta goal is the one thing on the result besides the buttons. */
.level-card {
    flex-shrink: 0;
    margin: 24px 0 44px 0;
    padding: 28px 40px 10px 40px;
    align-items: stretch;
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-delay: 0.05s;
}

.level-card__head {
    flex-direction: row;
    align-items: center;
}

.level-card__gain {
    margin-left: 28px;
}

.level-card__rank {
    font-size: 34px;
    -unity-text-align: middle-left;
}

.level-card__xp {
    margin: 0;
    padding: 0;
    font-size: 64px;
    color: var(--xp-shade);
    -unity-text-align: middle-left;
}

.level-card__rank--under {
    position: absolute;
    top: 100%;
    left: -80px;
    right: -80px;
    margin: 18px 0 0 0;
    padding: 0;
    font-size: 30px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* League stickers keep their layout box and hard bottom shadow: plain white rookie, bevelled bronze shield,
   winged silver, crowned gold laurels and a star crest with gemmed wings on rainbow legend (LevelBadge).
   The large silhouettes are painted outside the box; the number stays centred on the original face. */
.level-badge {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-width: 60px;
    height: 50px;
    padding: 0 10px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    border-radius: 16px;
    background-color: var(--white);
    color: var(--navy);
}

.level-badge--big {
    min-width: 132px;
    height: 116px;
    padding: 0 18px;
    border-width: 8px;
    border-bottom-width: 16px;
    border-radius: 30px;
}

.level-badge__value {
    margin: 0;
    padding: 0;
    font-size: 30px;
    -unity-text-align: middle-center;
}

/* LV N beside a nick: LV a tiny navy tag on the badge's top edge (as AD on CLAIM), so the badge keeps the width of its
   number. Silver, gold and legend wear a crest or a crown on top, so their tag hangs from the bottom edge instead. */
.level-badge__prefix {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% -62%;
    margin: 0;
    padding: 0 6px 1px 6px;
    border-radius: 999px;
    background-color: var(--navy);
    color: var(--white);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.level-badge--labelled.level-badge--silver > .level-badge__prefix,
.level-badge--labelled.level-badge--gold > .level-badge__prefix,
.level-badge--labelled.level-badge--legend > .level-badge__prefix {
    top: 100%;
    translate: -50% -30%;
}

/* A list row's level column: one width for any badge, its wings and the rival's horns, the badge in the middle. */
.level-slot {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.level-badge--big .level-badge__value {
    font-size: 70px;
}

/* The level track, as in the design: round stops joined by bars that tuck under the next stop, the captions hanging
   under the stops. A reached stop turns into a gold disc with a navy tick. The first stop is the card's own level
   badge (RoundOverProgress moves it here), so the level shows once; the rank and XP line sits over the track beside
   it. */
.track {
    /* Room for the crown a rank stop wears over its circle, clear of the XP line. */
    margin-top: 36px;
    padding: 0 30px 96px 30px;
}

/* Only plain levels ahead (past the last reward and rank): no captions but the badge's rank. */
.track--plain {
    padding-bottom: 56px;
}

/* The bars' row and, laid exactly over it, the stops' row (RoundOverProgress.BuildTrack). Every bar and every gap
   grows from nothing by the same share, and every bar reaches 14 px under each stop, so the two rows line up. */
.track__row {
    flex-direction: row;
    align-items: center;
    height: 127px;
}

.track__row--nodes {
    position: absolute;
    left: 30px;
    right: 30px;
    top: 0;
}

.track__slot {
    flex-shrink: 0;
    width: 105px;
}

.track__slot--rank {
    width: 127px;
}

.track__gap {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 39px;
}

.track__node {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 105px;
    height: 105px;
    border-width: 8px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    color: var(--navy);
}

.track__node--rank {
    width: 127px;
    height: 127px;
}

.track__node--reached {
    background-color: var(--gold);
}

/* After the stop's own colours, so the next-rank stop wears its rank. */
.level-badge--rookie { background-color: var(--white); }
.level-badge--bronze { background-color: #e8a46a; }
.level-badge--silver { background-color: #d7e0ee; }
.level-badge--gold { background-color: var(--gold); }
.level-badge--legend { background-color: var(--navy); }

/* Legend's rainbow, a texture LevelBadge makes at run time (USS draws no gradient), over the fill and under the
   number. The navy behind it only shows where UI Toolkit's own fill corners are squarer than the rainbow's. */
.level-badge__rainbow {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.level-badge--legend > .level-badge__rainbow { display: flex; }

/* Covers the inside; LevelBadge paints the league frame beyond its edges without reserving layout space. */
.level-badge__ornament {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The REVENGE rival's badge: a red frame and two red horns sprouting from its top corners (HudView draws them). */
.level-badge.level-badge--rival {
    border-left-color: rgb(255, 77, 77);
    border-right-color: rgb(255, 77, 77);
    border-top-color: rgb(255, 77, 77);
    border-bottom-color: rgb(255, 77, 77);
}

.level-badge__horn {
    position: absolute;
    top: -62%;
    width: 50%;
    height: 76%;
}

.level-badge__horn--left { left: -20%; }
.level-badge__horn--right { right: -20%; }

/* Lift the horn roots clear of silver wings; crowned leagues need more room beside their crest and laurels. */
.level-badge--silver > .level-badge__horn { top: -70%; }
.level-badge--silver > .level-badge__horn--left { left: -26%; }
.level-badge--silver > .level-badge__horn--right { right: -26%; }
.level-badge__horn--crowned { top: -70%; }
.level-badge__horn--left.level-badge__horn--crowned { left: -40%; }
.level-badge__horn--right.level-badge__horn--crowned { right: -40%; }

.track__level {
    margin: 0;
    padding: 0 0 4px 0;
    font-size: 44px;
    -unity-text-align: middle-center;
}

.track__node--rank .track__level { font-size: 50px; }

/* A car still to come: its portrait in the player's colour. */
.track__car {
    width: 92px;
    height: 92px;
}

.track__map {
    width: 55px;
    height: 55px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 999px;
}

/* As wide as the step between stops, so a long name in another language shrinks rather than runs into its
   neighbour's. */
.track__caption {
    position: absolute;
    top: 100%;
    left: -33px;
    width: 172px;
    margin-top: 11px;
    align-items: center;
}

.track__node--rank .track__caption {
    left: -49px;
}

.track__caption-level {
    margin: 0;
    padding: 0;
    font-size: 28px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.track__caption-name {
    align-self: stretch;
    margin: 0;
    padding: 0;
    overflow: hidden;
    -unity-text-auto-size: best-fit 16px 30px;
    font-size: 30px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Covers the stop's whole outline: the node's border sits outside this child's box. */
.track__reach {
    display: none;
    position: absolute;
    left: -8px;
    top: -8px;
    right: -8px;
    bottom: -14px;
    align-items: center;
    justify-content: center;
    border-width: 8px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--gold);
}

.track__node--done .track__reach {
    display: flex;
}

.track__tick-mark {
    width: 36px;
    height: 19px;
    margin-top: -10px;
    border-left-width: 11px;
    border-bottom-width: 11px;
    border-color: var(--navy);
    rotate: -45deg;
}

/* No end caps: the bar runs under both its stops, which are drawn over it. */
.track__segment {
    flex-grow: 1;
    flex-basis: 0;
    height: 33px;
    min-width: 67px;
    margin: 0 -14px;
    border-top-width: 7px;
    border-bottom-width: 7px;
    border-color: var(--navy);
    background-color: var(--soft);
    overflow: hidden;
    transform-origin: 0 50%;
}

/* Toward the next rank: a row of pale dots. The bar keeps the same margins and no padding, as every bar must take the
   same share of the width as the gap over it; the dots' own margins keep them clear of the stops. */
.track__segment--dotted {
    height: 11px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.track__dots {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 0 22px;
}

.track__dot {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background-color: var(--silver);
}

/* As far in from each end as the bar runs under its stops. */
.track__fill-area {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 0;
    bottom: 0;
}

.track__fill {
    width: 0;
    height: 100%;
    background-color: var(--xp);
}

/* The first step of the XP: a plain bar to the next level, laid over the still empty track and growing out of the
   card's badge (its left edge follows the badge, RoundOverProgress.FitToBadge), that level on a badge at its end and
   LEVEL UP! under it when it fills. */
.xp-bar {
    position: absolute;
    left: 30px;
    right: 30px;
    top: 4px;
    height: 120px;
    flex-direction: row;
    align-items: center;
}

.xp-bar__level {
    min-width: 116px;
    height: 104px;
}

.xp-bar__line {
    flex-grow: 1;
    height: 56px;
    margin: 0 -10px 0 0;
    border-top-left-radius: 28px;
    border-bottom-left-radius: 28px;
    border-width: 7px;
    border-bottom-width: 12px;
    border-color: var(--navy);
    background-color: var(--soft);
    overflow: hidden;
}

.xp-bar__fill {
    width: 0;
    height: 100%;
    background-color: var(--xp);
}

.xp-bar__level-up {
    position: absolute;
    left: 0;
    right: 0;
    top: 112px;
    rotate: -4deg;
}

.xp-bar__level-up-text {
    margin: 0;
    padding: 0;
    font-size: 72px;
    color: var(--gold);
    -unity-text-outline-width: 12px;
}

.xp-bar__level-up-text.stroke__drop { translate: 0 10px; display: flex; }

/* The second step: a level's reward over the whole result, dimmed, gold rays turning behind a white card. */
.level-reward {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(29, 43, 79, 0.62);
}

/* The menu's light behind the card (MenuView.DrawLight), turning. */
.level-reward__rays {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2200px;
    height: 2200px;
    margin-left: -1100px;
    margin-top: -1100px;
}

/* The card and the hint under it, scaled together to the screen (RoundOverProgress.FitReward): the card's own scale
   pops and shrinks it. */
.level-reward__holder {
    align-items: center;
}

/* As wide as the garage's BUY window, whose picture and stats it shows. */
.level-reward__card {
    width: 1040px;
    padding: 110px 64px 52px 64px;
    align-items: center;
    border-width: 9px;
    border-bottom-width: 26px;
    border-radius: 82px;
}

.level-reward__title {
    position: absolute;
    left: 0;
    right: 0;
    top: -90px;
    rotate: -5deg;
}

.level-reward__title-text {
    margin: 0;
    padding: 0;
    font-size: 130px;
    color: var(--gold);
    -unity-text-auto-size: best-fit 60px 130px;
}

.level-reward__title-text.stroke__drop { translate: 0 18px; display: flex; }

.level-reward__tag {
    margin: 0;
    padding: 4px 34px 8px 34px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--orange);
    font-size: 44px;
    color: var(--white);
}

/* The reward in a framed piece of the league's sky (GarageView.SkyFrame, garage__sheet-frame in ui_garage). */
.level-reward__card .level-reward__frame {
    margin-top: 30px;
}

/* A hat's flat icon where the arena's stage is not there to draw the car wearing it (tests). */
.level-reward__hat-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 300px;
    height: 300px;
    margin-left: -150px;
    margin-top: -150px;
}

/* The rank's badge as the old rank popup showed it: only the badge screenshots still draw it. */
.level-reward__rank {
    min-width: 220px;
    height: 200px;
}

.level-reward__rank .level-badge__value {
    font-size: 120px;
}

/* EQUIP, the gift button: the BUY pill without a price. */
.level-reward__wear {
    padding: 0 56px;
}

.level-reward__name {
    margin: 8px 0 0 0;
    padding: 0;
    font-size: 96px;
    color: var(--navy);
    -unity-text-auto-size: best-fit 48px 96px;
    white-space: nowrap;
}

.level-reward__caption {
    margin: 4px 0 0 0;
    font-size: 36px;
}

/* A car with a price: one green BUY button with its price on a white pill, under the caption. No wider than the card:
   a longer language's label shrinks instead (FitText). */
.level-reward__buy {
    max-width: 100%;
    flex-direction: row;
    align-items: center;
    height: 136px;
    margin: 28px 0 0 0;
    padding: 0 20px 0 48px;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--green);
}

.level-reward__buy:active {
    translate: 0 8px;
}

.level-reward__buy-label {
    flex-shrink: 1;
    min-width: 0;
}

.level-reward__buy-label-text {
    margin: 0;
    padding: 0;
    font-size: 72px;
    color: var(--white);
    -unity-text-outline-width: 12px;
    -unity-text-outline-color: var(--navy);
}

.level-reward__buy-label-text.stroke__drop { translate: 0 8px; display: flex; }

.level-reward__price {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 84px;
    margin-left: 28px;
    padding: 0 26px 0 14px;
    border-width: 6px;
    border-bottom-width: 10px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

.level-reward__price-value {
    margin: 0 0 0 10px;
    padding: 0;
    font-size: 52px;
    color: var(--navy);
}

/* CONTINUE under a reward's button: closes the popup with nothing taken, white and quieter than the green one. */
.level-reward__skip {
    height: 100px;
    margin: 22px 0 0 0;
    padding: 0 56px;
    justify-content: center;
    border-width: 7px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

.level-reward__skip:active {
    translate: 0 6px;
}

.level-reward__skip-label {
    margin: 0;
    padding: 0;
    font-size: 52px;
    color: var(--navy);
}

.level-reward__hint {
    margin: 60px 0 0 0;
    -unity-text-align: middle-center;
    font-size: 42px;
    color: var(--white);
    opacity: 0.85;
}

/* NEXT MATCH and, where there is a keyboard, the key that presses it. The entrance moves this wrapper, not the
   button, whose own translate is its press. */
.round-over__actions {
    flex-shrink: 0;
    align-items: center;
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-delay: 0.12s;
}

.round-over__button {
    width: 981px;
}

.round-over__hint {
    flex-direction: row;
    align-items: center;
    margin-top: 36px;
}

.round-over__hint-text {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 3px;
    color: var(--white);
    text-shadow: 0 5px 0 rgb(29, 43, 79);
}

.round-over__spacer-bottom {
    flex-shrink: 0;
    height: 70px;
}

.round-over--enter .round-over__title {
    scale: 0.4 0.4;
    opacity: 0;
}

.round-over--enter .best--new {
    scale: 0 0;
}

.round-over--enter .level-card {
    translate: 0 120px;
    opacity: 0;
}

.round-over--enter .round-over__actions {
    translate: 0 240px;
    opacity: 0;
}

/* The car colours (CarColor in Scripts/UI picks the class), late in the file so they win over the white of a pip__body
   they are put on. */
.car-color--0 {
    background-color: var(--car-green);
}

.car-color--1 {
    background-color: var(--car-red);
}

.car-color--2 {
    background-color: var(--car-blue);
}

.car-color--3 {
    background-color: var(--car-yellow);
}

.car-color--4 {
    background-color: var(--car-purple);
}

.car-color--5 {
    background-color: var(--car-orange);
}

.car-color--6 {
    background-color: var(--car-pink);
}

.car-color--7 {
    background-color: var(--car-dark);
}

/* The kick-off before every round: 3, 2, 1 as big white stickers that pop in tilted and shrink away, then GO! larger
   in green over a gold ring and a burst of rays. HudView shows it (kickoff--shown) and animates scale, tilt and opacity
   in code on unscaled time, so each step keeps to the round state's timing; nothing here transitions. The centre is a
   point a little above the middle of the screen, over the arena, the same in portrait and landscape; the stickers, the
   ring and the rays hang around it. */
.kickoff {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding-bottom: 200px;
}

.kickoff--shown {
    display: flex;
}

.kickoff__center {
    width: 0;
    height: 0;
    overflow: visible;
}

.kickoff__sticker {
    position: absolute;
    left: -500px;
    top: -280px;
    width: 1000px;
    height: 560px;
    justify-content: center;
}

.kickoff__digit {
    flex-grow: 1;
    margin: 0;
    padding: 0 0 30px 0;
    font-size: 420px;
    color: var(--white);
    -unity-text-outline-width: 48px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.kickoff__digit.stroke__drop { translate: 0 36px; display: flex; }

.kickoff__go-text {
    flex-grow: 1;
    margin: 0 40px;
    padding: 0 0 30px 0;
    -unity-text-auto-size: best-fit 150px 400px;
    font-size: 400px;
    color: var(--green);
    -unity-text-outline-width: 46px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.kickoff__go-text.stroke__drop { translate: 0 34px; display: flex; }

/* A special round's name, tilted gold over the countdown numbers, and its one-line rule on a dark pill below it
   (HudView shows them for 3, 2 and 1 and hides them at GO!). */
.kickoff__special {
    display: none;
    position: absolute;
    left: -480px;
    top: -560px;
    width: 960px;
    align-items: center;
}

.kickoff__special--shown {
    display: flex;
}

.kickoff__special-name {
    align-self: stretch;
    align-items: center;
    rotate: -4deg;
}

.kickoff__special-text {
    margin: 0;
    padding: 0;
    align-self: stretch;
    -unity-text-auto-size: best-fit 60px 120px;
    font-size: 120px;
    color: var(--gold);
    -unity-text-outline-width: 20px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.kickoff__special-text.stroke__drop { translate: 0 14px; display: flex; }

.kickoff__special-hint {
    margin: 16px 0 0 0;
    padding: 10px 36px 14px 36px;
    max-width: 960px;
    border-radius: 40px;
    background-color: rgba(29, 43, 79, 0.8);
    font-size: 46px;
    color: var(--white);
    -unity-text-align: middle-center;
    white-space: normal;
}

.kickoff__ring {
    position: absolute;
    left: -160px;
    top: -160px;
    width: 320px;
    height: 320px;
    border-radius: 160px;
    border-width: 26px;
    border-color: var(--gold);
}

.kickoff__burst {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    overflow: visible;
}

/* A ray of GO!'s burst, a rounded bar pointing out from the centre (HudView builds them once and turns each its way). */
.kickoff__ray {
    position: absolute;
    left: -24px;
    top: -80px;
    width: 48px;
    height: 160px;
    border-radius: 24px;
    border-width: 8px;
    border-color: var(--navy);
    background-color: var(--gold);
}

.kickoff__ray--short {
    top: -55px;
    height: 110px;
    background-color: var(--white);
}

/* A small mouse on a white sticker with a navy outline: the left button orange for a click to boost (the desktop
   boost gauge's outer corner), the right one (mouse-glyph--right) for the item (beside the item badge's E key cap). It
   sits on a corner of its button, as the key caps do, and shows only on a desktop. */
.mouse-glyph {
    display: none;
    position: absolute;
    width: 44px;
    height: 60px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    border-radius: 22px;
    background-color: var(--white);
    overflow: hidden;
}

.mouse-glyph__button {
    position: absolute;
    left: 0;
    top: 0;
    width: 17px;
    height: 24px;
    background-color: var(--orange);
}

.mouse-glyph__line {
    position: absolute;
    left: 15px;
    top: 0;
    width: 4px;
    height: 24px;
    background-color: var(--navy);
}

.mouse-glyph--right .mouse-glyph__button {
    left: auto;
    right: 0;
}

.mouse-glyph--right .mouse-glyph__line {
    left: auto;
    right: 15px;
}

.hud__item--desktop .hud__item-mouse {
    display: flex;
    right: 30px;
    bottom: -36px;
}

.hud__boost--desktop .hud__boost-mouse {
    display: flex;
    right: -10px;
    bottom: -18px;
}

/* On a desktop the first-item hint reads RIGHT CLICK with the E key cap beside it, as the badge shows both. */
.hud__item-hint-key {
    display: none;
    margin-left: 14px;
    padding: 0 14px 2px 14px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
}

.hud__item-hint-key-text {
    font-size: 32px;
}

.hud__item-hint--desktop .hud__item-hint-label {
    flex-direction: row;
    align-items: center;
}

.hud__item-hint--desktop .hud__item-hint-text {
    font-size: 46px;
}

.hud__item-hint--desktop .hud__item-hint-key {
    display: flex;
}

/* The desktop start hint: HOLD TO DRIVE, a dot, CLICK TO BOOST and the SPACE key cap, which only a wide screen has
   room for: the mouse first, since half of the desktop players never touch the keys. */
.hud__start-sep {
    width: 12px;
    height: 12px;
    margin-left: 24px;
    border-radius: 6px;
    background-color: var(--white);
    opacity: 0.6;
}

.hud__start-click-text {
    margin-left: 24px;
}

.hud__start-hint--desktop .hud__start-key {
    display: none;
    margin-left: 24px;
}

.hud__start--wide .hud__start-hint--desktop .hud__start-key {
    display: flex;
}

/* Last, so the layers of a stroke (StrokeText) win over every rule above that styles their text: all three carry the
   same classes. The face goes over the outline without one: the outline is centred on the letters' edge, so the face
   keeps the letters their full width. */
.stroke > .stroke__face {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-outline-width: 0;
}

/* The drop under the outline: the letters again, all navy with their text's own outline, moved down by its text's
   rule (.x-text.stroke__drop { translate: 0 10px; display: flex; }, in pixels: as thick in every language). With
   the outline it is as wide as the outlined letters, so the whole offset shows as one solid step under them: the side
   wall of 3D letters rather than a second text beneath. A layer and not a text-shadow, because UI Toolkit draws no
   text-shadow under the fallback font's letters (Cyrillic, the Turkish ones). Hidden without a rule, so a faded stroke
   (opacity on it or a parent) shows no navy through its face; the bare class keeps this below every text's rule. Hidden
   by display and not by visibility: a rule setting visibility: visible would keep the drop on screen under a parent
   hidden with visibility (a taken EQUIP left its drop behind), while display leaves visibility inherited. Label in the
   selector, so a rule colouring the text (gold, red) or its outline does not colour its drop. */
.stroke__drop {
    display: none;
}

.stroke > Label.stroke__drop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--navy);
    -unity-text-outline-color: var(--navy);
}

/* Two aligned layers: a neutral car and its separately tinted white body. */
.car-portrait {
    width: 100%;
    height: 100%;
}

.car-portrait__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--white);
}

.round-over__buttons {
    width: 981px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* HOME, CAR and NEXT MATCH: the two round buttons keep their size and NEXT MATCH takes the rest, its label fitted. */
.round-over__buttons .round-over__button {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 0;
    margin-left: 24px;
    padding-left: 20px;
    padding-right: 20px;
}

.round-over__buttons .round-over__button .button__label {
    -unity-text-auto-size: best-fit 60px 104px;
}

.round-over__home {
    margin-right: 24px;
}

.round-over__home-icon {
    width: 104px;
    height: 104px;
    margin: 4px 0 4px 0;
}

.round-over__garage {
    flex-direction: column;
    flex-shrink: 0;
    width: 208px;
    height: 208px;
    margin: 0;
    padding: 6px;
}

.round-over__garage:hover,
.round-over__garage:focus {
    background-color: var(--soft);
}

.round-over__garage:active {
    translate: 0 8px;
}

.round-over__garage-portrait {
    width: 132px;
    height: 112px;
}

.round-over__garage-label {
    align-self: stretch;
    margin: 0 18px;
    padding: 0;
    overflow: hidden;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-auto-size: best-fit 18px 34px;
    font-size: 34px;
    color: var(--navy);
}

.round-over__garage-dot {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 38px;
    height: 38px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--red);
}

.round-over--landscape .round-over__buttons {
    width: 1240px;
}

.round-over--landscape .round-over__button {
    width: 981px;
}

/* UIKit disables the screen under a popup; keep the existing result looking the same. */
.round-over:disabled,
.round-over:disabled .button,
.round-over:disabled .round-over__garage {
    opacity: 1;
}

/* The settings gear, a round white sticker at the top right of the result and beside the garage's close button: the
   top left corner is where Poki's inspector and the browser chrome sit. */
.gear-button {
    position: absolute;
    top: 40px;
    width: 120px;
    height: 120px;
    margin: 0;
    padding: 0;
    border-width: 8px;
    border-bottom-width: 16px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    background-image: none;
    align-items: center;
    justify-content: center;
}

.gear-button:hover,
.gear-button:focus { background-color: var(--soft); }
.gear-button:active { translate: 0 8px; }
.round-over__settings { right: 40px; }
/* The result's gear is the menu's sticker (ui_menu menu__gear), placed in the corner. */
.round-over__settings.menu__gear {
    position: absolute;
    top: 40px;
    margin: 0;
}
/* On the HUD the round goes on under the settings. A narrow screen's HUD bar can reach the corner, so there the gear
   sits under the bar (54 + 136 + a gap). */
.hud__settings { right: 40px; }
.hud__settings--under { top: 216px; }

.gear {
    width: 68px;
    height: 68px;
}

.gear__tooth {
    position: absolute;
    left: 24px;
    top: 0;
    width: 20px;
    height: 68px;
    border-radius: 5px;
    background-color: var(--navy);
}

.gear__tooth--45 { rotate: 45deg; }
.gear__tooth--90 { rotate: 90deg; }
.gear__tooth--135 { rotate: 135deg; }

.gear__hub {
    position: absolute;
    left: 9px;
    top: 9px;
    width: 50px;
    height: 50px;
    border-radius: 999px;
    background-color: var(--navy);
    align-items: center;
    justify-content: center;
}

.gear__hole {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background-color: var(--white);
}

/* Settings: a card with two round toggles, white while on and grey with a red slash while off. */
/* The settings popup, as SMUP's: a card in the middle of the dim with the title in gold, three round toggles (music,
   sound, and the language coin with its flag) and the white BACK under them. A toggle is white while on and the empty
   track's grey while off, its icon crossed out; pressed, it sinks onto its drop like a button, so its caption stays. */
.settings {
    justify-content: center;
}

.settings__card {
    width: 900px;
    padding: 54px 63px 63px 63px;
    border-width: 11px;
    border-bottom-width: 29px;
    border-radius: 68px;
}

.settings__title {
    flex-shrink: 0;
    max-width: 100%;
}

.settings__title-text {
    margin: 0;
    padding: 0;
    -unity-text-auto-size: best-fit 80px 126px;
    font-size: 126px;
    color: var(--gold);
    -unity-text-outline-width: 18px;
}

.settings__title-text.stroke__drop { translate: 0 13px; display: flex; }

.settings__toggles {
    flex-direction: row;
    justify-content: center;
    margin-top: 50px;
}

.settings__column {
    align-items: center;
}

.settings__column--second {
    margin-left: 63px;
}

.settings__toggle {
    width: 162px;
    height: 176px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 9px;
    border-bottom-width: 23px;
    border-color: var(--navy);
    border-radius: 81px;
    background-color: var(--white);
    background-image: none;
}

.settings__toggle:hover { background-color: var(--soft); }
.settings__toggle--off,
.settings__toggle--off:hover { background-color: var(--track); }
.settings__toggle:active,
.settings__toggle--off:active {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    translate: 0 14px;
}

.settings__toggle-icon {
    width: 77px;
    height: 77px;
    flex-shrink: 0;
}

.settings__toggle--music .settings__toggle-icon { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_music_on.svg?fileID=7388822144124034973&guid=26d0976557343874597bca202f857be4&type=3#sprite_ui_music_on"); }
.settings__toggle--music.settings__toggle--off .settings__toggle-icon { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_music_off.svg?fileID=7388822144124034973&guid=1f9aed5d33d550c41b79f831348e53bb&type=3#sprite_ui_music_off"); }
.settings__toggle--sound .settings__toggle-icon { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_sound_on.svg?fileID=7388822144124034973&guid=5acdf37f02665824a88fd461b3bc16f3&type=3#sprite_ui_sound_on"); }
.settings__toggle--sound.settings__toggle--off .settings__toggle-icon { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_sound_off.svg?fileID=7388822144124034973&guid=5b4b1e45f31b01b45bf21be083f557d4&type=3#sprite_ui_sound_off"); }

.settings__caption {
    margin-top: 23px;
    font-size: 29px;
}

/* The language coin: the flag fills it inside its outline, with a white badge holding a chevron on its lower right that
   turns blue and points up while the list is open. */
.settings__toggle--language {
    padding: 0;
}

.settings__language-flag {
    width: 144px;
    height: 144px;
    flex-shrink: 0;
}

.settings__language-badge {
    position: absolute;
    right: -25px;
    bottom: -20px;
    width: 58px;
    height: 58px;
    align-items: center;
    justify-content: center;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 29px;
    background-color: var(--white);
}

.settings__language-chevron {
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_chevron_down.svg?fileID=7388822144124034973&guid=8687c8a957e248cd81e44e2fdb08b518&type=3#sprite_ui_chevron_down");
}

.settings__toggle--open .settings__language-badge { background-color: var(--blue); }
.settings__toggle--open .settings__language-chevron { rotate: 180deg; }

/* BACK: the white secondary button, straight after the toggles. */
.settings__back {
    align-self: stretch;
    min-width: 0;
    margin-top: 68px;
    padding: 19px 50px 33px 50px;
    border-radius: 45px;
}

.settings__back > .button__face {
    bottom: 14px;
    border-radius: 36px;
}

.settings__back-label {
    font-size: 41px;
    letter-spacing: 2px;
    -unity-font-definition: url("/Assets/UI/Fonts/font_nunito_black.asset");
}

.button--white {
    background-color: var(--shade);
    color: var(--navy);
}

.button--white > .button__face {
    background-color: var(--white);
}

.button--white:hover > .button__face,
.button--white:focus > .button__face {
    background-color: var(--soft);
}

/* A flag in a circle (sprite_ui_flag_<code>: circle-flags, MIT, from SMUP), by the language's code. */
.language-flag--en { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_flag_en.png?fileID=2800000&guid=d02e6230ae8244eea8a23cb64d493dc6&type=3#sprite_ui_flag_en"); }
.language-flag--fr { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_flag_fr.png?fileID=2800000&guid=b1c59f484d30427bb4bcae7ca2ff01e0&type=3#sprite_ui_flag_fr"); }
.language-flag--it { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_flag_it.png?fileID=2800000&guid=3276dd36bedc4d4ab6b028188e544cc8&type=3#sprite_ui_flag_it"); }
.language-flag--de { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_flag_de.png?fileID=2800000&guid=e7a0daddd17f4792bdac86700b4c61ca&type=3#sprite_ui_flag_de"); }
.language-flag--es { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_flag_es.png?fileID=2800000&guid=c2c72ffea2ce45ba95a811766171fd0b&type=3#sprite_ui_flag_es"); }
.language-flag--tr { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_flag_tr.png?fileID=2800000&guid=6f695fcd2cfb4a3cb2d74461753becee&type=3#sprite_ui_flag_tr"); }
.language-flag--pt { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_flag_pt.png?fileID=2800000&guid=3b77c616fe6046bc9d899c2d0110bb31&type=3#sprite_ui_flag_pt"); }
.language-flag--ru { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_flag_ru.png?fileID=2800000&guid=4af19f1ae49248e58994146d9c0c5d97&type=3#sprite_ui_flag_ru"); }

/* The language list: a white sticker card under the coin, its notch pointing up at it. The last child of the card, so
   it draws over BACK; SettingsView places it when it opens. Each row is the flag, the language's own name and, on the
   current one, a green tick coin; pale blue while current, soft while hovered. */
.language-list {
    display: none;
    position: absolute;
    width: 567px;
    padding: 14px 18px 18px 18px;
    border-width: 9px;
    border-bottom-width: 25px;
    border-color: var(--navy);
    border-radius: 50px;
    background-color: var(--white);
}

.language-list--open {
    display: flex;
}

/* Over the coin's centre: SettingsView puts the list's right edge 157 px past it. */
.language-list__notch {
    position: absolute;
    top: -29px;
    right: 121px;
    width: 54px;
    height: 54px;
    border-left-width: 9px;
    border-top-width: 9px;
    border-color: var(--navy);
    border-top-left-radius: 11px;
    background-color: var(--white);
    rotate: 45deg;
}

.language-row {
    flex-direction: row;
    align-items: center;
    height: 94px;
    margin: 4px 0 0 0;
    padding: 0 22px 0 14px;
    border-width: 0;
    border-radius: 32px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.language-row:hover {
    background-color: var(--soft);
}

.language-row--current,
.language-row--current:hover {
    background-color: var(--pick);
}

.language-row__flag {
    width: 81px;
    height: 81px;
    flex-shrink: 0;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 41px;
}

.language-row__name {
    flex-grow: 1;
    margin: 0 0 0 27px;
    padding: 0;
    font-size: 40px;
    color: var(--navy);
    -unity-text-align: middle-left;
    -unity-font-definition: url("/Assets/UI/Fonts/font_nunito_black.asset");
}

.language-row__check {
    display: none;
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 29px;
    background-color: var(--green);
}

.language-row--current .language-row__check {
    display: flex;
}

.language-row__tick {
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/Art/Sprites/UI/sprite_ui_check_white.svg?fileID=7388822144124034973&guid=3cb9172530394ad689efe9d0761fd4f5&type=3#sprite_ui_check_white");
}

/* Two sibling labels in a measured container, shared by the lobby and the social overlays. */
.sticker-text { flex-shrink: 0; }
.sticker-text__text {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--navy);
}

/* IO1: explicit text geometry, and no label used as the parent of its own face. */
.lobby__name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 76px;
    overflow: visible;
}
.lobby__name .sticker-text__text {
    font-size: 56px;
    color: var(--navy);
    -unity-text-outline-width: 0;
}
.lobby__name--revenge .sticker-text__text { color: var(--red); }
.lobby__row--left .lobby__name .sticker-text__text { color: var(--muted); }

/* A loading bar under the seats (in the flow, so seven seats on a 1920 high panel never run into it) and a tip at the
   bottom of the curtain: the arena loads behind it. */
.lobby__loading {
    flex-shrink: 0;
    width: 800px;
    margin-top: 44px;
    align-items: stretch;
}

.lobby__bar {
    height: 50px;
    border-width: 8px;
    border-color: rgb(14, 22, 48);
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.15);
    overflow: hidden;
}

.lobby__bar-fill {
    width: 0;
    height: 100%;
    background-color: var(--green);
}

.lobby__loading-text {
    margin: 26px 0 0 0;
    padding: 0;
    font-size: 40px;
    color: var(--silver);
    -unity-text-align: middle-center;
}

.lobby__tip {
    position: absolute;
    bottom: 110px;
    margin: 0;
    padding: 14px 40px 18px 40px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.1);
    font-size: 40px;
    color: var(--white);
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.lobby__badge {
    height: 80px;
    padding: 0;
    justify-content: center;
}
.lobby__badge .sticker-text__text {
    font-size: 36px;
    color: var(--navy);
    -unity-text-outline-width: 0;
    -unity-text-align: middle-center;
}
.lobby__badge.lobby__badge--streak { padding: 0 24px; }

/* The level opens the row, big enough to read its number and league from across the screen; the slot is one width
   for any badge, its wings and the rival's horns, so every nick starts on the same line. */
.lobby__level-slot {
    width: 170px;
    margin: 0 18px 0 0;
}

.lobby__level {
    min-width: 92px;
    height: 78px;
    padding: 0 14px;
    border-width: 6px;
    border-bottom-width: 11px;
    border-radius: 22px;
}

.lobby__level .level-badge__value { font-size: 46px; }
.lobby__level .level-badge__prefix { font-size: 20px; padding: 0 8px 1px 8px; }

/* One short feed below the portrait pills; the wide layout uses the free top-left corner. */
.feed {
    position: absolute;
    left: 24px;
    top: 240px;
    width: 660px;
    height: 0;
    visibility: hidden;
}
.feed--wide { top: 54px; }
.feed__row {
    position: absolute;
    left: 0;
    right: 0;
    height: 68px;
    flex-direction: row;
    align-items: center;
    padding: 2px 12px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    border-radius: 24px;
    background-color: var(--name-backdrop);
    color: var(--white);
    font-size: 30px;
}
.feed__row--you { background-color: var(--white); color: var(--navy); }
.feed__row .sticker-text__text { font-size: 30px; color: var(--white); }
.feed__row--you .sticker-text__text { color: var(--navy); -unity-text-outline-width: 0; }
.feed__row .hud__chip {
    position: relative;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-width: 4px;
    border-radius: 21px;
    margin-right: 8px;
    transition-duration: 0s;
}
.feed__row .hud__chip-car { scale: 0.65 0.65; }
.feed__row .hud__chip-ring { border-width: 2px; border-radius: 16px; }
.feed__name {
    height: 48px;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
}
.feed__name .sticker-text__text { overflow: hidden; text-overflow: ellipsis; }
.feed__fell { height: 48px; margin-left: 14px; margin-right: 8px; }
.feed__arrow {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin: 0 16px 0 10px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-color: var(--gold);
    rotate: 45deg;
}

.emotion {
    position: absolute;
    width: 280px;
    height: 90px;
    align-items: stretch;
    justify-content: center;
    padding: 0 12px;
    border-width: 6px;
    border-bottom-width: 12px;
    border-color: var(--navy);
    border-radius: 30px;
    background-color: var(--white);
    color: var(--navy);
    font-size: 42px;
}
.emotion__text { height: 68px; }
.emotion__text .sticker-text__text { font-size: 42px; color: var(--navy); -unity-text-align: middle-center; -unity-text-outline-width: 0; }


/* A match's scoreboard (HudScoreboard): a row per car in the order of the score, placed by its translate so a new
   order slides; under one knock-out star that names the column. The narrow form (a phone held upright) mirrors the feed
   at the top right under the gear: the three leaders and, a little apart, the player's own row with its place. The wide
   form is the whole column at the right side beside the arena, under the gear, its text larger because a wide screen's
   panel is scaled down. Rows are the feed's translucent navy with white names; the player's is white with navy text.
   Nothing takes a touch; it is shown once the match runs and fades while a finger steers under it. */
.scoreboard {
    display: none;
    position: absolute;
    right: 24px;
    top: 240px;
    width: 340px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.scoreboard--match { display: flex; }
.scoreboard--shown { opacity: 1; }
.scoreboard--faded { opacity: 0.2; }

.scoreboard--wide {
    right: 48px;
    top: 200px;
    width: 600px;
}

/* The star sits over the knock-out column's middle. */
.scoreboard__header {
    flex-direction: row;
    justify-content: flex-end;
    height: 44px;
    padding-right: 6px;
}

.scoreboard__star {
    width: 40px;
    height: 40px;
}


.scoreboard--wide .scoreboard__header {
    height: 60px;
    padding-right: 14px;
}

.scoreboard--wide .scoreboard__star { width: 56px; height: 56px; }

.scoreboard__rows {
    height: 0;
}

/* Every row is at the top of the list, moved down to its place; the move and a fade ease in, as the rows reorder after
   a knock-out. */
.scoreboard__row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 12px 0 6px;
    border-width: 4px;
    border-bottom-width: 8px;
    border-color: var(--navy);
    border-radius: 22px;
    background-color: var(--name-backdrop);
    transition-property: translate, opacity, scale;
    transition-duration: 0.25s, 0.2s, 0.2s;
    transition-timing-function: ease-out;
}

.scoreboard--wide .scoreboard__row {
    height: 76px;
    padding: 0 18px 0 8px;
    border-width: 5px;
    border-bottom-width: 10px;
    border-radius: 30px;
}

.scoreboard__row--you {
    background-color: var(--white);
}


.scoreboard__row--hidden {
    opacity: 0;
    scale: 0.85 0.85;
}

/* The place on a small round badge: gold, silver and bronze for the podium, white for the rest. */
.scoreboard__rank {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-width: 4px;
    border-color: var(--navy);
    border-radius: 20px;
    background-color: var(--white);
}

.scoreboard--wide .scoreboard__rank {
    width: 54px;
    height: 54px;
    border-width: 5px;
    border-radius: 27px;
}

.scoreboard__rank--1 { background-color: var(--gold); }
.scoreboard__rank--2 { background-color: var(--silver); }
.scoreboard__rank--3 { background-color: var(--bronze); }

.scoreboard__rank-text {
    margin: 0;
    padding: 0 0 3px 0;
    font-size: 28px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.scoreboard--wide .scoreboard__rank-text {
    font-size: 36px;
}

.scoreboard__chip {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    margin-left: 8px;
}

.scoreboard--wide .scoreboard__chip {
    width: 58px;
    height: 58px;
    margin-left: 12px;
}

.scoreboard__chip .hud__chip {
    width: 100%;
    height: 100%;
    border-width: 4px;
    border-radius: 999px;
    transition-duration: 0s;
}

.scoreboard__chip .hud__chip-car { scale: 0.55 0.55; }
.scoreboard__chip .hud__chip-ring { border-width: 3px; border-radius: 999px; }
.scoreboard--wide .scoreboard__chip .hud__chip { border-width: 5px; }
.scoreboard--wide .scoreboard__chip .hud__chip-car { scale: 0.8 0.8; }
.scoreboard--wide .scoreboard__chip .hud__chip-ring { border-width: 4px; }

/* The seconds until a fallen car comes back, on a navy disc over its chip; empty while it is in play. */
.scoreboard__countdown {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0 0 2px 0;
    border-radius: 999px;
    background-color: var(--navy);
    font-size: 28px;
    color: var(--white);
    -unity-text-align: middle-center;
}

.scoreboard--wide .scoreboard__countdown { font-size: 38px; }
.scoreboard__row--out .scoreboard__countdown { display: flex; }

.scoreboard__target {
    display: none;
    margin-left: 8px;
    margin-right: 0;
}

.scoreboard__row--revenge .scoreboard__target { display: flex; }

.scoreboard__name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 44px;
    margin-left: 10px;
    overflow: hidden;
}

.scoreboard--wide .scoreboard__name {
    height: 60px;
    margin-left: 14px;
}

.scoreboard__name .sticker-text__text {
    font-size: 30px;
    color: var(--white);
    overflow: hidden;
    text-overflow: ellipsis;
}

.scoreboard--wide .scoreboard__name .sticker-text__text {
    font-size: 44px;
    -unity-text-outline-width: 4px;
}

.scoreboard__row--revenge .scoreboard__name .sticker-text__text { color: var(--red); }
.scoreboard__row--you .scoreboard__name .sticker-text__text { color: var(--navy); -unity-text-outline-width: 0; }

/* A fallen car's row, dimmed by colour: opacity on an outlined StickerText shows its stroke layer through the face as a
   dark rim inside every letter. */
.scoreboard__row--out { background-color: rgba(29, 43, 79, 0.35); border-color: rgba(29, 43, 79, 0.6); }
.scoreboard__row--you.scoreboard__row--out { background-color: rgba(255, 255, 255, 0.6); }
.scoreboard__row--out .scoreboard__rank,
.scoreboard__row--out .hud__chip,
.scoreboard__row--out .scoreboard__target { opacity: 0.5; }
.scoreboard__row--out .scoreboard__name .sticker-text__text { color: rgb(160, 170, 192); }
.scoreboard__row--revenge.scoreboard__row--out .scoreboard__name .sticker-text__text { color: rgb(214, 128, 136); }
.scoreboard__row--you.scoreboard__row--out .scoreboard__name .sticker-text__text { color: var(--navy); }
.scoreboard__row--out .scoreboard__ko .sticker-text__text { color: rgb(196, 170, 104); }

/* The knock-outs, in a column wide enough for two digits so the names do not move as they grow; gold as the star. */
.scoreboard__ko {
    min-width: 46px;
    height: 44px;
    margin-left: 6px;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.scoreboard--wide .scoreboard__ko {
    min-width: 72px;
    height: 60px;
}

.scoreboard__ko .sticker-text__text {
    font-size: 36px;
    color: var(--gold);
    -unity-text-align: middle-center;
}

.scoreboard--wide .scoreboard__ko .sticker-text__text {
    font-size: 50px;
    -unity-text-outline-width: 4px;
}

.scoreboard__row--you .scoreboard__ko .sticker-text__text { color: var(--navy); -unity-text-outline-width: 0; }

.scoreboard__ko--pop {
    scale: 1.45 1.45;
    transition-duration: 0.05s;
}

/* The face of each two-label text has no outline of its own, as everywhere else (.stroke > .stroke__face); the wide
   form sets the outline on .sticker-text__text, so the face needs the same weight of selector to stay clean. */
.scoreboard__row .stroke > .stroke__face,
.scoreboard--wide .scoreboard__name .sticker-text__text.stroke__face,
.scoreboard--wide .scoreboard__ko .sticker-text__text.stroke__face { -unity-text-outline-width: 0; }

/* The end of a match (RoundOverMatch): the winner turning on its podium over slow white rays (drawn in code), a white
   pill with a crown over it, and the results table beside it: at its right on a phone held upright, where the two
   stacked would not fit over the level card. A wide screen sets them apart on both sides of the level card, the table
   at the left and a bigger podium at the right. The match part takes the height left between the title and the level
   card. */
.round-over__match {
    display: none;
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    min-height: 0;
    margin: 12px 30px 0 30px;
}

.round-over--match .round-over__match {
    display: flex;
}

.round-over--match .round-over__spacer {
    flex-grow: 0;
    min-height: 12px;
}

/* After a round the podium alone, in the middle: no table beside it. */
.round-over--podium .round-over__match {
    display: flex;
}

.round-over--podium .round-over__spacer {
    flex-grow: 0;
    min-height: 12px;
}

.round-over--podium .results {
    display: none;
}

/* A round's podium has no subtitle or name pill over the player's own car: the car takes that height, and its
   picture reaches down under the cards below (later in the tree, so drawn over it), which cover the podium's foot. */
.round-over--podium .podium {
    margin-top: 0;
}

.round-over--podium .podium__car {
    top: 0;
    bottom: -70px;
}

/* The car that pushed the player off keeps its name pill, up at the podium's top, over the car's roof. */
.round-over--podium .podium--rival .podium__winner {
    top: 0;
}

.round-over--podium .podium--rival .podium__car {
    top: 90px;
}

/* WINNER under a won round's title, the one sticker there when neither REVENGE! nor the streak has it. */
.round-over__ribbon {
    flex-shrink: 0;
    margin-top: 12px;
    rotate: -3deg;
}

.podium {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 380px;
    align-items: center;
}

.podium__rays {
    position: absolute;
    transition-property: scale, opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-back;
}

.podium__rays--enter {
    scale: 0 0;
    opacity: 0;
}

.podium__car {
    position: absolute;
    left: 0;
    top: 96px;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.podium__winner {
    position: absolute;
    top: 46px;
    flex-direction: row;
    align-items: center;
    padding: 8px 36px 10px 12px;
    border-width: 7px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 50px;
    background-color: var(--white);
    transition-property: scale, opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.podium__winner--enter {
    translate: 0 40px;
    scale: 0.4 0.4;
    opacity: 0;
}

.podium__crown {
    position: absolute;
    left: 50%;
    top: -60px;
    width: 92px;
    height: 64px;
    margin-left: -46px;
    transition-property: translate, rotate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.podium__crown--enter {
    translate: 0 -110px;
    rotate: -25deg;
    opacity: 0;
}

.podium__level {
    margin-left: 6px;
}

.podium__name {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 40px;
    color: var(--navy);
    white-space: nowrap;
}

.podium__name--revenge { color: var(--red); }

.podium__target {
    width: 40px;
    height: 40px;
    margin: 0 0 0 12px;
    border-width: 5px;
    border-radius: 20px;
}

.podium__target .revenge-target__center {
    width: 14px;
    height: 14px;
    border-radius: 7px;
}

.podium__tag {
    position: absolute;
    left: 50%;
    bottom: -44px;
    translate: -50% 0;
    margin: 0;
    padding: 0 22px 2px 22px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 22px;
    background-color: var(--gold);
    font-size: 28px;
    letter-spacing: 3px;
    color: var(--navy);
    white-space: nowrap;
}

.podium__tag--rival {
    background-color: var(--red);
    color: var(--white);
    letter-spacing: 1px;
}

.results {
    flex-shrink: 0;
    align-self: center;
    width: 560px;
    margin-left: 16px;
    padding: 12px 18px 18px 18px;
    border-width: 7px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 40px;
    background-color: var(--white);
    transform-origin: 50% 0;
    transition-property: scale, opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.results--enter {
    translate: 0 -40px;
    scale: 0.7 0.7;
    opacity: 0;
}

.results__header {
    flex-direction: row;
    justify-content: space-between;
    padding: 0 30px 6px 16px;
}

.results__title {
    margin: 0;
    padding: 0;
    font-size: 28px;
    letter-spacing: 2px;
    color: #5b6b8c;
}

.results__row {
    flex-direction: row;
    align-items: center;
    height: 62px;
    margin-top: 8px;
    padding: 0 30px 0 6px;
    border-radius: 31px;
    background-color: #eef3fb;
    transition-property: translate, scale, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.results__row--enter {
    translate: -70px 0;
    scale: 0.6 0.6;
    opacity: 0;
}

.results__row--pop {
    scale: 1.07 1.07;
}

.results__row--you {
    border-width: 6px;
    border-color: var(--navy);
    background-color: var(--gold);
}

.results__rank {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 25px;
    background-color: var(--white);
}

.results__rank--1 { background-color: var(--gold); }
.results__rank--2 { background-color: #d7e0ee; }
.results__rank--3 { background-color: #e8a46a; }

.results__rank-text {
    margin: 0;
    padding: 0;
    font-size: 26px;
    color: var(--navy);
    -unity-text-align: middle-center;
}

.results__level-slot {
    width: 96px;
    margin-left: 6px;
}

.results__level {
    min-width: 46px;
    height: 38px;
    padding: 0 6px;
    border-width: 4px;
    border-bottom-width: 7px;
    border-radius: 12px;
}

.results__level .level-badge__value { font-size: 22px; }

.results__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 0 0 14px;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 36px;
    color: var(--navy);
}

.results__row--revenge .results__name { color: var(--red); }

.results__ko {
    flex-shrink: 0;
    min-width: 50px;
    margin: 0;
    padding: 0;
    font-size: 36px;
    color: var(--navy);
    -unity-text-align: middle-right;
}

.results__ko--zero { color: #9aa8c0; }

.results__gap {
    height: 30px;
    margin: 4px 0 -4px 0;
    padding: 0;
    font-size: 30px;
    letter-spacing: 6px;
    color: #9aa8c0;
    -unity-text-align: middle-center;
    transition-property: opacity;
    transition-duration: 0.25s;
}

/* A wide screen: every car, a size up, at the left; the podium at the right, as tall as the table and the card beside
   it allow. */
.round-over--landscape .round-over__match {
    flex-direction: column;
    margin-top: 0;
}

.round-over--landscape .podium {
    position: absolute;
    right: 80px;
    top: -60px;
    width: 900px;
    height: 1040px;
}

.round-over--landscape.round-over--podium .podium {
    right: auto;
    left: 50%;
    margin-left: -450px;
}

.results--wide {
    position: absolute;
    left: 80px;
    top: 0;
    width: 820px;
    margin-left: 0;
    transform-origin: 0 0;
}

.results--wide .results__title { font-size: 34px; }
.results--wide .results__row { height: 80px; margin-top: 10px; border-radius: 40px; }
.results--wide .results__rank { width: 62px; height: 62px; border-radius: 31px; }
.results--wide .results__rank-text { font-size: 32px; }
.results--wide .results__level { min-width: 56px; height: 46px; }
.results--wide .results__level-slot { width: 124px; }
.results--wide .results__level .level-badge__value { font-size: 26px; }
.results--wide .results__name { font-size: 44px; }
.results--wide .results__ko { font-size: 44px; min-width: 60px; }


.round-over--landscape .podium__name { font-size: 50px; }

/* The bottom of the result: the level card over the buttons, or (a wide desktop screen) beside them. */
.round-over__bottom {
    flex-shrink: 0;
    align-self: stretch;
    align-items: center;
}

.round-over__next-key {
    display: none;
}

/* The end of a match (HudEndTimer). The red frame round the screen in the last ten seconds, its opacity beating with
   the clock; under every other part of the HUD. */
.end-frame {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 28px;
    border-color: rgb(255, 77, 77);
    opacity: 0;
}

/* A red ring spreading from the bar on each of the last seconds. */
.end-ring {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 10px;
    border-color: var(--red);
    border-radius: 68px;
}

/* 30 SECONDS LEFT! and FINAL 10!: gold words with a navy stroke under the bar, tilted, the goal of the start screen's
   look. The code sets its top under the bar and springs it in. */
.end-note {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
}

.end-note__sticker {
    align-self: stretch;
    margin: 0 60px;
}

.end-note__text {
    margin: 0;
    padding: 0;
    align-self: stretch;
    -unity-text-auto-size: best-fit 40px 84px;
    font-size: 84px;
    color: var(--gold);
    -unity-text-outline-width: 15px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.end-note__text.stroke__drop { translate: 0 11px; display: flex; }

/* TIME UP! at 0:00: big white words with the kick-off's navy stroke, a gold ring and gold stars bursting behind. */
.end-stamp {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding-bottom: 200px;
}

.end-stamp__ring {
    position: absolute;
    left: -200px;
    top: -200px;
    width: 400px;
    height: 400px;
    border-radius: 200px;
    border-width: 28px;
    border-color: var(--gold);
}

.end-stamp__star {
    position: absolute;
    left: -62px;
    top: -62px;
}

.end-stamp__sticker {
    position: absolute;
    left: -500px;
    top: -200px;
    width: 1000px;
    height: 400px;
    justify-content: center;
}

.end-stamp__text {
    flex-grow: 1;
    margin: 0 20px;
    padding: 0 0 24px 0;
    -unity-text-auto-size: best-fit 90px 230px;
    font-size: 230px;
    color: var(--white);
    -unity-text-outline-width: 34px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.end-stamp__text.stroke__drop { translate: 0 26px; display: flex; }

/* Coins (RoundOverMeta, the garage): a gold disc with a navy ring and a paler disc inside, built of elements. */
.coin {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-width: 5px;
    border-bottom-width: 8px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--gold);
}

.coin__inner {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background-color: #ffe39a;
}

/* The player's coins in the result's corner, left of the gear; it bumps as the round's coins land. */
.coin-pill {
    position: absolute;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.coin-pill--bump {
    scale: 1.15 1.15;
}

/* The round's reward on top of the level card (RoundOverRewards): two equal stickers, XP and coins, and CLAIM x2 to
   double them for a rewarded ad. Missions keep their own rewards on their rows. */
.rewards {
    flex-direction: row;
    align-items: stretch;
    height: 176px;
    margin: 0 0 24px 0;
}

.reward {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 20px 0 0;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 36px;
    background-color: var(--soft);
}

.reward__what {
    flex-direction: row;
    align-items: center;
}

.reward__icon {
    width: 48px;
    height: 48px;
    margin: 0 10px 0 0;
}


.reward--coins .reward__icon {
    border-width: 5px;
    border-bottom-width: 7px;
}

.reward__name {
    margin: 0;
    padding: 0;
    font-size: 34px;
    color: var(--navy);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.reward__value-text {
    margin: 0;
    padding: 0;
    font-size: 84px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-outline-width: 10px;
    -unity-text-outline-color: var(--navy);
}

.reward__value-text.stroke__drop { translate: 0 6px; display: flex; }

.reward--xp .reward__value-text {
    color: var(--xp);
}

.reward--coins .reward__value-text {
    color: var(--gold);
}

/* x2 slapped on the corner of each sticker once the ad has paid. */
.reward__stamp {
    position: absolute;
    top: -40px;
    right: -26px;
    rotate: 12deg;
}

.reward__stamp-text {
    margin: 0;
    padding: 0;
    font-size: 56px;
    color: var(--gold);
    -unity-text-outline-width: 9px;
    -unity-text-outline-color: var(--navy);
}

.reward__stamp-text.stroke__drop { translate: 0 5px; display: flex; }

/* x2 BOOST hanging on the XP sticker's bottom edge when the XP boost paid for the round: blue, as XP is. The top
   corners hold the star and name and CLAIM x2's own x2, so it keeps clear of both. */
.reward__boost {
    position: absolute;
    bottom: -36px;
    left: 50%;
    translate: -50% 0;
    padding: 0 14px 3px 14px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--xp);
    rotate: -4deg;
}

/* The day's first win: the same stamp in orange, across the XP and COINS stickers (its left is set in code). */
.reward__first-win {
    background-color: var(--orange);
    rotate: 3deg;
}

.rewards > .reward__first-win {
    bottom: -28px;
}

.reward__boost-label-text {
    font-size: 28px;
    -unity-text-outline-width: 7px;
}

/* CLAIM x2: the purple sticker button with a video sign and an AD tag, as rewarded ads are marked. */
.button--purple {
    background-color: #7f45d4;
}

.button--purple > .button__face {
    background-color: var(--purple);
}

.button--purple:hover > .button__face,
.button--purple:focus > .button__face {
    background-color: #bf86ff;
}

.button--purple .button__label {
    color: var(--white);
    -unity-text-outline-width: 11px;
    -unity-text-outline-color: var(--navy);
}

/* A button's face label never has an outline of its own: .button--purple .button__label comes after the general
   .stroke > .stroke__face and would otherwise outline the face too, thinning the letters from inside. */
.button .button__label.stroke__face { -unity-text-outline-width: 0; }

.double {
    flex-grow: 1.25;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: 0 20px 14px 20px;
    border-width: 6px;
    border-bottom-width: 16px;
    border-radius: 36px;
}

.double > .button__face {
    bottom: 12px;
    border-radius: 30px;
}

.double:active {
    translate: 0 10px;
}

.double:disabled {
    background-color: rgb(118, 96, 160);
}

/* Waiting for its ad, by colour rather than opacity: a translucent outlined label shows its stroke inside the letters. */
.double:disabled > .button__face { background-color: rgb(172, 150, 214); }
.double:disabled .button__label { color: rgb(226, 218, 242); }

.double__play {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    margin: 0 12px 0 0;
}

/* Fills the room beside the play sign, its text in the middle: FitText sizes the text to that room. */
.double__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* A fixed size: best-fit would size the outline and the face over it apart. A thinner outline than the big buttons':
   the label is half their size. */
.double .double__label-text {
    font-size: 50px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 6px;
}

.double .double__label-text.stroke__drop { translate: 0 4px; display: flex; }

.double .stroke > .stroke__face {
    -unity-text-outline-width: 0;
}

.double__key {
    flex-shrink: 0;
    margin-left: 14px;
    padding: 0 16px 2px 16px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
}

.double__key .key__text {
    font-size: 30px;
}

.double__tag {
    position: absolute;
    top: -24px;
    right: 26px;
    margin: 0;
    padding: 2px 14px 4px 14px;
    border-radius: 14px;
    background-color: var(--navy);
    color: var(--white);
    font-size: 26px;
    letter-spacing: 1px;
}

/* Where CLAIM x2 was, once paid. USS has no dashed border, so a pale sunken pill. */
.doubled {
    flex-grow: 1.25;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: 5px;
    border-color: rgba(29, 43, 79, 0.3);
    border-radius: 36px;
    background-color: rgba(29, 43, 79, 0.06);
}

.doubled__tick {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    margin: 0 14px 0 0;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--green);
}

.doubled__tick > .track__tick-mark {
    width: 26px;
    height: 13px;
    margin-top: -6px;
    border-left-width: 7px;
    border-bottom-width: 7px;
}

.doubled__label {
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: 46px;
    -unity-text-auto-size: best-fit 26px 46px;
    color: var(--navy);
    white-space: nowrap;
}

/* STREAK xN under the title (gold, as NEW BEST!), or STREAK LOST (grey): shares the stickers' entrance. */
.round-over__streak {
    flex-shrink: 0;
    margin-top: 24px;
    rotate: -3deg;
}

.round-over__streak--lost {
    border-width: 6px;
    border-color: var(--navy);
    background-color: var(--soft);
    color: var(--muted);
}

/* The three missions over the level card (RoundOverMeta builds the rows). A done one ticks gold and shows its XP, then
   turns into the mission that replaces it. */
.missions {
    flex-shrink: 0;
    align-self: center;
    align-items: stretch;
    margin: 4px 0 0 0;
    padding: 10px 34px 14px 34px;
    border-bottom-width: 18px;
    border-radius: 44px;
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.round-over--enter .missions {
    translate: 0 120px;
    opacity: 0;
}

.missions__title {
    margin: 0;
    padding: 0;
    font-size: 28px;
    letter-spacing: 2px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

.mission {
    flex-direction: row;
    align-items: center;
    height: 66px;
    transition-property: translate, opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.mission--enter {
    translate: -60px 0;
    opacity: 0;
}

.mission--swap {
    scale: 0.9 0.9;
    opacity: 0;
}

/* A tick of two borders (the daily calendar's days). */
.mission__mark {
    width: 13px;
    height: 23px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-color: var(--navy);
    rotate: 45deg;
    translate: 0 -3px;
    opacity: 0;
}

.missions .mission-icon {
    width: 56px;
    height: 56px;
    border-width: 5px;
    border-radius: 16px;
}

.mission--done .mission-icon { scale: 1.15 1.15; }

.mission__task {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 0 0 18px;
    padding: 0;
    font-size: 34px;
    color: var(--navy);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.missions .mission-progress__count { font-size: 32px; }
.missions .mission-progress__bar { width: 96px; height: 18px; margin-top: 4px; border-width: 4px; border-radius: 9px; }
.missions .mission-progress__fill { border-radius: 5px; }

.mission__reward { margin-left: 20px; }
.missions .mission-reward__xp-count,
.missions .mission-reward__coin-count { font-size: 32px; }
.missions .mission-reward .coin { width: 40px; height: 40px; border-bottom-width: 6px; }
.missions .mission-reward__star { width: 36px; height: 36px; }

/* -- A mission's parts (MissionLook): the menu's card and popup and the result ---------------------------------------- */

/* The slot's sign on a white tile; a gold tile with a navy tick once done. Not a circle: it is not a button. */
.mission-icon {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 26px;
    background-color: var(--white);
    transition-property: background-color, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.mission-icon--done { background-color: var(--gold); }

.mission-icon__sign {
    width: 80%;
    height: 80%;
}

/* The count over a thin gold bar, for a mission of more than one step. The bar's and the fill's radii are half their
   heights, not 999px: UI Toolkit clamps a radius on each axis apart, and 999px on a bar this flat drew a flat oval. */
.mission-progress {
    flex-shrink: 0;
    align-items: flex-end;
    margin-left: 18px;
}

.mission-progress__count {
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: var(--muted);
}

.mission-progress__bar {
    width: 130px;
    height: 26px;
    margin-top: 6px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 13px;
    background-color: var(--track);
    overflow: hidden;
}

.mission-progress__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 8px;
    background-color: var(--gold);
}

/* +N XP in blue with the XP star, then the coins: the same reward wherever a mission is shown. */
.mission-reward {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.mission-reward__xp,
.mission-reward__coins {
    flex-direction: row;
    align-items: center;
}

.mission-reward__xp { margin-right: 26px; }

.mission-reward__star {
    width: 40px;
    height: 40px;
    margin-right: 6px;
}

.mission-reward__xp-count,
.mission-reward__coin-count {
    margin: 0;
    padding: 0;
    font-size: 36px;
    white-space: nowrap;
}

.mission-reward__xp-count { color: var(--xp); }

.mission-reward__coin-count {
    margin-left: 8px;
    color: var(--navy);
}

.mission-reward .coin {
    width: 42px;
    height: 42px;
    border-width: 4px;
    border-bottom-width: 6px;
}

.mission-reward .coin__inner {
    width: 16px;
    height: 16px;
}

/* With the missions over it, the level card and the podium give up a little height, so a 16:9 portrait still fits. */
.round-over--meta .level-card {
    margin: 14px 0 30px 0;
}

.round-over--meta .podium {
    min-height: 300px;
}

/* Landscape on a touch screen the podium stands over the middle column: the missions go to the empty left of it, and
   the podium comes down a little so its crown clears the streak sticker under the title. */
.round-over--landscape.round-over--meta .missions {
    position: absolute;
    left: 96px;
    top: 380px;
    width: 640px;
}

.round-over--landscape.round-over--meta .podium {
    top: 10px;
}

/* The garage's stats under the reward, a little closer than in its window. */
.level-reward__card .level-reward__stats {
    margin-top: 34px;
}

/* No boosts in this build (GameTuning.Boost off): no BOOST button, and the start prompt teaches only driving. The
   button keeps its place, hidden, so the item button in the same slot stays where it was. */
.hud--no-boost .hud__boost {
    visibility: hidden;
}

.hud--no-boost .hud__boost-hint,
.hud--no-boost .hud__start-hint--touch,
.hud--no-boost .hud__start-sep,
.hud--no-boost .hud__start-click-text,
.hud--no-boost .hud__start-hint--desktop .hud__start-key {
    display: none;
}

/* BUY & EQUIP without the coins: grey, the price faded. */
.level-reward__buy--dear {
    background-color: rgb(168, 176, 196);
}

.level-reward__buy--dear .level-reward__price {
    opacity: 0.7;
}

/* A taken reward: the button stays in place, greyed out, so the card does not change shape under the stamp. By colour
   rather than opacity (as CLAIM x2 waiting for its ad): a translucent outlined label shows its stroke inside the
   letters, and the default theme fades disabled elements, so every layer is kept opaque. */
.level-reward__buy:disabled,
.level-reward__buy:disabled * {
    opacity: 1;
}

.level-reward__buy:disabled {
    background-color: rgb(168, 176, 196);
    translate: 0 0;
}

.level-reward__buy:disabled .level-reward__buy-label-text { color: rgb(226, 230, 238); }
.level-reward__buy:disabled .level-reward__buy-label-text.stroke__drop { color: var(--navy); }
.level-reward__buy:disabled .level-reward__price { background-color: rgb(226, 230, 238); }

/* The celebration of a taken reward (RewardCelebration): a white flash over the popup, coins arcing into the
   counter, the EQUIPPED! stamp over the reward and NEED N MORE floating up when the coins are short. */
.reward-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--white);
}

.reward-coin {
    position: absolute;
    left: -32px;
    top: -32px;
    width: 64px;
    height: 64px;
}

.reward-stamp {
    position: absolute;
    left: 0;
    right: 0;
    top: 100px;
    align-items: center;
}

.reward-stamp__pill {
    padding: 4px 34px 6px 34px;
    border-width: 9px;
    border-bottom-width: 18px;
    border-color: var(--navy);
    border-radius: 28px;
    background-color: var(--green);
}

.reward-stamp__label-text {
    margin: 0;
    padding: 0;
    font-size: 84px;
    color: var(--white);
    -unity-text-outline-width: 12px;
    -unity-text-outline-color: var(--navy);
    white-space: nowrap;
}

.reward-stamp__label-text.stroke__drop { translate: 0 6px; display: flex; }

.reward-toast {
    position: absolute;
    left: 0;
    top: 0;
}

.reward-toast-text {
    margin: 0;
    padding: 0;
    font-size: 56px;
    color: rgb(255, 77, 77);
    -unity-text-outline-width: 10px;
    -unity-text-outline-color: var(--navy);
    white-space: nowrap;
}

.reward-toast-text.stroke__drop { translate: 0 5px; display: flex; }

/* Without BOOST its place is free: the item button takes it, larger, at the height BOOST stood, with its timer badge
   and first hint over it. */
.hud--no-boost .hud__boost-slot--items .hud__item {
    left: -10px;
    top: -10px;
    width: 320px;
    height: 320px;
    border-width: 10px;
    border-bottom-width: 22px;
}

.hud--no-boost .hud__boost-slot--items .hud__item-icon {
    width: 220px;
    height: 220px;
    border-width: 8px;
}

.hud--no-boost .hud__boost-slot--items .hud__item-glyph {
    scale: 1.35 1.35;
}

.hud--no-boost .hud__boost-slot--items .hud__item-mark {
    font-size: 136px;
}

.hud--no-boost .hud__boost-slot--items .hud__power {
    top: -150px;
}

.hud--no-boost .hud__boost-slot--items .hud__item-hint {
    left: -50px;
    top: -185px;
}

.hud--no-boost .hud__boost-slot--items .hud__item-hint .hud__item-hint-arrow {
    left: 164px;
}

/* A phone held wide: the landscape panel is drawn smaller, so the item button grows back to a thumb's size there
   (HudView also stands its slot further in from the side and the bottom). */
.hud--no-boost.hud--wide .hud__boost-slot--items .hud__item {
    left: -70px;
    top: -70px;
    width: 440px;
    height: 440px;
    border-width: 12px;
    border-bottom-width: 28px;
}

.hud--no-boost.hud--wide .hud__boost-slot--items .hud__item-icon {
    width: 304px;
    height: 304px;
    border-width: 10px;
}

.hud--no-boost.hud--wide .hud__boost-slot--items .hud__item-glyph {
    scale: 1.85 1.85;
}

.hud--no-boost.hud--wide .hud__boost-slot--items .hud__item-mark {
    font-size: 188px;
}

.hud--no-boost.hud--wide .hud__boost-slot--items .hud__power {
    top: -215px;
}

.hud--no-boost.hud--wide .hud__boost-slot--items .hud__item-hint {
    top: -250px;
}

.hud--no-boost .hud__item--desktop {
    left: 35px;
    top: 40px;
    width: 230px;
    height: 230px;
    border-width: 8px;
    border-bottom-width: 18px;
}

.hud--no-boost .hud__item--desktop .hud__item-icon {
    width: 158px;
    height: 158px;
}

.hud--no-boost .hud__item--desktop .hud__item-glyph {
    scale: 1 1;
}

.hud--no-boost .hud__item--desktop .hud__item-mark {
    font-size: 100px;
}

.hud--no-boost .hud__item-hint--desktop {
    left: -180px;
    top: 285px;
}

.hud--no-boost .hud__boost-slot--left .hud__item-hint--desktop {
    left: 80px;
}

.hud--no-boost .hud__boost-slot--left .hud__item-hint--desktop .hud__item-hint-arrow {
    left: 70px;
}

/* A wide screen (round-over--columns, a phone held sideways or a desktop): the title, the streak and the podium in
   the left part, the missions, the level card and the buttons in a column at the right, which RoundOverView scales to
   the height it has and keeps, with the left part, off both side edges (a phone's camera may sit in the middle of
   either). The podium takes all the height under the title, so no card covers the car. */
.round-over--columns.round-over--landscape .round-over__spacer-top {
    height: 60px;
    min-height: 20px;
}

.round-over--columns.round-over--landscape .round-over__title-text {
    -unity-text-auto-size: best-fit 80px 230px;
    font-size: 230px;
}

.round-over--columns.round-over--landscape .round-over__subtitle {
    -unity-text-auto-size: best-fit 32px 70px;
    font-size: 70px;
}

.round-over--columns.round-over--landscape .round-over__match {
    margin: 0;
}

.round-over--columns.round-over--landscape .round-over__spacer {
    display: none;
}

/* Beside the cards, not over them: the picture stays inside its own column. */
.round-over--columns.round-over--landscape .podium__car {
    bottom: 0;
}

.round-over--columns.round-over--landscape .podium {
    position: relative;
    left: auto;
    right: auto;
    top: 0;
    width: auto;
    height: auto;
    margin: 20px 0 0 0;
    flex-grow: 1;
    align-self: stretch;
}

.round-over--columns.round-over--match .podium {
    margin-left: 900px;
}

/* The rival a size up beside the cards (a phone held sideways shows the panel at about half size), its pill standing
   on the car's roof (RoundOverMatch.OnRivalGeometry) rather than at the podium's top. */
.round-over--columns.round-over--landscape .podium--rival .podium__winner {
    padding: 12px 52px 14px 16px;
    border-width: 9px;
    border-bottom-width: 18px;
    border-radius: 70px;
}

.round-over--columns.round-over--landscape .podium--rival .podium__name { font-size: 76px; margin-left: 18px; }

.round-over--columns.round-over--landscape .podium--rival .podium__level {
    min-width: 84px;
    height: 72px;
    border-radius: 22px;
}

.round-over--columns.round-over--landscape .podium--rival .podium__level .level-badge__value { font-size: 44px; }
.round-over--columns.round-over--landscape .podium--rival .podium__level .level-badge__prefix { font-size: 22px; }

.round-over--columns.round-over--landscape .podium--rival .podium__tag {
    bottom: -60px;
    padding: 2px 30px 4px 30px;
    border-width: 7px;
    border-radius: 30px;
    font-size: 40px;
}

.round-over--columns.round-over--landscape .round-over__spacer-bottom {
    height: 40px;
}

.round-over--columns.round-over--landscape .round-over__bottom {
    position: absolute;
    width: 1040px;
    align-items: stretch;
    transform-origin: 100% 100%;
}

.round-over--columns.round-over--landscape .missions {
    position: absolute;
    left: auto;
    width: 1040px;
    margin: 0;
    transform-origin: 100% 0;
}

.round-over--columns.round-over--landscape .level-card {
    width: auto;
    margin: 0 0 30px 0;
}

.round-over--columns.round-over--landscape .round-over__actions {
    align-items: stretch;
}

.round-over--columns.round-over--landscape .round-over__buttons {
    width: auto;
}

/* With a mouse the key that presses NEXT MATCH sits on its top edge (as X on CLAIM x2 and the menu's keys, top left),
   in place of the OR PRESS SPACE line under it: inside the button it crowded the label. */
.round-over--columns.round-over--desktop .round-over__next-key {
    display: flex;
    position: absolute;
    top: -30px;
    left: 30px;
    margin: 0;
    padding: 0 18px 2px 18px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 14px;
}

.round-over--columns.round-over--desktop .round-over__next-key .key__text { font-size: 34px; }

.round-over--columns.round-over--landscape .round-over__hint { display: none; }

/* The column's CLAIM x2 is too narrow for its X key in the row: the key sits on its top edge, as the AD tag does. */
.round-over--columns.round-over--landscape .double__key {
    position: absolute;
    top: -26px;
    left: 26px;
    margin: 0;
}

.round-over--columns.round-over--landscape .round-over__buttons .round-over__button {
    flex-grow: 1;
    width: auto;
    margin-left: 30px;
}

/* The daily gift over a visit's first result (ResultDaily): the still empty cards wait out of sight under it. */
.round-over--gift .level-card,
.round-over--gift .missions {
    opacity: 0;
}

/* ---- A round in teams (HudTeams, the lobby's teams, the result's team table) ---- */

/* The team score under the bar: BLUE N : M RED, the player's team at the left with YOU under its name. */
.team-score {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.2s, 0.3s;
    transition-timing-function: linear, ease-out-back;
}

.team-score--shown {
    opacity: 1;
    scale: 1 1;
}

.team-score__bar {
    flex-direction: row;
    align-items: center;
    height: 104px;
    padding: 0 8px;
    border-width: 6px 6px 12px 6px;
    border-color: var(--navy);
    border-radius: 52px;
    background-color: var(--white);
}

.team-score__side {
    flex-direction: row;
    align-items: center;
    height: 78px;
    padding: 0 22px;
    border-radius: 39px;
}

.team-score__side--blue { background-color: var(--car-blue); }
.team-score__side--red { background-color: var(--car-red); }

.team-score__name-text {
    margin: 0;
    padding: 0;
    font-size: 34px;
    color: var(--white);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: var(--navy);
}

.team-score__name-text.stroke__drop { translate: 0 4px; display: flex; }

.team-score__number {
    min-width: 64px;
    margin: 0 10px;
    align-items: center;
}

.team-score__number-text {
    margin: 0;
    padding: 0;
    font-size: 64px;
    color: var(--white);
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: var(--navy);
    -unity-text-align: middle-center;
}

.team-score__number-text.stroke__drop { translate: 0 7px; display: flex; }

/* The team ahead: its number gold. */
.team-score__side--lead .team-score__number-text.stroke__face { color: var(--gold); }

.team-score__colon { margin: 0 10px; }

.team-score__colon-text {
    margin: 0;
    padding: 0;
    font-size: 56px;
    color: var(--navy);
    -unity-text-outline-width: 0;
}

/* YOU under the player's team, on a small navy tab over the bar's lower edge. */
.team-score__you {
    position: absolute;
    left: 50%;
    bottom: -40px;
    translate: -50% 0;
    margin: 0;
    padding: 2px 14px 4px 14px;
    border-radius: 16px;
    background-color: var(--navy);
    font-size: 24px;
    color: var(--white);
    -unity-text-align: middle-center;
}

/* The +N of a point, springing up under its side and flying into the number. */
.team-score__point {
    position: absolute;
    top: 120px;
    translate: -50% 0;
    padding: 4px 26px 8px 26px;
    border-width: 6px 6px 12px 6px;
    border-color: var(--navy);
    border-radius: 36px;
}

.team-score__point--blue { background-color: var(--car-blue); }
.team-score__point--red { background-color: var(--car-red); }

.team-score__point-text {
    margin: 0;
    padding: 0;
    font-size: 58px;
    color: var(--white);
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: var(--navy);
}

.team-score__point-text.stroke__drop { translate: 0 7px; display: flex; }

/* The name tags: a teammate's on a blue pill with a shield before its level, an enemy's on a red one. */
.car-name--ally .car-name__sticker { background-color: rgba(52, 78, 170, 0.86); }
.car-name--ally .car-name__tail { color: rgba(52, 78, 170, 0.86); }
.car-name--enemy .car-name__sticker { background-color: rgba(176, 52, 40, 0.86); }
.car-name--enemy .car-name__tail { color: rgba(176, 52, 40, 0.86); }

.car-name__ally {
    flex-shrink: 0;
    width: 38px;
    height: 44px;
    margin-right: 8px;
}

/* The lobby: a header pill for each team, its seats edged in its colour. */
.lobby__team {
    flex-direction: row;
    align-self: flex-start;
    height: 64px;
    margin: 6px 0 10px 18px;
    padding: 0 30px;
    align-items: center;
    border-width: 5px 5px 10px 5px;
    border-color: var(--navy);
    border-radius: 32px;
}

.lobby__team--blue { background-color: var(--car-blue); }
.lobby__team--red { background-color: var(--car-red); }

.lobby__team-name .sticker-text__text {
    font-size: 36px;
    color: var(--white);
}

/* A seat is tinted its team's colour (its outline stays navy: PillShape draws a sticker's outline in one colour); the
   player's stays pale gold. */
.lobby__row--blue { background-color: rgb(218, 230, 255); }
.lobby__row--red { background-color: rgb(255, 224, 218); }
.lobby__row--you.lobby__row--blue, .lobby__row--you.lobby__row--red { background-color: rgb(255, 236, 168); }

/* The result's team table: a header per team with its points, the team's cars under it, its best with MVP. */
.results__team {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin-top: 8px;
    padding: 0 26px 0 22px;
    border-width: 5px 5px 10px 5px;
    border-color: var(--navy);
    border-radius: 32px;
}

.results__team--blue { background-color: var(--car-blue); }
.results__team--red { background-color: var(--car-red); }

.results__team-name {
    flex-grow: 1;
    align-items: flex-start;
}

.results__team-name-text {
    margin: 0;
    padding: 0;
    font-size: 34px;
    -unity-text-outline-width: 5px;
    /* The stroke grows to push the points right: its layers, as wide as it, keep the name at its left. */
    -unity-text-align: middle-left;
}

.results__team-name-text.stroke__drop { translate: 0 3px; display: flex; }

.results__team-tag {
    margin: 0 14px 0 0;
    padding: 2px 14px 4px 14px;
    border-radius: 16px;
    background-color: var(--gold);
    font-size: 24px;
    color: var(--navy);
}

.results__team-points-text {
    margin: 0;
    padding: 0;
    font-size: 44px;
    -unity-text-outline-width: 6px;
}

.results__team-points-text.stroke__drop { translate: 0 4px; display: flex; }

.results__rank--blue { background-color: var(--car-blue); }
.results__rank--red { background-color: var(--car-red); }
.results__rank--blue .results__rank-text,
.results__rank--red .results__rank-text { color: var(--white); }

.results__mvp {
    flex-shrink: 0;
    margin: 0 12px 0 8px;
    padding: 2px 12px 4px 12px;
    border-width: 3px;
    border-color: var(--navy);
    border-radius: 14px;
    background-color: var(--gold);
    font-size: 22px;
    color: var(--navy);
}

/* On a phone held upright the team table is compact and starts under the subtitle (centred, it would cover it): low
   rows, so the two headers, each team's best car and the player fit over the cards. */
.results--teams { align-self: flex-start; padding-top: 8px; padding-bottom: 12px; }
.results--teams .results__row { height: 50px; margin-top: 4px; }
.results--teams .results__header { display: none; }
.results--teams .results__rank { width: 42px; height: 42px; }
.results--teams .results__name, .results--teams .results__ko { font-size: 32px; }
.results--teams .results__team-name-text { font-size: 30px; -unity-text-outline-width: 4px; }
.results--teams .results__team-points-text { font-size: 38px; -unity-text-outline-width: 5px; }
.results--teams .results__team-tag { font-size: 20px; }
.results--wide.results--teams { align-self: center; padding-top: 12px; padding-bottom: 18px; }
.results--wide.results--teams .results__row { height: 80px; margin-top: 6px; }
.results--wide.results--teams .results__rank { width: 62px; height: 62px; }
.results--wide.results--teams .results__name, .results--wide.results--teams .results__ko { font-size: 44px; }
.results--wide.results--teams .results__team-tag { font-size: 24px; }
.results--wide .results__team { height: 76px; margin-top: 12px; border-radius: 38px; }
.results--wide.results--teams .results__header { display: flex; }
.results--wide .results__team-name-text { font-size: 40px; -unity-text-outline-width: 5px; }
.results--wide .results__team-points-text { font-size: 52px; -unity-text-outline-width: 6px; }
.results--wide .results__mvp { font-size: 28px; }

/* After the sizes above, which set the outline on all three layers of a team's name and points: its face has none
   (.stroke > .stroke__face), or the outline, centred on the letters' edge, eats them and leaves them hollow. */
.stroke > Label.results__team-name-text.stroke__face,
.stroke > Label.results__team-points-text.stroke__face { -unity-text-outline-width: 0; }
