/* Sizes are in reference pixels of a 1080x1920 portrait screen (the panel scales with the screen, expanding on the
   other axis, so a landscape screen is as tall as the portrait one and wider). They are the numbers of the Claude
   Design canvas "Toy Car Arena UI", whose stage is drawn in these same pixels. Colours are the palette in ui_theme
   (var(--navy) and the rest).

   The shared vocabulary, as in SMUP:
   - screen: a full-screen layer, white text over the game; screen--dimmed puts the navy dim under it.
   - card: the white rounded sticker the result sits on, navy text. inset: a flat soft panel inside a card. rule: a
     soft line across a card.
   - pill: a white sticker pill, navy text.
   - display: outlined title text. stroke: outlined text with the outline outside the letters, as the design draws
     it: the text twice, the second label (stroke__face) without outline and drop over the first.
   - caption: small muted spaced-out text.
   - watch: the stopwatch icon, built from elements so the build carries no image for it.
   - button: a sticker button; button--green is the one to press, button--big the tall one. Its first child is always
     button__face, the coloured face over the darker band along its bottom; button__label is its text over the face.
   - key: a keyboard key cap (the SPACE hint).
   - pip: a little car seen from above, wheels and all (the PUSHED OFF BY badge); its pip__body takes the colour.
   - ko-star: the knock-out star, eight gold points in a navy outline (two squares, one turned, over two bigger navy
     ones); ko-star--big is the one on the KNOCKOUT! sticker.
   - best: a small chip with the player's best (BEST #2); best--new is the gold NEW BEST! sticker.
   - car-color--N: the body colour of car N of the round (0 the player, 1..N the bots), as CarLook paints it.

   A sticker's hard drop is a thicker navy bottom border: 9 px of outline and the drop under it (20 in all on pills,
   25 on cards). That border would squash the bottom corners of the fill inside it, so PillShape redraws such an
   element with them round, and gives an element with border-radius: 999px round ends (UI Toolkit would draw an
   ellipse). UI Toolkit draws no box-shadow, gap or gradient: spacing between siblings is their margins. */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    color: var(--white);
}

.screen--dimmed {
    background-color: rgba(29, 43, 79, 0.6);
}

.card {
    align-items: center;
    width: 981px;
    padding: 46px 50px 50px 50px;
    border-width: 9px;
    border-bottom-width: 25px;
    border-color: var(--navy);
    border-radius: 58px;
    background-color: var(--white);
    color: var(--navy);
}

.inset {
    flex-direction: row;
    align-self: stretch;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px 24px 30px;
    border-radius: 40px;
    background-color: var(--soft);
}

.rule {
    flex-shrink: 0;
    align-self: stretch;
    height: 7px;
    margin: 40px 0;
    border-radius: 4px;
    background-color: var(--soft);
}

.pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    color: var(--navy);
}

.display {
    color: var(--white);
    -unity-text-outline-width: 18px;
    -unity-text-outline-color: var(--navy);
    text-shadow: 0 18px 0 rgb(29, 43, 79);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.caption {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 3px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The stopwatch: a gold dial in a navy ring, the knob on top of the ring and the hand pointing up. */
.watch {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    margin-top: 12px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 32px;
    background-color: var(--gold);
}

.watch__knob {
    position: absolute;
    left: 14px;
    top: -22px;
    width: 20px;
    height: 14px;
    border-radius: 4px;
    background-color: var(--navy);
}

.watch__hand {
    position: absolute;
    left: 20px;
    top: 5px;
    width: 8px;
    height: 22px;
    border-radius: 4px;
    background-color: var(--navy);
}

/* The sticker button. Its height comes from its padding and content, never height or min-height. Every view drops the
   theme's unity-button class (Button.ussClassName), so this styles alone. The face covers the button but the bottom
   16 px, which show the button's own colour as the darker band; the label comes after it, so it draws over it. A
   button's text goes in a button__label, never in its text attribute, which the face would cover. Pressed, it sinks
   onto its drop and keeps its layout: its border and fill go transparent and PillShape draws it without the drop. */
.button {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-width: 504px;
    margin: 0;
    padding: 19px 50px 35px 50px;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 50px;
    background-color: var(--shade);
    background-image: none;
    color: var(--navy);
    font-size: 63px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.button__face {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 16px;
    border-radius: 41px;
    background-color: var(--white);
}

.button:hover > .button__face,
.button:focus > .button__face {
    background-color: var(--soft);
}

.button:active {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    translate: 0 11px;
}

.button__label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The one to press. White label with a navy stroke. */
.button--green {
    background-color: var(--green-shade);
}

.button--green > .button__face {
    background-color: var(--green);
}

.button--green:hover > .button__face,
.button--green:focus > .button__face {
    background-color: var(--green-hover);
}

.button--green .button__label {
    color: var(--white);
    -unity-text-outline-width: 16px;
    -unity-text-outline-color: var(--navy);
}

/* The tall button at the bottom of the result screen. */
.button--big {
    padding: 24px 50px 46px 50px;
    border-width: 11px;
    border-bottom-width: 27px;
    border-radius: 68px;
}

.button--big > .button__face {
    bottom: 23px;
    border-radius: 57px;
}

.button--big .button__label {
    font-size: 104px;
}

.button--big:active {
    translate: 0 16px;
}

.key {
    margin-left: 20px;
    padding: 0 26px 4px 26px;
    border-width: 7px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 18px;
    background-color: var(--white);
}

.key__text {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 2px;
    color: var(--navy);
    -unity-text-align: middle-center;
}

.ko-star {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
}

.ko-star__back,
.ko-star__front {
    position: absolute;
}

.ko-star__back {
    left: 8px;
    top: 8px;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    background-color: var(--navy);
}

.ko-star__front {
    left: 15px;
    top: 15px;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background-color: var(--gold);
}

.ko-star__turned {
    rotate: 45deg;
}

.ko-star--big {
    width: 124px;
    height: 124px;
}

.ko-star--big > .ko-star__back {
    left: 18px;
    top: 18px;
    width: 88px;
    height: 88px;
    border-radius: 12px;
}

.ko-star--big > .ko-star__front {
    left: 33px;
    top: 33px;
    width: 58px;
    height: 58px;
    border-radius: 8px;
}

/* Hidden until the view gives it best--shown. NEW BEST! springs in after the card (round-over--enter). */
.best {
    display: none;
    margin: 0;
    padding: 4px 22px 8px 22px;
    border-radius: 999px;
    background-color: var(--soft);
    font-size: 36px;
    letter-spacing: 2px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    transition-delay: 0.35s;
}

.best--shown {
    display: flex;
}

.best--new {
    border-width: 6px;
    border-color: var(--navy);
    background-color: var(--gold);
    color: var(--navy);
    rotate: -4deg;
}

/* The opaque cover while the arena scene loads. It takes every click and touch, so nothing under it is pressed. */
.curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--navy);
}

/* The HUD: the stopwatch pill at the top centre, 54 px from the edge, and under it the pill with a chip per car still
   in the round. On a wide screen it stays in the middle, over the arena. */
.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding-top: 54px;
}

.hud__timer {
    height: 136px;
    min-width: 320px;
    padding: 0 46px 0 24px;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* The time, wide enough for any m:ss so the pill does not change width every second. */
.hud__time {
    min-width: 150px;
    margin-left: 18px;
}

.hud__time-text {
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 88px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The last seconds: the pill turns red, the time white with a navy stroke, the dial white, and the pill beats once a
   second (HudView sets hud__timer--beat for a moment). */
.hud__timer--urgent {
    background-color: var(--red);
}

.hud__timer--urgent .watch {
    background-color: var(--white);
}

.hud__timer--urgent .hud__time-text {
    color: var(--white);
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
}

.hud__timer--beat {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

/* The cars left: a white pill, lower than the time's so it does not compete with it, with a stack of overlapping round
   chips, one per car still in (HudView builds them), each in the car's colour (car-color) with a little white car seen
   from above in it, and the count and LEFT after them. The bots come first and the player's chip last, in front on the
   right, with the white ring of its marker on the arena inside its outline. The pill pops when a car goes out
   (hud__cars--pop) and the count punches (hud__cars-count--punch). */
.hud__cars {
    height: 116px;
    margin-top: 24px;
    padding: 0 38px 0 14px;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__cars--pop {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

/* Every chip overlaps the one before it by 30 px; the row's padding gives the first one's overlap back. */
.hud__chips {
    flex-direction: row;
    align-items: center;
    padding-left: 30px;
}

/* A chip's place in the stack. The chip itself is laid over it, so when a car goes out its place narrows to nothing
   (hud__chip-slot--closing: what is left is the overlap) and the chips after it slide over, while the chip keeps its
   round shape. */
.hud__chip-slot {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    margin-left: -30px;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__chip-slot--closing {
    width: 30px;
}

/* Leaving, the chip hops up from the stack spinning (hud__chip--hop), then falls as it shrinks to nothing
   (hud__chip--fall), as the effects on the arena vanish: 0.4 s in all (HudView times the two). */
.hud__chip {
    position: absolute;
    left: 0;
    top: 0;
    width: 80px;
    height: 80px;
    align-items: center;
    justify-content: center;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 40px;
    transition-property: translate, rotate, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud__chip--hop {
    translate: 0 -60px;
    rotate: 100deg;
    scale: 0.9 0.9;
}

.hud__chip--fall {
    translate: 0 10px;
    rotate: 200deg;
    scale: 0 0;
    transition-duration: 0.25s;
    transition-timing-function: ease-in;
}

/* The player's chip: a white ring just inside its navy outline. */
.hud__chip-ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 6px;
    border-color: var(--white);
    border-radius: 33px;
}

.hud__chip-car {
    width: 24px;
    height: 36px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 8px;
    background-color: var(--white);
}

.hud__chip-glass {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 4px;
    height: 7px;
    border-radius: 2px;
    background-color: var(--navy);
}

.hud__cars-count {
    margin: 0 0 0 18px;
    padding: 0 0 6px 0;
    font-size: 72px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__cars-count--punch {
    scale: 1.3 1.3;
    transition-duration: 0.05s;
}

.hud__cars-text {
    margin: 0 0 0 10px;
    padding: 0 0 2px 0;
    font-size: 44px;
    letter-spacing: 1px;
    color: var(--navy);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* The little car of the PUSHED OFF BY badge: four wheels under a body with a windscreen. */
.pip {
    flex-shrink: 0;
    width: 52px;
    height: 68px;
}

.pip__wheel {
    position: absolute;
    width: 12px;
    height: 20px;
    border-radius: 4px;
    background-color: var(--navy);
}

.pip__wheel--front-left {
    left: 0;
    top: 8px;
}

.pip__wheel--front-right {
    right: 0;
    top: 8px;
}

.pip__wheel--back-left {
    left: 0;
    bottom: 8px;
}

.pip__wheel--back-right {
    right: 0;
    bottom: 8px;
}

.pip__body {
    position: absolute;
    left: 6px;
    top: 0;
    width: 40px;
    height: 68px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 13px;
    background-color: var(--white);
}

.pip__glass {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 10px;
    height: 12px;
    border-radius: 3px;
    background-color: var(--navy);
}

/* The player's knock-outs: a small white pill with the star under the cars pill, there from the first knock-out on
   (HudView sets hud__ko--shown), popping at each one. */
.hud__ko {
    display: none;
    height: 108px;
    margin-top: 20px;
    padding: 0 36px 0 24px;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__ko--shown {
    display: flex;
}

.hud__ko--pop {
    scale: 1.25 1.25;
    transition-duration: 0.05s;
}

.hud__ko-text {
    margin: 0 0 0 14px;
    padding: 0 0 6px 0;
    font-size: 60px;
    color: var(--navy);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* KNOCKOUT! when the player knocks a car out (HudView builds one per knock-out and places it over where the car went
   over the edge): the star and the word on a tilted sticker that springs in from small (ko-pop--start, taken off once
   it is laid out), holds, and flies up as it fades (ko-pop--leave). The outer ko-pop is centred on its point. */
.hud__popups {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ko-pop {
    position: absolute;
    translate: -50% -50%;
}

.ko-pop__sticker {
    flex-direction: row;
    align-items: center;
    transition-property: scale, translate, opacity;
    transition-duration: 0.3s, 0.3s, 0.12s;
    transition-timing-function: ease-out-back, ease-out, linear;
}

.ko-pop--start .ko-pop__sticker {
    scale: 0.2 0.2;
    opacity: 0;
}

.ko-pop--leave .ko-pop__sticker {
    scale: 1.15 1.15;
    translate: 0 -160px;
    opacity: 0;
    transition-duration: 0.35s;
    transition-timing-function: ease-in;
}

.ko-pop__text {
    margin: 0 0 0 16px;
    padding: 0;
    font-size: 120px;
    color: var(--gold);
}

/* The boost button, on a touch screen only (HudView shows it once the screen is one): a round white sticker at the
   bottom right, under the right thumb, while the left one steers. The charge is an orange disc in it that grows from
   the middle as the boost cools down (HudView scales it); once it fills the button, the button turns orange, its label
   white with a navy stroke, and it pops (hud__boost--pop for a moment). Pressed, it sinks onto its drop. */
.hud__boost {
    display: none;
    position: absolute;
    right: 64px;
    bottom: 96px;
    width: 300px;
    height: 300px;
    align-items: center;
    justify-content: center;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    opacity: 0.85;
    transition-property: scale, translate, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud__boost--shown {
    display: flex;
}

/* Centred in the button's fill, which the thicker bottom border makes 282 x 271. */
.hud__boost-charge {
    position: absolute;
    left: 23px;
    top: 17px;
    width: 236px;
    height: 236px;
    border-radius: 118px;
    background-color: var(--orange);
}

.hud__boost-text {
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 72px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__boost--ready {
    background-color: var(--orange);
    opacity: 1;
}

.hud__boost--ready .hud__boost-text {
    color: var(--white);
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
}

.hud__boost--pop {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

.hud__boost--pressed {
    translate: 0 11px;
    transition-duration: 0.05s;
}

/* The round's result: the title near the top, tilted over the dimmed arena, a line under it, the card with the place
   and the time on the arena, and PLAY AGAIN at the bottom with the free height between them. Only the top spacer gives
   way when a screen is too short. While round-over--enter is on (RoundOverView takes it off once the screen shows),
   the title is small, the card low and the button lower, so they spring into place. */
.round-over {
    justify-content: flex-start;
}

.round-over__spacer-top {
    flex-shrink: 1;
    height: 300px;
    min-height: 120px;
}

.round-over__title {
    flex-shrink: 0;
    rotate: -3deg;
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.round-over__title-text {
    margin: 0;
    padding: 0;
    font-size: 171px;
}

.round-over__title--won {
    color: var(--gold);
}

/* KNOCKED OUT is the long one: at the full size its outline would touch the sides of a portrait screen. */
.round-over__title--out {
    font-size: 148px;
    color: var(--red);
}

/* Confetti round YOU WIN! (pieces placed in RoundOver.uxml from the title's top left corner), shown on a win only. */
.round-over__confetti {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.round-over__confetti--shown {
    display: flex;
}

.confetti {
    position: absolute;
    width: 24px;
    height: 46px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 6px;
    transition-property: scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
    transition-delay: 0.15s;
}

.round-over__subtitle {
    flex-shrink: 0;
    margin: 34px 0 0 0;
    padding: 0;
    font-size: 52px;
    letter-spacing: 2px;
    color: var(--white);
    text-shadow: 0 6px 0 rgb(29, 43, 79);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* After a fall with a car to blame, the subtitle is PUSHED OFF BY and that car in its colour on a white badge. */
.round-over__by {
    display: none;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 26px;
}

.round-over__by--shown {
    display: flex;
}

.round-over__by-text {
    margin: 0;
}

.round-over__by-badge {
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    margin-left: 22px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 52px;
    background-color: var(--white);
    rotate: 10deg;
}

.round-over__card {
    flex-shrink: 0;
    margin-top: 64px;
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-delay: 0.05s;
}

.round-over__place {
    align-self: stretch;
    align-items: center;
}

/* The place on a flat tilted pill: gold, silver or bronze on the podium, soft past it (RoundOverView). */
.round-over__place-pill {
    margin-top: 22px;
    padding: 0 56px 10px 56px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--soft);
    rotate: -2deg;
}

.round-over__place-pill--gold {
    background-color: var(--gold);
}

.round-over__place-pill--silver {
    background-color: var(--silver);
}

.round-over__place-pill--bronze {
    background-color: var(--bronze);
}

.round-over__place-value {
    margin: 0;
    padding: 0;
    font-size: 130px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* OF N CARS, and the best place beside it. */
.round-over__of {
    flex-direction: row;
    align-items: center;
    margin-top: 26px;
}

.round-over__place-best {
    margin-left: 24px;
}

.round-over__time-label {
    flex-direction: row;
    align-items: center;
}

.round-over__time-caption {
    margin-left: 26px;
}

/* The time on the arena and the knock-outs, right in their insets. */
.round-over__value {
    margin: 0;
    padding: 0;
    font-size: 72px;
    color: var(--navy);
    -unity-text-align: middle-right;
    white-space: nowrap;
}

/* The knock-outs, in an inset like the time's: the star, KNOCKOUTS, and the count with the best beside it. */
.round-over__ko {
    margin-top: 20px;
}

.round-over__ko-score {
    flex-direction: row;
    align-items: center;
}

.round-over__ko-best {
    margin-right: 24px;
}

.round-over__spacer {
    flex-grow: 1;
    flex-shrink: 0;
    min-height: 45px;
}

/* PLAY AGAIN and, where there is a keyboard, the key that presses it. The entrance moves this wrapper, not the
   button, whose own translate is its press. */
.round-over__actions {
    flex-shrink: 0;
    align-items: center;
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-delay: 0.12s;
}

.round-over__button {
    width: 981px;
}

.round-over__hint {
    flex-direction: row;
    align-items: center;
    margin-top: 36px;
}

.round-over__hint-text {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 3px;
    color: var(--white);
    text-shadow: 0 5px 0 rgb(29, 43, 79);
}

.round-over__spacer-bottom {
    flex-shrink: 0;
    height: 70px;
}

.round-over--enter .round-over__title {
    scale: 0.4 0.4;
    opacity: 0;
}

.round-over--enter .confetti {
    scale: 0 0;
}

.round-over--enter .round-over__card {
    translate: 0 120px;
    opacity: 0;
}

.round-over--enter .best--new {
    scale: 0 0;
}

.round-over--enter .round-over__actions {
    translate: 0 240px;
    opacity: 0;
}

/* The car colours (CarColor in Scripts/UI picks the class), late in the file so they win over the white of a pip__body
   they are put on. */
.car-color--0 {
    background-color: var(--car-green);
}

.car-color--1 {
    background-color: var(--car-red);
}

.car-color--2 {
    background-color: var(--car-blue);
}

.car-color--3 {
    background-color: var(--car-yellow);
}

.car-color--4 {
    background-color: var(--car-purple);
}

.car-color--5 {
    background-color: var(--car-orange);
}

.car-color--6 {
    background-color: var(--car-pink);
}

.car-color--7 {
    background-color: var(--car-dark);
}

/* Last, so the face of a stroke wins over every rule above that gives its text an outline or a drop: the outline is
   centred on the letters' edge, so the face over it keeps the letters their full width. */
.stroke > .stroke__face {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}
