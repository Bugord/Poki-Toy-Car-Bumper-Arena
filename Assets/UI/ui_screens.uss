/* Sizes are in reference pixels of a 1080x1920 portrait screen (the panel scales with the screen, expanding on the
   other axis, so a landscape screen is as tall as the portrait one and wider). They are the numbers of the Claude
   Design canvas "Toy Car Arena UI", whose stage is drawn in these same pixels. Colours are the palette in ui_theme
   (var(--navy) and the rest).

   The shared vocabulary, as in SMUP:
   - screen: a full-screen layer, white text over the game; screen--dimmed puts the navy dim under it.
   - card: the white rounded sticker the result sits on, navy text. inset: a flat soft panel inside a card. rule: a
     soft line across a card.
   - pill: a white sticker pill, navy text.
   - display: outlined title text. stroke: outlined text with the outline outside the letters, as the design draws
     it: the text twice, the second label (stroke__face) without outline and drop over the first.
   - caption: small muted spaced-out text.
   - watch: the stopwatch icon, built from elements so the build carries no image for it.
   - button: a sticker button; button--green is the one to press, button--big the tall one. Its first child is always
     button__face, the coloured face over the darker band along its bottom; button__label is its text over the face.
   - key: a keyboard key cap (the SPACE hint).
   - pip: a little car seen from above, wheels and all (the PUSHED OFF BY badge); its pip__body takes the colour.
   - ko-star: the knock-out star, eight gold points in a navy outline (two squares, one turned, over two bigger navy
     ones); ko-star--big is the one on the KNOCKOUT! sticker.
   - best: a small chip with the player's best (BEST #2); best--new is the gold NEW BEST! sticker.
   - car-color--N: the body colour of car N of the round (0 the player, 1..N the bots), as CarLook paints it.

   A sticker's hard drop is a thicker navy bottom border: 9 px of outline and the drop under it (20 in all on pills,
   25 on cards). That border would squash the bottom corners of the fill inside it, so PillShape redraws such an
   element with them round, and gives an element with border-radius: 999px round ends (UI Toolkit would draw an
   ellipse). UI Toolkit draws no box-shadow, gap or gradient: spacing between siblings is their margins. */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    color: var(--white);
}

.screen--dimmed {
    background-color: rgba(29, 43, 79, 0.6);
}

.card {
    align-items: center;
    width: 981px;
    padding: 46px 50px 50px 50px;
    border-width: 9px;
    border-bottom-width: 25px;
    border-color: var(--navy);
    border-radius: 58px;
    background-color: var(--white);
    color: var(--navy);
}

.inset {
    flex-direction: row;
    align-self: stretch;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px 24px 30px;
    border-radius: 40px;
    background-color: var(--soft);
}

.rule {
    flex-shrink: 0;
    align-self: stretch;
    height: 7px;
    margin: 40px 0;
    border-radius: 4px;
    background-color: var(--soft);
}

.pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    color: var(--navy);
}

.display {
    color: var(--white);
    -unity-text-outline-width: 18px;
    -unity-text-outline-color: var(--navy);
    text-shadow: 0 18px 0 rgb(29, 43, 79);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.caption {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 3px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The stopwatch: a gold dial in a navy ring, the knob on top of the ring and the hand pointing up. */
.watch {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    margin-top: 12px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 32px;
    background-color: var(--gold);
}

.watch__knob {
    position: absolute;
    left: 14px;
    top: -22px;
    width: 20px;
    height: 14px;
    border-radius: 4px;
    background-color: var(--navy);
}

.watch__hand {
    position: absolute;
    left: 20px;
    top: 5px;
    width: 8px;
    height: 22px;
    border-radius: 4px;
    background-color: var(--navy);
}

/* The sticker button. Its height comes from its padding and content, never height or min-height. Every view drops the
   theme's unity-button class (Button.ussClassName), so this styles alone. The face covers the button but the bottom
   16 px, which show the button's own colour as the darker band; the label comes after it, so it draws over it. A
   button's text goes in a button__label, never in its text attribute, which the face would cover. Pressed, it sinks
   onto its drop and keeps its layout: its border and fill go transparent and PillShape draws it without the drop. */
.button {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-width: 504px;
    margin: 0;
    padding: 19px 50px 35px 50px;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 50px;
    background-color: var(--shade);
    background-image: none;
    color: var(--navy);
    font-size: 63px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.button__face {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 16px;
    border-radius: 41px;
    background-color: var(--white);
}

.button:hover > .button__face,
.button:focus > .button__face {
    background-color: var(--soft);
}

.button:active {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    translate: 0 11px;
}

.button__label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The one to press. White label with a navy stroke. */
.button--green {
    background-color: var(--green-shade);
}

.button--green > .button__face {
    background-color: var(--green);
}

.button--green:hover > .button__face,
.button--green:focus > .button__face {
    background-color: var(--green-hover);
}

.button--green .button__label {
    color: var(--white);
    -unity-text-outline-width: 16px;
    -unity-text-outline-color: var(--navy);
}

/* The tall button at the bottom of the result screen. */
.button--big {
    padding: 24px 50px 46px 50px;
    border-width: 11px;
    border-bottom-width: 27px;
    border-radius: 68px;
}

.button--big > .button__face {
    bottom: 23px;
    border-radius: 57px;
}

.button--big .button__label {
    font-size: 104px;
}

.button--big:active {
    translate: 0 16px;
}

.key {
    margin-left: 20px;
    padding: 0 26px 4px 26px;
    border-width: 7px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 18px;
    background-color: var(--white);
}

.key__text {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 2px;
    color: var(--navy);
    -unity-text-align: middle-center;
}

.ko-star {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
}

.ko-star__back,
.ko-star__front {
    position: absolute;
}

.ko-star__back {
    left: 8px;
    top: 8px;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    background-color: var(--navy);
}

.ko-star__front {
    left: 15px;
    top: 15px;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background-color: var(--gold);
}

.ko-star__turned {
    rotate: 45deg;
}

.ko-star--big {
    width: 124px;
    height: 124px;
}

.ko-star--big > .ko-star__back {
    left: 18px;
    top: 18px;
    width: 88px;
    height: 88px;
    border-radius: 12px;
}

.ko-star--big > .ko-star__front {
    left: 33px;
    top: 33px;
    width: 58px;
    height: 58px;
    border-radius: 8px;
}

/* Hidden until the view gives it best--shown. NEW BEST! springs in after the card (round-over--enter). */
.best {
    display: none;
    margin: 0;
    padding: 4px 22px 8px 22px;
    border-radius: 999px;
    background-color: var(--soft);
    font-size: 36px;
    letter-spacing: 2px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    transition-delay: 0.35s;
}

.best--shown {
    display: flex;
}

.best--new {
    border-width: 6px;
    border-color: var(--navy);
    background-color: var(--gold);
    color: var(--navy);
    rotate: -4deg;
}

/* The opaque cover while the arena scene loads. It takes every click and touch, so nothing under it is pressed. */
.curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--navy);
}

/* Lobby uses the same reference height in portrait and landscape (PanelSettings Expand). The seven seats fit in
   one centred column; departed seats outside a smaller next round collapse out of that column. */
.lobby {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 60px 40px;
}

.lobby__title {
    margin: 0 0 48px 0;
    padding: 0;
    font-size: 78px;
    color: var(--gold);
    -unity-text-outline-width: 10px;
    text-shadow: 0 10px 0 rgb(29, 43, 79);
}

.lobby__title--ready { color: var(--green); }

/* The arena of the coming round, a compact pill between the title and the seven seats (about 150 px with its margins). */
.lobby__arena {
    flex-direction: row;
    align-items: center;
    height: 96px;
    margin: -20px 0 36px 0;
    padding: 0 30px;
    border-width: 6px;
    border-bottom-width: 12px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}
.lobby__arena-label { height: 52px; margin-right: 16px; }
.lobby__arena-label .sticker-text__text {
    font-size: 36px;
    color: var(--muted);
    -unity-text-outline-width: 0;
}
.lobby__arena-name { height: 66px; }
.lobby__arena-name .sticker-text__text {
    font-size: 54px;
    color: var(--navy);
    -unity-text-outline-width: 0;
}
.lobby__arena .lobby__badge {
    width: 100px;
    height: 62px;
    margin-left: 18px;
}
.lobby__arena .lobby__badge .sticker-text__text { font-size: 30px; }

.lobby__rows {
    width: 920px;
    max-width: 100%;
}

.lobby__slot {
    flex-shrink: 0;
    height: 130px;
    margin-bottom: 12px;
}

.lobby__row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 130px;
    flex-direction: row;
    align-items: center;
    padding: 10px 24px;
    border-width: 7px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 42px;
    background-color: var(--white);
}

.lobby__row .hud__chip {
    position: relative;
    flex-shrink: 0;
    margin-right: 22px;
    transition-duration: 0s;
}

.lobby__name {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: 54px;
    color: var(--navy);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.lobby__name--revenge, .lobby__name--revenge > .stroke__face { color: var(--red); }

.lobby__row .revenge-target {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    margin-left: 12px;
    margin-right: 12px;
}

.lobby__badge {
    flex-shrink: 0;
    width: 122px;
    margin: 0 0 0 12px;
    padding: 8px 0;
    border-width: 5px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    border-radius: 22px;
    background-color: var(--gold);
    color: var(--navy);
    font-size: 36px;
    -unity-text-align: middle-center;
}

.lobby__row--left { background-color: var(--shade); }
.lobby__row--left .hud__chip { background-color: var(--muted); }
.lobby__row--left .lobby__name { color: var(--muted); }
.lobby__badge--left { background-color: var(--silver); }

.lobby__badge > .stroke__face {
    width: auto;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.lobby__title > .stroke__face { margin: 0; }

/* The HUD: the stopwatch pill at the top centre, 54 px from the edge, and under it the pill with a chip per car still
   in the round. On a wide screen it stays in the middle, over the arena. */
.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding-top: 54px;
}

.hud__timer {
    height: 136px;
    min-width: 320px;
    padding: 0 46px 0 24px;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* The time, wide enough for any m:ss so the pill does not change width every second. */
.hud__time {
    min-width: 150px;
    margin-left: 18px;
}

.hud__time-text {
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 88px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The last seconds: the pill turns red, the time white with a navy stroke, the dial white, and the pill beats once a
   second (HudView sets hud__timer--beat for a moment). */
.hud__timer--urgent {
    background-color: var(--red);
}

.hud__timer--urgent .watch {
    background-color: var(--white);
}

.hud__timer--urgent .hud__time-text {
    color: var(--white);
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
}

.hud__timer--beat {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

/* The cars left: a white pill, lower than the time's so it does not compete with it, with a stack of overlapping round
   chips, one per car still in (HudView builds them), each in the car's colour (car-color) with a little white car seen
   from above in it, and the count and LEFT after them. The bots come first and the player's chip last, in front on the
   right, with the white ring of its marker on the arena inside its outline. The pill pops when a car goes out
   (hud__cars--pop) and the count punches (hud__cars-count--punch). */
.hud__cars {
    height: 116px;
    margin-top: 24px;
    padding: 0 38px 0 14px;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__cars--pop {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

/* Every chip overlaps the one before it by 30 px; the row's padding gives the first one's overlap back. */
.hud__chips {
    flex-direction: row;
    align-items: center;
    padding-left: 30px;
}

/* A chip's place in the stack. The chip itself is laid over it, so when a car goes out its place narrows to nothing
   (hud__chip-slot--closing: what is left is the overlap) and the chips after it slide over, while the chip keeps its
   round shape. */
.hud__chip-slot {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    margin-left: -30px;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__chip-slot--closing {
    width: 30px;
}

/* Leaving, the chip hops up from the stack spinning (hud__chip--hop), then falls as it shrinks to nothing
   (hud__chip--fall), as the effects on the arena vanish: 0.4 s in all (HudView times the two). */
.hud__chip {
    position: absolute;
    left: 0;
    top: 0;
    width: 80px;
    height: 80px;
    align-items: center;
    justify-content: center;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 40px;
    transition-property: translate, rotate, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud__chip--hop {
    translate: 0 -60px;
    rotate: 100deg;
    scale: 0.9 0.9;
}

.hud__chip--fall {
    translate: 0 10px;
    rotate: 200deg;
    scale: 0 0;
    transition-duration: 0.25s;
    transition-timing-function: ease-in;
}

/* The player's chip: a white ring just inside its navy outline. */
.hud__chip-ring {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 6px;
    border-color: var(--white);
    border-radius: 33px;
}

.hud__chip--player > .hud__chip-ring { display: flex; }

.hud__chip-car {
    width: 24px;
    height: 36px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 8px;
    background-color: var(--white);
}

.hud__chip-glass {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 4px;
    height: 7px;
    border-radius: 2px;
    background-color: var(--navy);
}

.hud__cars-count {
    margin: 0 0 0 18px;
    padding: 0 0 6px 0;
    font-size: 72px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__cars-count--punch {
    scale: 1.3 1.3;
    transition-duration: 0.05s;
}

.hud__cars-text {
    margin: 0 0 0 10px;
    padding: 0 0 2px 0;
    font-size: 44px;
    letter-spacing: 1px;
    color: var(--navy);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* The little car of the PUSHED OFF BY badge: four wheels under a body with a windscreen. */
.pip {
    flex-shrink: 0;
    width: 52px;
    height: 68px;
}

.pip__wheel {
    position: absolute;
    width: 12px;
    height: 20px;
    border-radius: 4px;
    background-color: var(--navy);
}

.pip__wheel--front-left {
    left: 0;
    top: 8px;
}

.pip__wheel--front-right {
    right: 0;
    top: 8px;
}

.pip__wheel--back-left {
    left: 0;
    bottom: 8px;
}

.pip__wheel--back-right {
    right: 0;
    bottom: 8px;
}

.pip__body {
    position: absolute;
    left: 6px;
    top: 0;
    width: 40px;
    height: 68px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 13px;
    background-color: var(--white);
}

.pip__glass {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 10px;
    height: 12px;
    border-radius: 3px;
    background-color: var(--navy);
}

/* The player's knock-outs: a small white pill with the star under the cars pill, there from the first knock-out on
   (HudView sets hud__ko--shown), popping at each one. */
.hud__ko {
    display: none;
    height: 108px;
    margin-top: 20px;
    padding: 0 36px 0 24px;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.hud__ko--shown {
    display: flex;
}

.hud__ko--pop {
    scale: 1.25 1.25;
    transition-duration: 0.05s;
}

.hud__ko-text {
    margin: 0 0 0 14px;
    padding: 0 0 6px 0;
    font-size: 60px;
    color: var(--navy);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* KNOCKOUT! when the player knocks a car out (HudView builds one per knock-out and places it over where the car went
   over the edge): the star and the word on a tilted sticker that springs in from small (ko-pop--start, taken off once
   it is laid out), holds, and flies up as it fades (ko-pop--leave). The outer ko-pop is centred on its point. */
.hud__popups {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ko-pop {
    position: absolute;
    translate: -50% -50%;
}

.ko-pop__sticker {
    flex-direction: row;
    align-items: center;
    transition-property: scale, translate, opacity;
    transition-duration: 0.3s, 0.3s, 0.12s;
    transition-timing-function: ease-out-back, ease-out, linear;
}

.ko-pop--start .ko-pop__sticker {
    scale: 0.2 0.2;
    opacity: 0;
}

.ko-pop--leave .ko-pop__sticker {
    scale: 1.15 1.15;
    translate: 0 -160px;
    opacity: 0;
    transition-duration: 0.35s;
    transition-timing-function: ease-in;
}

.ko-pop__text {
    margin: 0 0 0 16px;
    padding: 0;
    font-size: 120px;
    color: var(--gold);
}

.ko-pop--revenge .ko-pop__text {
    color: var(--red);
}

.ko-pop--revenge .ko-star__front {
    background-color: var(--orange);
}

/* Visit handles follow the bots; the inner sticker animates independently of its projected anchor. */
.car-name {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
}

.car-name__sticker {
    align-items: center;
    border-radius: 24px;
    background-color: var(--name-backdrop);
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.car-name__text {
    margin: 0;
    padding: 0 14px 3px 14px;
    font-size: 44px;
    color: var(--white);
    -unity-text-outline-width: 6px;
    text-shadow: none;
}

.car-name__revenge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 2px 10px 0 10px;
}

.car-name__revenge-text {
    margin: 0;
    padding: 0;
    font-size: 32px;
    letter-spacing: 1px;
    color: var(--orange);
    -unity-text-outline-width: 5px;
    text-shadow: none;
}

.car-name--revenge .car-name__text {
    color: var(--red);
}

/* A tiny bullseye, built from concentric rings and a centre dot. */
.revenge-target {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-right: 8px;
    border-width: 4px;
    border-color: var(--orange);
    border-radius: 14px;
    background-color: var(--navy);
}

.revenge-target__center {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--red);
}

.car-name--enter .car-name__sticker {
    scale: 0.2 0.2;
    opacity: 0;
}

.car-name--pulse .car-name__sticker {
    scale: 1.15 1.15;
    transition-duration: 0.12s;
}

.car-name--leave .car-name__sticker {
    scale: 0 0;
    opacity: 0;
    transition-duration: 0.4s;
    transition-timing-function: ease-in;
}

/* The joystick under a steering finger (HudView places and sizes both parts from the driver's joystick): a pale
   see-through disc with a navy outline where the finger came down, and on it a white knob sticker with its navy drop
   under the finger. They spring in as the finger starts to steer and shrink away as it lets go. The layer covers the
   screen so both are placed in its pixels. */
.hud__stick {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__stick-base,
.hud__stick-knob {
    position: absolute;
    border-radius: 999px;
    border-color: var(--navy);
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.hud__stick-base {
    border-width: 8px;
    background-color: rgba(255, 255, 255, 0.3);
}

.hud__stick-knob {
    border-width: 8px;
    border-bottom-width: 16px;
    background-color: var(--white);
}

.hud__stick--shown .hud__stick-base {
    opacity: 0.8;
    scale: 1 1;
    transition-timing-function: ease-out-back;
}

.hud__stick--shown .hud__stick-knob {
    opacity: 1;
    scale: 1 1;
    transition-timing-function: ease-out-back;
}

/* The boost button, on a touch screen only (HudView shows it once the screen is one): a round white sticker at the
   bottom right by default, opposite each new steering touch. Its slot shrinks before switching sides so the ready
   pop and pressed motion can stay on the button itself. The charge is an orange disc in it that grows from
   the middle as the boost cools down (HudView scales it); once it fills the button, the button turns orange, its label
   white with a navy stroke, and it pops (hud__boost--pop for a moment). Pressed, it sinks onto its drop. */
.hud__boost-slot {
    position: absolute;
    right: 64px;
    bottom: 96px;
    width: 300px;
    height: 300px;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.hud__boost-slot--left {
    left: 64px;
    right: auto;
}

.hud__boost-slot--moving {
    scale: 0 0;
    opacity: 0;
}

.hud__boost {
    display: none;
    width: 300px;
    height: 300px;
    align-items: center;
    justify-content: center;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    opacity: 0.85;
    transition-property: scale, translate, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud__boost--shown {
    display: flex;
}

/* Centred in the button's fill, which the thicker bottom border makes 282 x 271. */
.hud__boost-charge {
    position: absolute;
    left: 23px;
    top: 17px;
    width: 236px;
    height: 236px;
    border-radius: 118px;
    background-color: var(--orange);
}

.hud__boost-text {
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 72px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__boost--ready {
    background-color: var(--orange);
    opacity: 1;
}

.hud__boost--ready .hud__boost-text {
    color: var(--white);
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
}

.hud__boost--pop {
    scale: 1.12 1.12;
    transition-duration: 0.05s;
}

.hud__boost--hint-pulse {
    scale: 1.08 1.08;
    transition-duration: 0.3s;
}

.hud__boost--pressed {
    translate: 0 11px;
    transition-duration: 0.05s;
}

/* The start prompt of a visit's first round, while the cars wait for the player's first steer or boost (HudView shows
   it): TAP TO START or CLICK TO START, outlined, and under it a dark plate: an orange dot and TAP TO BOOST on a touch
   screen (the full joystick demonstration sits separately in the thumb area), a mouse, HOLD TO DRIVE,
   the SPACE key and BOOST on a desktop (hud__start--desktop). Nothing dims the arena: the player's car and the HUD
   stay as in play. On a narrow screen it sits in the sky under the HUD, over the arena's far edge; on a wide one
   (hud__start--wide) inside the ring of cars, between the far bots and the player's car. It springs in once the curtain
   is up (hud__start--enter, taken off once it is laid out), bobs (hud__start--bob, toggled by HudView, with the mouse
   swinging with it), and flashes away as the round begins (hud__start--leave). */
.hud__start {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 390px;
    align-items: center;
    transition-property: scale, opacity;
    transition-duration: 0.35s, 0.2s;
    transition-timing-function: ease-out-back, linear;
    transition-delay: 0.3s;
}

.hud__start--shown {
    display: flex;
}

.hud__start--wide {
    top: 780px;
}

.hud__start--enter {
    scale: 0.5 0.5;
    opacity: 0;
}

.hud__start--leave {
    scale: 1.2 1.2;
    opacity: 0;
    transition-duration: 0.15s;
    transition-timing-function: ease-in;
    transition-delay: 0s;
}

.hud__start-prompt {
    align-items: center;
    transition-property: scale;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.hud__start--bob .hud__start-prompt {
    scale: 1.06 1.06;
}

.hud__start-text {
    margin: 0;
    padding: 0;
    font-size: 108px;
    color: var(--white);
    -unity-text-outline-width: 16px;
    -unity-text-outline-color: var(--navy);
    text-shadow: 0 14px 0 rgb(29, 43, 79);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__start-hint {
    display: none;
    flex-direction: row;
    align-items: center;
    margin-top: 24px;
    padding: 16px 40px 20px 26px;
    border-radius: 999px;
    background-color: rgba(29, 43, 79, 0.75);
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-delay: 0.42s;
}

.hud__start--touch .hud__start-hint--touch {
    display: flex;
}

.hud__start--desktop .hud__start-hint--desktop {
    display: flex;
}

.hud__start--enter .hud__start-hint {
    translate: 0 40px;
    opacity: 0;
}

.hud__start--leave .hud__start-hint {
    transition-delay: 0s;
}

.hud__start-hint-text {
    margin: 0 0 0 20px;
    padding: 0 0 4px 0;
    font-size: 40px;
    letter-spacing: 2px;
    color: var(--white);
    white-space: nowrap;
}

.hud__start-boost-text {
    margin-left: 16px;
}

.hud__start-key {
    margin-left: 44px;
}

/* The boost button in small: an orange disc with a white rim, as the ready button at the bottom right. */
.hud__start-boost-dot {
    width: 56px;
    height: 56px;
    margin-left: 0;
    border-width: 6px;
    border-color: var(--white);
    border-radius: 28px;
    background-color: var(--orange);
}

/* First-round touch teaching. HudView places the ghost in the lower third, animates its opacity/scale and draws the
   disc and knob with the real joystick's classes. Only the capsule finger and captions are extra, all non-picking.
   The joystick wrapper is translucent; the finger and caption stay opaque once the whole demonstration is shown. */
.hud__ghost {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    scale: 0 0;
}

.hud__ghost-stick {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.hud__ghost-finger {
    position: absolute;
    border-radius: 999px;
    border-width: 7px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    background-color: var(--white);
    transform-origin: 50% 0%;
}

.hud__ghost-caption {
    position: absolute;
    left: -320px;
    top: -266px;
    width: 640px;
    align-items: center;
}

.hud__teaching-text {
    margin: 0;
    padding: 0 0 8px 0;
    font-size: 66px;
    color: var(--white);
    -unity-text-outline-width: 12px;
    -unity-text-outline-color: var(--navy);
    text-shadow: 0 8px 0 rgb(29, 43, 79);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud__tap-hint {
    position: absolute;
    width: 560px;
    align-items: center;
    opacity: 0;
    scale: 0 0;
}

/* Lives inside the moving boost slot, so TAP! and its arrow always follow T5's chosen side. The arrow is two outlined
   chevrons, with no image or font glyph. Scale is on the teaching sticker, independent of the button's ready pop. */
.hud__boost-hint {
    position: absolute;
    left: 0;
    top: -240px;
    width: 300px;
    height: 220px;
    align-items: center;
    opacity: 0;
    scale: 0 0;
}

.hud__boost-hint-label {
    padding: 4px 28px;
    background-color: var(--orange);
}

.hud__boost-hint-arrow {
    position: absolute;
    left: 114px;
    top: 120px;
    width: 72px;
    height: 72px;
    border-right-width: 16px;
    border-bottom-width: 16px;
    border-color: var(--navy);
    rotate: 45deg;
}

.hud__boost-hint-arrow-fill {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 56px;
    height: 56px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-color: var(--orange);
}

/* The mouse: a white outline with its left button orange, swaying as the prompt bobs. */
.hud__start-mouse {
    width: 46px;
    height: 64px;
    border-width: 6px;
    border-color: var(--white);
    border-radius: 23px;
    translate: -8px 0;
    transition-property: translate;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.hud__start--bob .hud__start-mouse {
    translate: 8px 0;
}

.hud__start-mouse-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 14px;
    height: 22px;
    border-top-left-radius: 16px;
    background-color: var(--orange);
}

.hud__start-mouse-line {
    position: absolute;
    left: 14px;
    top: 0;
    width: 6px;
    height: 22px;
    background-color: var(--white);
}

/* The round's result: the title near the top, tilted over the dimmed arena, a line under it, the card with the place
   and the time on the arena, and PLAY AGAIN at the bottom with the free height between them. Only the top spacer gives
   way when a screen is too short. While round-over--enter is on (RoundOverView takes it off once the screen shows),
   the title is small, the card low and the button lower, so they spring into place. */
.round-over {
    justify-content: flex-start;
}

.round-over__spacer-top {
    flex-shrink: 1;
    height: 160px;
    min-height: 60px;
}

.round-over__title {
    flex-shrink: 0;
    rotate: -3deg;
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.round-over__title-text {
    margin: 0;
    padding: 0;
    font-size: 171px;
}

.round-over__title--won {
    color: var(--gold);
}

/* KNOCKED OUT is the long one: at the full size its outline would touch the sides of a portrait screen. */
.round-over__title--out {
    font-size: 148px;
    color: var(--red);
}

/* Confetti round YOU WIN! (pieces placed in RoundOver.uxml from the title's top left corner), shown on a win only. */
.round-over__confetti {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.round-over__confetti--shown {
    display: flex;
}

.confetti {
    position: absolute;
    width: 24px;
    height: 46px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 6px;
    transition-property: scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
    transition-delay: 0.15s;
}

.round-over__subtitle {
    flex-shrink: 0;
    margin: 34px 0 0 0;
    padding: 0;
    font-size: 52px;
    letter-spacing: 2px;
    color: var(--white);
    text-shadow: 0 6px 0 rgb(29, 43, 79);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* After a fall with a car to blame: PUSHED OFF BY, that car in its colour on a white badge, and its visit handle. */
.round-over__by {
    display: none;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 26px;
}

.round-over__by--shown {
    display: flex;
}

.round-over__by-text {
    margin: 0;
    font-size: 44px;
    letter-spacing: 1px;
}

.round-over__by-name {
    margin-left: 18px;
}

.round-over__by-name-text {
    margin: 0;
    padding: 0;
    font-size: 48px;
    -unity-text-outline-width: 7px;
    text-shadow: none;
}

.round-over__by-badge {
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    margin-left: 22px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 52px;
    background-color: var(--white);
    rotate: 10deg;
}

/* REVENGE! under the title, after a round the player knocked out the bot marked for it. Shares the stickers' entrance. */
.round-over__revenge {
    flex-shrink: 0;
    margin-top: 30px;
    background-color: var(--red);
    color: var(--white);
    rotate: 5deg;
}

.round-over__spacer {
    flex-grow: 1;
    flex-shrink: 0;
    min-height: 40px;
}

.round-over__unlock-slot {
    height: 120px;
    margin-top: 24px;
    align-items: center;
    justify-content: center;
}

.round-over__new-car {
    flex-direction: row;
    align-items: center;
    max-width: 981px;
    height: 120px;
    font-size: 40px;
    border-bottom-width: 12px;
    transition-property: none;
}

/* The level card: the player's level badge, the XP the round gave and how far the level is, over the level track
   (RoundOverProgress builds its stops). The meta goal is the one thing on the result besides the buttons. */
.level-card {
    flex-shrink: 0;
    margin: 24px 0 44px 0;
    padding: 28px 40px 10px 40px;
    align-items: stretch;
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-delay: 0.05s;
}

.level-card__head {
    flex-direction: row;
    align-items: center;
}

.level-card__gain {
    margin-left: 28px;
}

.level-card__rank {
    font-size: 34px;
    -unity-text-align: middle-left;
}

.level-card__xp {
    margin: 0;
    padding: 0;
    font-size: 64px;
    color: var(--green-shade);
    -unity-text-align: middle-left;
}

.level-card__total {
    margin-left: auto;
    font-size: 34px;
}

/* A level badge: the number on a rounded sticker in its rank's colour (PlayerRank): white, bronze, silver, gold, and
   pink for legend, since the panel draws no gradient. */
.level-badge {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-width: 60px;
    height: 50px;
    padding: 0 10px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    border-radius: 16px;
    background-color: var(--white);
    color: var(--navy);
}

.level-badge--big {
    min-width: 132px;
    height: 116px;
    padding: 0 18px;
    border-width: 8px;
    border-bottom-width: 16px;
    border-radius: 30px;
}

.level-badge__value {
    margin: 0;
    padding: 0;
    font-size: 30px;
    -unity-text-align: middle-center;
}

.level-badge--big .level-badge__value {
    font-size: 70px;
}

/* The level track: round stops joined by bars, the captions hanging under the stops. A stop the fill has reached turns
   gold and gets the green tick; the current level is gold from the start. */
.track {
    flex-direction: row;
    align-items: center;
    margin-top: 26px;
    padding: 0 30px 96px 30px;
}

.track__node {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    border-width: 8px;
    border-bottom-width: 14px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    color: var(--navy);
}

.track__node--rank {
    width: 124px;
    height: 124px;
}

.track__node--reached {
    background-color: var(--gold);
}

/* After the stop's own colours, so the next-rank stop wears its rank. */
.level-badge--rookie { background-color: var(--white); }
.level-badge--bronze { background-color: #e8a46a; }
.level-badge--silver { background-color: #d7e0ee; }
.level-badge--gold { background-color: var(--gold); }
.level-badge--legend { background-color: #ff7aa8; }

.track__level {
    margin: 0;
    padding: 0;
    font-size: 44px;
    -unity-text-align: middle-center;
}

.track__car {
    width: 84px;
    height: 70px;
}

.track__map {
    width: 54px;
    height: 54px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 27px;
}

.track__caption {
    position: absolute;
    top: 100%;
    left: -60px;
    width: 224px;
    margin-top: 10px;
    align-items: center;
}

.track__node--rank .track__caption {
    left: -50px;
}

.track__caption-level {
    margin: 0;
    padding: 0;
    font-size: 28px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.track__caption-name {
    margin: 0;
    padding: 0;
    font-size: 30px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.track__tick {
    display: none;
    position: absolute;
    top: -18px;
    right: -18px;
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 25px;
    background-color: var(--green);
}

.track__node--done .track__tick {
    display: flex;
}

.track__tick-mark {
    width: 22px;
    height: 12px;
    margin-top: -4px;
    border-left-width: 6px;
    border-bottom-width: 6px;
    border-color: var(--white);
    rotate: -45deg;
}

.track__segment {
    flex-grow: 1;
    height: 34px;
    min-width: 30px;
    border-width: 7px;
    border-color: var(--navy);
    background-color: var(--soft);
    overflow: hidden;
    transform-origin: 0 50%;
}

/* Toward the next rank: thinner and pale, it is further than it looks. */
.track__segment--dotted {
    height: 16px;
    margin: 0 10px;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--silver);
}

.track__fill {
    width: 0;
    height: 100%;
    background-color: var(--gold);
}

/* NEXT MATCH and, where there is a keyboard, the key that presses it. The entrance moves this wrapper, not the
   button, whose own translate is its press. */
.round-over__actions {
    flex-shrink: 0;
    align-items: center;
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-delay: 0.12s;
}

.round-over__button {
    width: 981px;
}

.round-over__hint {
    flex-direction: row;
    align-items: center;
    margin-top: 36px;
}

.round-over__hint-text {
    margin: 0;
    padding: 0;
    font-size: 40px;
    letter-spacing: 3px;
    color: var(--white);
    text-shadow: 0 5px 0 rgb(29, 43, 79);
}

.round-over__spacer-bottom {
    flex-shrink: 0;
    height: 70px;
}

.round-over--enter .round-over__title {
    scale: 0.4 0.4;
    opacity: 0;
}

.round-over--enter .confetti {
    scale: 0 0;
}

.round-over--enter .best--new {
    scale: 0 0;
}

.round-over--enter .level-card {
    translate: 0 120px;
    opacity: 0;
}

.round-over--enter .round-over__actions {
    translate: 0 240px;
    opacity: 0;
}

/* The car colours (CarColor in Scripts/UI picks the class), late in the file so they win over the white of a pip__body
   they are put on. */
.car-color--0 {
    background-color: var(--car-green);
}

.car-color--1 {
    background-color: var(--car-red);
}

.car-color--2 {
    background-color: var(--car-blue);
}

.car-color--3 {
    background-color: var(--car-yellow);
}

.car-color--4 {
    background-color: var(--car-purple);
}

.car-color--5 {
    background-color: var(--car-orange);
}

.car-color--6 {
    background-color: var(--car-pink);
}

.car-color--7 {
    background-color: var(--car-dark);
}

/* Last, so the face of a stroke wins over every rule above that gives its text an outline or a drop: the outline is
   centred on the letters' edge, so the face over it keeps the letters their full width. */
.stroke > .stroke__face {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* Two aligned layers: a neutral car and its separately tinted white body. */
.car-portrait {
    width: 100%;
    height: 100%;
}

.car-portrait__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--white);
}

.round-over__ready {
    margin: 0;
    padding: 0;
    font-size: 28px;
    color: var(--navy);
    -unity-text-align: middle-left;
    visibility: hidden;
}

.round-over__new-car-portrait {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    margin-right: 16px;
}

.round-over__new-car-copy {
    justify-content: center;
}

.round-over__new-car-name {
    margin: 0;
    padding: 0;
    font-size: 40px;
}

.round-over__buttons {
    width: 981px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.round-over__buttons .round-over__button {
    width: 745px;
    min-width: 0;
    padding-left: 20px;
    padding-right: 20px;
}

.round-over__garage {
    flex-direction: column;
    flex-shrink: 0;
    width: 208px;
    height: 208px;
    margin: 0;
    padding: 6px;
}

.round-over__garage:hover,
.round-over__garage:focus {
    background-color: var(--soft);
}

.round-over__garage:active {
    translate: 0 8px;
}

.round-over__garage-portrait {
    width: 132px;
    height: 112px;
}

.round-over__garage-label {
    margin: 0;
    padding: 0;
    font-size: 34px;
    color: var(--navy);
}

.round-over__garage-dot {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 38px;
    height: 38px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--red);
}

.round-over--landscape .round-over__buttons {
    width: 1240px;
}

.round-over--landscape .round-over__button {
    width: 981px;
}

/* UIKit disables the screen under a popup; keep the existing result looking the same. */
.round-over:disabled,
.round-over:disabled .button,
.round-over:disabled .round-over__garage {
    opacity: 1;
}

.garage {
    justify-content: center;
    padding: 24px 0;
    /* Popup leaves RoundOver drawn underneath. Only the transition fades this opaque cover. */
    background-color: var(--navy);
}

.garage__title {
    flex-shrink: 0;
    margin-bottom: 16px;
    rotate: -4deg;
}

.garage__title-text {
    margin: 0;
    padding: 0;
    font-size: 116px;
    color: var(--gold);
}

/* The car the player drives next, large and in the chosen colour; the grid below is where it is changed. */
.garage__preview {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 940px;
    height: 180px;
    margin-bottom: 8px;
}

.garage__preview-car {
    flex-shrink: 0;
    width: 280px;
    height: 180px;
}

.garage__preview-copy {
    flex-shrink: 0;
    margin-left: 24px;
    align-items: flex-start;
}

.garage__preview-caption {
    margin: 0;
    padding: 0;
    font-size: 34px;
    color: var(--soft);
}

.garage__preview-name {
    margin: 0;
    padding: 0;
    font-size: 84px;
    color: var(--white);
    white-space: nowrap;
}

/* Eight colours fit in one row above either grid; selection changes scale without moving its neighbours. */
.garage__colors {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 940px;
    height: 128px;
    margin-bottom: 10px;
}

.garage__color {
    flex-shrink: 0;
    width: 92px;
    height: 100px;
    margin: 0;
    padding: 0;
    border-width: 7px;
    border-bottom-width: 15px;
    border-color: var(--navy);
    border-radius: 999px;
    align-items: center;
    justify-content: center;
}

.garage__color:hover,
.garage__color:focus { scale: 1.08 1.08; }
.garage__color--selected,
.garage__color--selected:hover,
.garage__color--selected:focus { scale: 1.18 1.18; }

.garage__color-ring {
    display: none;
    position: absolute;
    left: 1px;
    right: 1px;
    top: 1px;
    bottom: 1px;
    border-width: 5px;
    border-color: var(--white);
    border-radius: 999px;
    align-items: center;
    justify-content: center;
}

.garage__color--selected .garage__color-ring { display: flex; }
.garage__color-check {
    width: 25px;
    height: 15px;
    margin-bottom: 7px;
    border-left-width: 6px;
    border-bottom-width: 6px;
    border-color: var(--white);
    rotate: -45deg;
}

.garage__grid {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 981px;
}

.garage__car {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 456px;
    height: 252px;
    margin: 8px 10px;
    padding: 4px 16px 6px 16px;
    border-width: 9px;
    border-bottom-width: 20px;
    border-color: var(--navy);
    border-radius: 42px;
    background-color: var(--white);
    color: var(--navy);
}

.garage__car:hover,
.garage__car:focus {
    background-color: var(--soft);
}

.garage__car--selected {
    border-color: var(--green);
}

.garage__portrait {
    flex-shrink: 0;
    height: 112px;
}

.garage__name {
    flex-shrink: 0;
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 40px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.garage__status {
    flex-shrink: 0;
    height: 48px;
    padding: 0 18px;
    border-width: 5px;
    border-bottom-width: 9px;
    background-color: var(--soft);
    font-size: 28px;
}

.garage__status Label {
    margin: 0;
    padding: 0;
}

.garage__car--selected .garage__status {
    background-color: var(--green);
}

.garage__car--locked .garage__status {
    background-color: var(--gold);
}

.garage__check {
    display: none;
    width: 20px;
    height: 12px;
    margin-right: 12px;
    margin-bottom: 6px;
    border-left-width: 6px;
    border-bottom-width: 6px;
    border-color: var(--navy);
    rotate: -45deg;
}

.garage__car--selected .garage__check {
    display: flex;
}

.garage__play {
    flex-shrink: 0;
    margin-top: 20px;
}

/* Back to the result, top right; Esc does the same. */
.garage__close {
    position: absolute;
    top: 40px;
    right: 40px;
    width: 120px;
    height: 120px;
    margin: 0;
    padding: 0;
    border-width: 8px;
    border-bottom-width: 16px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    background-image: none;
    align-items: center;
    justify-content: center;
}

.garage__close:hover,
.garage__close:focus { background-color: var(--soft); }
.garage__close:active { translate: 0 8px; }

.garage__close-bar {
    position: absolute;
    width: 56px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--navy);
    rotate: 45deg;
}

.garage__close-bar--turned { rotate: -45deg; }

.garage--landscape .garage__grid {
    width: 1800px;
}

.garage--landscape .garage__car {
    width: 414px;
    height: 350px;
}

.garage--landscape .garage__portrait {
    height: 200px;
}
/* Two sibling labels in a measured container, shared by the lobby and the social overlays. */
.sticker-text { flex-shrink: 0; }
.sticker-text__text {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--navy);
}

/* IO1: explicit text geometry, and no label used as the parent of its own face. */
.lobby__name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 76px;
    overflow: visible;
}
.lobby__name .sticker-text__text {
    font-size: 54px;
    color: var(--navy);
    -unity-text-outline-width: 0;
}
.lobby__name--revenge .sticker-text__text { color: var(--red); }
.lobby__row--left .lobby__name .sticker-text__text { color: var(--muted); }
.lobby__badge {
    height: 80px;
    padding: 0;
    justify-content: center;
}
.lobby__badge .sticker-text__text {
    font-size: 36px;
    color: var(--navy);
    -unity-text-outline-width: 0;
    -unity-text-align: middle-center;
}
.lobby__row .lobby__you-chip { border-color: var(--white); }
.lobby__row .hud__chip-ring {
    width: 66px;
    height: 66px;
    right: auto;
    bottom: auto;
}

/* One short feed below the portrait pills; the wide layout uses the free top-left corner. */
.feed {
    position: absolute;
    left: 24px;
    top: 488px;
    width: 660px;
    height: 0;
    visibility: hidden;
}
.feed--wide { top: 54px; }
.feed__row {
    position: absolute;
    left: 0;
    right: 0;
    height: 68px;
    flex-direction: row;
    align-items: center;
    padding: 2px 12px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    border-radius: 24px;
    background-color: var(--name-backdrop);
    color: var(--white);
    font-size: 30px;
}
.feed__row--you { background-color: var(--white); color: var(--navy); }
.feed__row .sticker-text__text { font-size: 30px; color: var(--white); }
.feed__row--you .sticker-text__text { color: var(--navy); -unity-text-outline-width: 0; }
.feed__row .hud__chip {
    position: relative;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-width: 4px;
    border-radius: 21px;
    margin-right: 8px;
    transition-duration: 0s;
}
.feed__row .hud__chip-car { scale: 0.65 0.65; }
.feed__row .hud__chip-ring { border-width: 2px; border-radius: 16px; }
.feed__name {
    height: 48px;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
}
.feed__name .sticker-text__text { overflow: hidden; text-overflow: ellipsis; }
.feed__fell { height: 48px; margin-left: 14px; margin-right: 8px; }
.feed__arrow {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin: 0 16px 0 10px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-color: var(--gold);
    rotate: 45deg;
}

.emotion {
    position: absolute;
    width: 280px;
    height: 90px;
    align-items: stretch;
    justify-content: center;
    padding: 0 12px;
    border-width: 6px;
    border-bottom-width: 12px;
    border-color: var(--navy);
    border-radius: 30px;
    background-color: var(--white);
    color: var(--navy);
    font-size: 42px;
}
.emotion__text { height: 68px; }
.emotion__text .sticker-text__text { font-size: 42px; color: var(--navy); -unity-text-align: middle-center; -unity-text-outline-width: 0; }

