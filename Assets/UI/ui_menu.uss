/* The main menu (MenuView builds it): a showroom over the drifting checker of the garage and the lobby, on the sky
   blue of the theme. The player's car turns on a 3D pedestal over slow white rays in the middle, the level, XP and coins run along the top, a rail of tiles (GARAGE, MISSIONS, AWARDS) stands at the left,
   and the nearest mission, the mode and PLAY sit at the bottom. The design is MenuB in Claude Design
   (claude.ai/artifact/PWuwUnPztaKrVyjfKk4Xev).

   A sticker's dark drop here is its own layer behind the face (menu__drop), never a thicker bottom border, so the
   content stays centred on the face. Sizes are reference pixels of the 1080x1920 panel; MenuView scales the anchored
   groups up on a phone held sideways, where the Expand panel is small. */

/* The sky is the league's (LeagueLook.SkyOf, a radial texture set in code), under the drifting checker. */
.menu {
    background-color: var(--blue);
    background-size: cover;
    color: var(--navy);
    overflow: hidden;
}

.menu__spacer {
    flex-grow: 1;
}

/* -- Stickers ------------------------------------------------------------------------------------------------------ */

.menu__sticker {
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.menu__drop {
    position: absolute;
    left: 0;
    right: 0;
    top: 14px;
    bottom: -14px;
    border-radius: 40px;
    background-color: var(--navy);
}

.menu__face {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 40px;
    background-color: var(--navy);
    align-items: center;
    justify-content: center;
    transition-property: translate;
    transition-duration: 0.08s;
}

/* The face's colour, inside its border (MenuView.Face): a face filled itself shows its colour through the soft outer
   edge of its border, a light seam over the drop. Its radius is the face's less the border. */
.menu__fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 32px;
    background-color: var(--white);
}

.menu__sticker:hover > .menu__face > .menu__fill { background-color: var(--soft); }
.menu__sticker:active > .menu__face { translate: 0 10px; }

/* -- Top bar ------------------------------------------------------------------------------------------------------- */

.menu__top {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 40px;
    flex-direction: row;
    align-items: center;
    transform-origin: left top;
}

.menu__level {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    width: 640px;
    height: 120px;
}

.menu__level-badge {
    position: absolute;
    left: 0;
    top: 0;
}

.menu__level .level-badge {
    min-width: 120px;
    height: 120px;
    border-width: 8px;
    border-bottom-width: 8px;
    border-radius: 30px;
}

.menu__level .level-badge__value { font-size: 64px; }

/* The XP bar, thinner than the badge (72 of 120): its left end square and under the badge (MenuView.PlaceXp sets
   where it starts), its right end round, the navy drop a layer of its own behind it. */
.menu__xp {
    position: absolute;
    left: 60px;
    right: 0;
    top: 20px;
    height: 72px;
}

.menu__xp-drop,
.menu__xp-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 36px;
    border-bottom-right-radius: 36px;
}

.menu__xp-drop {
    top: 8px;
    bottom: -8px;
    background-color: var(--navy);
}

.menu__xp-track {
    border-width: 7px;
    border-color: var(--navy);
    background-color: var(--navy);
    overflow: hidden;
}

/* The track's colour inside its border, as a sticker's fill (MenuView.Face). */
.menu__xp-back {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-top-right-radius: 29px;
    border-bottom-right-radius: 29px;
    background-color: var(--soft);
}

.menu__xp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--xp);
}

/* The darker strip along the fill's bottom, as on the design's bars. */
.menu__xp-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    background-color: var(--xp-shade);
}

/* ×2 XP on the bar's top edge while the XP boost runs: a blue tag with white outlined text. */
.menu__xp-boost {
    position: absolute;
    right: 26px;
    top: -50px;
    padding: 0 14px 3px 14px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--xp);
    rotate: 4deg;
}

.menu__xp-boost-label-text {
    font-size: 30px;
    -unity-text-outline-width: 7px;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.menu__xp-text {
    position: absolute;
    left: 82px;
    right: 26px;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.menu__rank,
.menu__xp-count {
    margin: 0;
    padding: 0;
    font-size: 36px;
    color: var(--navy);
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.menu__rank {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.menu__xp-numbers {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
    margin-left: 16px;
}

/* XP smaller and muted after the numbers; a nudge down sets it on their baseline. */
.menu__xp-unit {
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 26px;
    color: var(--muted);
    translate: 0 -3px;
}

/* The coins as tall as the XP bar, with the same drop. */
.menu__coins {
    height: 72px;
    margin-left: 24px;
}

.menu__coins-drop,
.menu__coins-face {
    border-radius: 36px;
}

.menu__coins-drop {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    bottom: -8px;
    background-color: var(--navy);
}

.menu__coins-face {
    flex-direction: row;
    align-items: center;
    height: 72px;
    padding: 0 30px 0 14px;
    border-width: 7px;
    border-color: var(--navy);
    background-color: var(--navy);
}

/* The pill's colour inside its border, as a sticker's fill (MenuView.Face). */
.menu__coins-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 29px;
    background-color: var(--white);
}

.menu__coins-count {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 44px;
    color: var(--navy);
}

/* Sideways the coins are as tall as the gear beside them, with its drop (menu and garage); on the result always. */
.menu--wide .menu__coins,
.garage--wide .menu__coins,
.coin-pill.menu__coins {
    height: 112px;
    margin-bottom: 14px;
}

.menu--wide .menu__coins-drop,
.garage--wide .menu__coins-drop,
.coin-pill .menu__coins-drop {
    top: 14px;
    bottom: -14px;
    border-radius: 56px;
}

.menu--wide .menu__coins-face,
.garage--wide .menu__coins-face,
.coin-pill .menu__coins-face {
    height: 112px;
    padding: 0 40px 0 20px;
    border-width: 8px;
    border-radius: 56px;
}

.menu--wide .menu__coins-fill,
.garage--wide .menu__coins-fill,
.coin-pill .menu__coins-fill { border-radius: 48px; }

.menu--wide .menu__coins-count,
.garage--wide .menu__coins-count,
.coin-pill .menu__coins-count {
    margin-left: 16px;
    font-size: 62px;
}

.menu--wide .menu__coins .coin,
.garage--wide .menu__coins .coin,
.coin-pill .coin {
    width: 72px;
    height: 72px;
    border-width: 7px;
    border-bottom-width: 10px;
}

.menu--wide .menu__coins .coin__inner,
.garage--wide .menu__coins .coin__inner,
.coin-pill .coin__inner {
    width: 28px;
    height: 28px;
}

.menu__gear {
    width: 112px;
    height: 112px;
    margin: 0 0 14px 24px;
}

.menu__gear > .menu__drop,
.menu__gear > .menu__face,
.menu__gear .menu__fill { border-radius: 999px; }

/* -- Rail ---------------------------------------------------------------------------------------------------------- */

.menu__rail {
    position: absolute;
    left: 40px;
    top: 220px;
    align-items: center;
    transform-origin: left top;
}

.menu__tile {
    align-items: center;
    margin-bottom: 26px;
}

.menu__tile-button {
    width: 150px;
    height: 150px;
    margin-bottom: 14px;
}

.menu__tile-caption {
    margin: 6px 0 0 0;
    padding: 0;
    font-size: 36px;
    -unity-text-outline-width: 9px;
    text-shadow: 0 7px 0 rgb(29, 43, 79);
}

.menu__tile-caption.stroke__face { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.menu__icon {
    width: 86px;
    height: 86px;
}

.menu__new {
    position: absolute;
    top: -24px;
    right: -30px;
    padding: 2px 16px 4px 16px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--gold);
    font-size: 28px;
    color: var(--navy);
    display: none;
}

.menu__dot {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 46px;
    height: 46px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--red);
    display: none;
}

.menu__tile--new .menu__new { display: flex; }
.menu__tile--dot .menu__dot { display: flex; }
/* NEW sits in the corner the dot would take; the dot moves down under it. */
.menu__tile--new.menu__tile--dot .menu__dot { top: 36px; right: -24px; }

/* Every key in one corner, the top left (PLAY's too): NEW, the red dot and the AD tag keep the top right. */
.menu__key {
    position: absolute;
    left: -18px;
    top: -18px;
    margin: 0;
    padding: 0 12px 2px 12px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
    display: none;
}

.menu__key .key__text { font-size: 28px; }

.menu--desktop .menu__key { display: flex; }

/* -- XP BOOST, on its own rail at the right ------------------------------------------------------------------------ */

.menu__rail--right { transform-origin: right top; }

/* Offered: a pale blue face, the blue star and a gold AD tag in the corner. */
.menu__tile--boost .menu__fill { background-color: #d6e7ff; }
.menu__tile--boost .menu__sticker:hover > .menu__face > .menu__fill { background-color: #e6f0ff; }

.menu__ad {
    position: absolute;
    top: -24px;
    right: -30px;
    width: 76px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--purple);
}

.menu__ad .double__play {
    width: 38px;
    height: 38px;
    margin: 0;
}

.menu__boost-times { display: none; }

.menu__boost-times-text {
    font-size: 64px;
    -unity-text-outline-width: 11px;
    text-shadow: 0 6px 0 rgb(29, 43, 79);
}

/* Running: a blue face with ×2, and the matches left on one pill across its bottom edge (nothing else on it). */
.menu__boost-left {
    position: absolute;
    bottom: -26px;
    align-self: center;
    padding: 2px 16px 4px 16px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    font-size: 28px;
    color: var(--navy);
    white-space: nowrap;
    display: none;
}

.menu__tile--boost-on .menu__fill,
.menu__tile--boost-on .menu__sticker:hover > .menu__face > .menu__fill { background-color: var(--xp); }
.menu__tile--boost-on .menu__icon,
.menu__tile--boost-on .menu__ad,
.menu__tile--boost-on .menu__key { display: none; }
.menu__tile--boost-on .menu__boost-times,
.menu__tile--boost-on .menu__boost-left { display: flex; }
/* The pill hangs under the tile: the caption keeps clear of it. */
.menu__tile--boost-on .menu__tile-caption { margin-top: 26px; }

/* The offer's popup: a blue tilted title, the offer on a pale blue panel ringed in blue, WATCH and NO THANKS. */
.menu__boost-popup .menu__sheet { width: 860px; align-items: center; }
.menu__boost-popup .menu__sheet-head { align-self: stretch; }
.menu__boost-popup .menu__sheet-head > .stroke { rotate: -4deg; }
.menu__boost-popup .menu__sheet-title { color: var(--xp); }

.menu__boost-offer {
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    padding: 30px 34px;
    border-width: 8px;
    border-color: var(--xp);
    border-radius: 40px;
    background-color: #e2eeff;
}

.menu__boost-orb {
    flex-shrink: 0;
    width: 150px;
    height: 150px;
    margin-right: 30px;
    align-items: center;
    justify-content: center;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

.menu__boost-star {
    width: 104px;
    height: 104px;
}

.menu__boost-body {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: flex-start;
}

.menu__boost-xp {
    margin: 0;
    padding: 0;
    font-size: 80px;
    color: var(--navy);
}

.menu__boost-matches {
    margin: 2px 0 14px 0;
    padding: 0;
    font-size: 34px;
    color: var(--navy);
    white-space: normal;
}

.menu__boost-pips { flex-direction: row; }

.menu__boost-pip {
    width: 44px;
    height: 44px;
    margin-right: 12px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--xp);
}

.menu__boost-hint {
    margin: 30px 0 34px 0;
    padding: 0;
    font-size: 36px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

.menu__watch {
    align-self: stretch;
    height: 170px;
    padding: 0 40px 20px 40px;
}

.menu__watch .double__play {
    flex-shrink: 0;
    width: 76px;
    height: 76px;
    margin-right: 18px;
}

.menu__watch-label-text {
    font-size: 80px;
    -unity-text-outline-width: 12px;
    text-shadow: 0 6px 0 rgb(29, 43, 79);
}

.menu__watch-label-text.stroke__face { -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.menu__watch-key {
    display: none;
    margin-left: 24px;
    padding: 0 18px 2px 18px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
}

.menu__watch-key .key__text { font-size: 32px; }

.menu__watch-tag {
    position: absolute;
    top: -26px;
    right: 34px;
    margin: 0;
    padding: 2px 16px 4px 16px;
    border-radius: 14px;
    background-color: var(--navy);
    color: var(--white);
    font-size: 30px;
    letter-spacing: 1px;
}

.menu__no-thanks {
    min-width: 70%;
    height: 120px;
    margin-top: 26px;
    padding: 0 60px 16px 60px;
}

.menu__no-thanks-label {
    font-size: 48px;
    color: var(--navy);
}

.menu__no-thanks-key {
    display: none;
    position: absolute;
    top: -22px;
    right: 30px;
    margin: 0;
    padding: 0 12px 2px 12px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
}

.menu__no-thanks-key .key__text { font-size: 26px; }

.menu--desktop .menu__watch-key,
.menu--desktop .menu__no-thanks-key { display: flex; }

/* -- The car -------------------------------------------------------------------------------------------------------- */

.menu__stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 240px;
    bottom: 560px;
}

.menu__rays {
    position: absolute;
    transform-origin: center;
}

.menu__plinth {
    position: absolute;
    left: 50%;
    bottom: 150px;
    width: 600px;
    height: 220px;
    translate: -50% 0;
    transform-origin: center bottom;
}

.menu__plinth-base,
.menu__plinth-top {
    position: absolute;
    left: 0;
    right: 0;
    height: 150px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 50%;
}

.menu__plinth-base {
    bottom: 0;
    background-color: var(--shade);
}

.menu__plinth-side {
    position: absolute;
    left: 0;
    right: 0;
    top: 75px;
    bottom: 75px;
    border-left-width: 8px;
    border-right-width: 8px;
    border-color: var(--navy);
    background-color: var(--shade);
}

.menu__plinth-top {
    top: 0;
    background-color: var(--white);
}

.menu__hero {
    position: absolute;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.menu__hero-portrait {
    position: absolute;
    width: 600px;
    height: 600px;
}

.menu__car-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    align-items: center;
}

.menu__car-pill {
    height: 120px;
    padding-bottom: 14px;
}

.menu__car-pill > .menu__drop,
.menu__car-pill > .menu__face,
.menu__car-pill .menu__fill { border-radius: 999px; }

/* The face lies in the flow here, so the pill is as wide as the name. */
.menu__car-pill > .menu__face {
    position: relative;
    flex-direction: row;
    height: 106px;
    padding: 0 14px 0 44px;
}

.menu__car-name-text {
    margin: 0 20px 0 0;
    padding: 0;
    font-size: 58px;
    color: var(--navy);
    white-space: nowrap;
}

.menu__car-garage {
    width: 78px;
    height: 78px;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--green);
}

.menu__car-garage-icon {
    width: 44px;
    height: 44px;
}

/* -- Bottom: the nearest mission, the mode and PLAY ----------------------------------------------------------------- */

.menu__bottom {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 50px;
    transform-origin: left bottom;
}

.menu__mission {
    height: 190px;
    margin-bottom: 40px;
}

.menu__mission > .menu__face {
    flex-direction: row;
    padding: 0 30px 0 22px;
    justify-content: flex-start;
}

.menu__mission-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 10px 0 24px;
}

/* Two lines at most: a long task (Russian) wraps instead of losing its end. */
.menu__mission-task {
    margin: 0;
    padding: 0;
    font-size: 40px;
    color: var(--navy);
    white-space: normal;
    max-height: 96px;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.menu__mission-reward { margin-top: 8px; }

.menu__actions {
    flex-direction: row;
    align-items: stretch;
    height: 210px;
}

/* Wide enough that QUICK MATCH keeps its full size with room before the chevron; PLAY grows into the rest. */
.menu__mode {
    width: 460px;
    height: 196px;
    margin-right: 30px;
}

.menu__mode > .menu__face {
    flex-direction: row;
    justify-content: space-between;
    padding: 0 32px 0 36px;
}

.menu__mode-caption {
    margin: 0;
    padding: 0;
    font-size: 30px;
    letter-spacing: 2px;
    color: var(--muted);
}

/* Shrinks with the card, so a long name (BYSTRYI MATCH) shrinks instead of running under the chevron, and keeps a
   clear gap before it: the chevron belongs to the plate, not to the text. */
.menu__mode-texts {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 28px;
}

.menu__mode-name {
    margin: 0;
    padding: 0;
    font-size: 46px;
    color: var(--navy);
    white-space: nowrap;
    -unity-text-auto-size: best-fit 26px 46px;
}

/* The plate opens the modes: its chevron says so, as a select's does, at the trailing edge and centred on the whole
   plate (both lines), as tall as the name's capitals (DrawChevron strokes 70% of the box), its stroke about theirs.
   Its far point sits about as far in from the right as the texts from the left. */
.menu__chevron {
    flex-shrink: 0;
    width: 32px;
    height: 46px;
}

.menu__play {
    flex-grow: 1;
    min-width: 0;
    height: 210px;
    padding-bottom: 40px;
}

.menu__play .button__label { font-size: 112px; }

.menu__play-key {
    position: absolute;
    top: -30px;
    left: -18px;
    margin: 0;
    display: none;
}

.menu--desktop .menu__play-key { display: flex; }

/* The mode's key as PLAY's beside it: the rails' smaller keys are drawn for their larger scale. */
.menu__mode-key {
    position: absolute;
    top: -30px;
    left: -18px;
    margin: 0;
    display: none;
}

.menu--desktop .menu__mode-key { display: flex; }

/* Wide: one row at the bottom, the mission at the left and the mode and PLAY at the right. */
.menu--wide .menu__bottom {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.menu--wide .menu__mission {
    width: 860px;
    margin: 0 0 30px 0;
}

.menu--wide .menu__actions { width: 1060px; }

.menu--wide .menu__stage {
    top: 260px;
    bottom: 330px;
}

/* -- Popups: the missions and the modes over a dim, in a white card ----------------------------------------------- */

.menu__popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(29, 43, 79, 0.6);
    display: none;
}

.menu__popup--open { display: flex; }

.menu__sheet {
    width: 960px;
    padding: 40px 44px 50px 44px;
    align-items: stretch;
    transform-origin: center;
}

.menu__sheet-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 120px;
    margin-bottom: 26px;
}

.menu__sheet-title {
    margin: 0;
    padding: 0;
    font-size: 76px;
    -unity-text-outline-width: 14px;
    text-shadow: 0 12px 0 rgb(29, 43, 79);
}

.menu__close {
    width: 112px;
    height: 112px;
    margin-bottom: 14px;
}

.menu__close > .menu__drop,
.menu__close > .menu__face,
.menu__close .menu__fill { border-radius: 999px; }

.menu__close-bar {
    position: absolute;
    width: 52px;
    height: 13px;
    border-radius: 7px;
    background-color: var(--navy);
    rotate: 45deg;
}

.menu__close-bar--turned { rotate: -45deg; }

.menu__mission-row {
    flex-direction: row;
    align-items: center;
    min-height: 150px;
    padding: 20px 30px 20px 24px;
    margin-bottom: 18px;
    border-radius: 40px;
    background-color: var(--soft);
}

/* USS has no :last-child: the view marks the last row. */
.menu__mission-row--last { margin-bottom: 0; }

.menu__mission-row-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 10px 0 26px;
}

.menu__mission-row-task {
    margin: 0 0 8px 0;
    padding: 0;
    font-size: 42px;
    color: var(--navy);
    white-space: normal;
    -unity-text-align: middle-left;
}

.menu__modes-play {
    height: 190px;
    margin-top: 10px;
    padding-bottom: 36px;
}

.menu__modes-play .button__label { font-size: 96px; }

/* CHOOSE MODE, as the MenuB_Modes board: the event on an orange card with sun rays, QUICK MATCH on a white one, the
   modes to come as low grey rows. A card's face clips its picture; its holder carries the green ring of the mode in
   play, the navy drop under the card and the SELECTED tag. */
.menu__mode-holder {
    margin-bottom: 44px;
}

.menu__mode-ring {
    position: absolute;
    left: -18px;
    top: -18px;
    right: -18px;
    bottom: -30px;
    border-radius: 62px;
    background-color: var(--green);
    display: none;
}

.menu__mode-holder--selected > .menu__mode-ring { display: flex; }

.menu__mode-drop {
    position: absolute;
    left: 0;
    top: 12px;
    right: 0;
    bottom: -12px;
    border-radius: 44px;
    background-color: var(--navy);
}

.menu__mode-card {
    height: 290px;
    padding: 30px 34px;
    overflow: hidden;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 44px;
    background-color: var(--white);
}

.menu__mode-card--event {
    height: 420px;
    -unity-background-scale-mode: stretch-to-fill;
}

.menu__event-rays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.menu__event-tag {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    padding: 2px 22px 4px 10px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

.menu__event-bolt {
    width: 38px;
    height: 38px;
    margin-right: 4px;
}

.menu__event-tag-label-text {
    margin: 0;
    padding: 0;
    font-size: 32px;
    color: var(--orange);
    -unity-text-outline-width: 8px;
    -unity-text-outline-color: var(--navy);
}

.menu__event-tag-label-text.stroke__drop { translate: 0 14%; }

.menu__event-title-box {
    align-self: flex-start;
    flex-shrink: 0;
    max-width: 68%;
    margin-top: 14px;
    margin-bottom: 16px;
}

.menu__event-title-text {
    margin: 0;
    padding: 0;
    font-size: 76px;
    color: var(--white);
    white-space: nowrap;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 14px;
    -unity-text-outline-color: var(--navy);
}

/* As the popups' titles: 12 px at 76 px, a share of the size so a shrunk name keeps its drop in proportion. */
.menu__event-title-text.stroke__drop { translate: 0 16%; }

.menu__mode-card-name {
    margin: 0;
    padding: 0;
    font-size: 64px;
    color: var(--navy);
    white-space: nowrap;
}

.menu__mode-card-name-box {
    width: 60%;
    overflow: hidden;
}

.menu__mode-desc {
    width: 58%;
    margin: 8px 0 0 0;
    padding: 0;
    font-size: 34px;
    color: var(--navy);
    white-space: normal;
}

.menu__mode-desc--event {
    width: 52%;
    margin-top: 6px;
}

/* As the board's picture: the toy as tall as the card, cut to its pixels, bleeding off the bottom right over the rays' middle. */
.menu__event-art {
    position: absolute;
    right: -20px;
    bottom: -48px;
    width: 312px;
    height: 440px;
    background-image: url("project://database/Assets/Art/Sprites/UI/sprite_mode_hot_potato.png?fileID=2800000&guid=64c7f85dcef645e409866a1a16d2c310&type=3#sprite_mode_hot_potato");
    -unity-background-scale-mode: scale-to-fit;
}

.menu__mode-portrait {
    position: absolute;
    right: -10px;
    bottom: -40px;
    width: 330px;
    height: 300px;
}

.menu__mode-selected {
    position: absolute;
    top: 26px;
    right: 26px;
    flex-direction: row;
    align-items: center;
    padding: 4px 24px 6px 6px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--green);
    display: none;
}

.menu__mode-holder--selected > .menu__mode-selected { display: flex; }

.menu__mode-tick {
    width: 46px;
    height: 46px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    border-radius: 23px;
    background-color: var(--navy);
}

.menu__mode-tick-mark {
    width: 30px;
    height: 30px;
}

.menu__mode-selected-label-text {
    margin: 0;
    padding: 0;
    font-size: 30px;
    color: var(--white);
    -unity-text-outline-width: 8px;
    -unity-text-outline-color: var(--navy);
}

.menu__mode-selected-label-text.stroke__drop { translate: 0 14%; }

/* A mode not out yet: a low grey row with a gold padlock and a white SOON pill; nothing on hover. */
.menu__mode-soon {
    flex-direction: row;
    align-items: center;
    height: 150px;
    margin-bottom: 26px;
    padding: 0 34px;
    border-width: 8px 8px 14px 8px;
    border-color: var(--navy);
    border-radius: 40px;
    background-color: var(--soft);
}

.menu__mode-lock {
    flex-shrink: 0;
    width: 70px;
    height: 70px;
}

.menu__mode-soon-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 20px 0 26px;
}

.menu__mode-soon-name {
    margin: 0;
    padding: 0;
    font-size: 44px;
    color: var(--navy);
    white-space: nowrap;
}

.menu__mode-soon-hint {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 27px;
    color: var(--muted);
    white-space: normal;
}

.menu__mode-soon-tag {
    flex-shrink: 0;
    margin: 0;
    padding: 4px 22px 6px 22px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    font-size: 28px;
    color: var(--navy);
}

/* -- Leagues: the NEW LEAGUE! popup and the leagues list (MenuLeagues) -------------------------------------------- */

.menu__league-popup { background-color: rgba(29, 43, 79, 0.72); }

/* The menu's light turning behind the card (MenuView.DrawLight). */
.menu__league-light {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2400px;
    height: 2400px;
    margin-left: -1200px;
    margin-top: -1200px;
}

/* The card's holder: the screen's scale goes on it (NewLeaguePopup.Fit). */
.menu__league-holder {
    align-items: center;
    transform-origin: center;
}

/* As wide as the result's reward popups and the garage's BUY window, whose sky frame it shares. */
.menu__league-card {
    width: 1040px;
    padding: 110px 64px 52px 64px;
    align-items: center;
    border-width: 9px;
    border-bottom-width: 26px;
    border-radius: 82px;
}

.menu__league-title {
    position: absolute;
    left: 0;
    right: 0;
    top: -100px;
    align-items: center;
}

.menu__league-title-text {
    margin: 0;
    padding: 0;
    font-size: 116px;
    color: var(--gold);
    -unity-text-outline-width: 18px;
    text-shadow: 0 14px 0 rgb(29, 43, 79);
    rotate: -4deg;
}

.menu__league-title-text.stroke__face { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

/* The player's car on the new pedestal in the new sky (GarageView.SkyFrame), the emblem as a medal on its lower edge. */
.menu__league-stage {
    align-self: stretch;
    margin-top: 10px;
    padding-bottom: 92px;
}

.menu__league-card .menu__league-frame {
    height: 440px;
    margin-top: 0;
}

.menu__league-frame-plinth {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 420px;
    height: 220px;
    margin-left: -210px;
    margin-top: -60px;
}

.menu__league-medal {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 200px;
    height: 200px;
    margin-left: -100px;
}

.menu__league-name {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 94px;
    -unity-text-outline-width: 16px;
    text-shadow: 0 12px 0 rgb(29, 43, 79);
    white-space: nowrap;
    -unity-text-auto-size: best-fit 48px 94px;
}

.menu__league-name.stroke__face { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

/* The level the league starts at, an arrow and the player's level in the new frame: badges wider than tall, as
   everywhere else. */
.menu__league-change {
    flex-direction: row;
    align-items: center;
    margin: 26px 0 0 0;
}

.menu__league-small {
    min-width: 128px;
    height: 88px;
    padding: 0 22px;
    border-width: 6px;
    border-bottom-width: 6px;
    border-radius: 26px;
}

.menu__league-small .level-badge__value { font-size: 44px; }

.menu__league-arrow {
    width: 70px;
    height: 46px;
    margin: 0 26px;
}

.menu__league-big {
    min-width: 200px;
    height: 136px;
    padding: 0 34px;
    border-width: 10px;
    border-bottom-width: 10px;
    border-radius: 40px;
}

.menu__league-big .level-badge__value { font-size: 72px; }

.menu__league-caption {
    margin: 34px 0 16px 0;
    padding: 0;
    font-size: 36px;
    letter-spacing: 2px;
    color: var(--muted);
}

.menu__league-gets {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.menu__league-get {
    width: 31%;
    height: 220px;
    padding: 0 10px 20px 10px;
    border-width: 8px;
    border-bottom-width: 16px;
    border-color: var(--navy);
    border-radius: 44px;
    background-color: var(--soft);
    align-items: center;
    justify-content: flex-end;
}

.menu__league-get-picture {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.menu__league-get-label {
    margin: 0;
    padding: 0;
    font-size: 34px;
    color: var(--navy);
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-auto-size: best-fit 20px 34px;
    width: 100%;
}

.menu__league-swatch {
    width: 112px;
    height: 112px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 56px;
    background-size: cover;
}

.menu__league-plinth {
    width: 200px;
    height: 104px;
}

.menu__league-get-badge {
    min-width: 150px;
    height: 104px;
    padding: 0 24px;
    border-width: 8px;
    border-bottom-width: 8px;
    border-radius: 32px;
}

.menu__league-get-badge .level-badge__value { font-size: 50px; }

/* The next league, locked: its emblem greyed under a lock, and when it opens. */
.menu__league-next {
    flex-direction: row;
    align-items: center;
    margin: 34px 0 36px 0;
    padding: 8px 40px 8px 12px;
    border-width: 6px;
    border-bottom-width: 12px;
    border-color: var(--navy);
    border-radius: 60px;
    background-color: var(--soft);
}

.menu__league-next--top {
    padding: 22px 48px;
    background-color: var(--gold);
}

.menu__league-next-emblem {
    width: 104px;
    height: 104px;
    align-items: center;
    justify-content: center;
    -unity-background-image-tint-color: rgb(150, 160, 190);
}

.menu__league-next-lock {
    width: 48px;
    height: 54px;
    margin-top: 6px;
}

.menu__league-next-name {
    margin: 0 0 0 14px;
    padding: 0;
    font-size: 40px;
    color: var(--navy);
    white-space: nowrap;
}

.menu__league-next--top .menu__league-next-name { margin: 0; }

.menu__league-continue {
    width: 100%;
    height: 184px;
    padding-bottom: 34px;
}

.menu__league-continue .button__label { font-size: 80px; }

/* On a wide screen the card is short in the hand: a lower picture and lower tiles keep it readable. */
.menu__league-card--wide .menu__league-frame { height: 360px; }
.menu__league-card--wide .menu__league-stage { padding-bottom: 64px; }
.menu__league-card--wide .menu__league-medal { width: 150px; height: 150px; margin-left: -75px; bottom: -6px; }
.menu__league-card--wide .menu__league-get { height: 170px; }
.menu__league-card--wide .menu__league-get-picture { padding-top: 10px; }
.menu__league-card--wide .menu__league-get-badge { min-width: 116px; height: 78px; padding: 0 18px; border-radius: 24px; }
.menu__league-card--wide .menu__league-get-badge .level-badge__value { font-size: 40px; }
.menu__league-card--wide .menu__league-swatch { width: 92px; height: 92px; }
.menu__league-card--wide .menu__league-plinth { width: 170px; height: 88px; }
.menu__league-card--wide .menu__league-caption { margin: 22px 0 12px 0; }
.menu__league-card--wide .menu__league-next { margin: 24px 0 26px 0; }

.menu__league-key {
    position: absolute;
    top: -40px;
    right: 40px;
    margin: 0;
}

/* The leagues list: full screen in the player's league's sky (set in code), its rays over it. */
.menu__leagues {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--blue);
    background-size: cover;
    display: none;
}

.menu__leagues.menu__popup--open { display: flex; }

.menu__leagues-rays {
    position: absolute;
    left: 50%;
    top: -10%;
    width: 2600px;
    height: 2600px;
    translate: -50% -30%;
}

.menu__leagues-body {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 40px;
    bottom: 50px;
    transform-origin: center top;
}

.menu__leagues-head {
    flex-direction: row;
    align-items: center;
    height: 130px;
    margin-bottom: 40px;
}

.menu__leagues-title-box { flex-grow: 1; }

.menu__leagues-title {
    margin: 0;
    padding: 0;
    font-size: 96px;
    -unity-text-outline-width: 16px;
    text-shadow: 0 12px 0 rgb(29, 43, 79);
}

.menu__leagues-title.stroke__face { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.menu__leagues-key {
    margin: 0 30px 0 0;
}

.menu__leagues-key .key__text { font-size: 30px; }

/* Upright the leagues stand in the middle of what the title and the hint leave, on tall phones too. */
.menu__leagues-list {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
    padding-bottom: 150px;
}

/* A league: the drop behind, the face in its sky; the player's league wears a gold ring and stands taller. */
.menu__league-item {
    margin-bottom: 40px;
}

.menu__league-ring {
    position: absolute;
    left: -18px;
    right: -18px;
    top: -18px;
    bottom: -18px;
    border-width: 14px;
    border-color: var(--gold);
    border-radius: 66px;
}

.menu__league-drop {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    bottom: -12px;
    border-radius: 50px;
    background-color: var(--navy);
}

.menu__league-face {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding: 0 36px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 50px;
    background-size: cover;
    overflow: hidden;
}

.menu__league-rays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* A badge on its own drop: the plate wrapper takes the badge's size, the drop sits under it, shifted down. */
.menu__league-plate { flex-shrink: 0; }

.menu__league-plate-drop {
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    bottom: -11px;
    background-color: var(--navy);
}

.menu__league-row-badge-plate .menu__league-plate-drop { border-radius: 40px; }
.menu__league-card-badge-plate .menu__league-plate-drop { border-radius: 60px; top: 13px; bottom: -13px; }

.menu__league-row { height: 220px; }
.menu__league-row.menu__league-item--current { height: 290px; }

.menu__league-row-badge {
    min-width: 150px;
    height: 136px;
    padding: 0 24px;
    border-width: 8px;
    border-bottom-width: 8px;
    border-radius: 40px;
}

.menu__league-row-badge .level-badge__value { font-size: 64px; }

.menu__league-row-body {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 30px;
    align-items: flex-start;
}

.menu__league-row-name,
.menu__league-card-name {
    margin: 0;
    padding: 0;
    font-size: 64px;
    -unity-text-outline-width: 14px;
    text-shadow: 0 8px 0 rgb(29, 43, 79);
    white-space: nowrap;
}

.menu__league-row-name.stroke__face,
.menu__league-card-name.stroke__face { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.menu__league-from {
    margin: 10px 0 0 0;
    padding: 2px 22px 6px 22px;
    border-radius: 30px;
    background-color: rgba(29, 43, 79, 0.82);
    color: var(--white);
    font-size: 32px;
    letter-spacing: 1px;
    white-space: nowrap;
}

/* The league's emblem (sprite_league_<id>): the art leaves about a tenth of its square empty round it. */
.menu__league-emblem {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.menu__league-emblem--rookie { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_league_rookie.png?fileID=2800000&guid=96f0403b1ad8428db072a16f5541f2e4&type=3#sprite_league_rookie"); }
.menu__league-emblem--bronze { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_league_bronze.png?fileID=2800000&guid=eb9da146546c4e54b5a8f27df1f301a4&type=3#sprite_league_bronze"); }
.menu__league-emblem--silver { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_league_silver.png?fileID=2800000&guid=395f45ffdbbc4d3b8220a10905675d46&type=3#sprite_league_silver"); }
.menu__league-emblem--gold { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_league_gold.png?fileID=2800000&guid=6c4ebb1f509248bc8952c22e18428591&type=3#sprite_league_gold"); }
.menu__league-emblem--legend { background-image: url("project://database/Assets/Art/Sprites/UI/sprite_league_legend.png?fileID=2800000&guid=29769eea00dd4b4c925eeefef2a8c6a2&type=3#sprite_league_legend"); }

.menu__league-row-emblem {
    width: 190px;
    height: 190px;
    margin-right: 18px;
}

.menu__league-done {
    flex-shrink: 0;
    width: 94px;
    height: 94px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 47px;
    background-color: var(--green);
    align-items: center;
    justify-content: center;
}

.menu__league-tick {
    width: 50px;
    height: 50px;
}

.menu__league-lock {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 94px;
    padding: 0 28px 0 18px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 47px;
    background-color: var(--white);
}

.menu__league-lock-icon {
    width: 52px;
    height: 52px;
    margin-right: 10px;
}

.menu__league-lock-text {
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: var(--navy);
    white-space: nowrap;
}

.menu__league-you {
    margin: 0;
    padding: 2px 24px 6px 24px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 30px;
    background-color: var(--gold);
    font-size: 32px;
    letter-spacing: 1px;
    color: var(--navy);
}

.menu__league-row .menu__league-you {
    position: absolute;
    top: 20px;
    right: 26px;
}

/* The bar to the next league: white, the XP blue fill with its dark strip, the level at the left and the goal at the right. */
.menu__league-track {
    align-self: stretch;
    height: 84px;
    margin-top: 16px;
    border-width: 7px;
    border-color: var(--navy);
    border-radius: 42px;
    background-color: var(--white);
    overflow: hidden;
}

.menu__league-track-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--xp);
}

.menu__league-track-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14px;
    background-color: var(--xp-shade);
}

.menu__league-track-text {
    position: absolute;
    left: 30px;
    right: 30px;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.menu__league-track-label {
    margin: 0;
    padding: 0;
    font-size: 36px;
    color: var(--navy);
    white-space: nowrap;
}

.menu__leagues-progress { display: none; }

.menu__leagues-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

.menu__leagues-hint-text {
    margin: 0;
    padding: 18px 44px 22px 44px;
    border-width: 8px;
    border-bottom-width: 16px;
    border-color: var(--navy);
    border-radius: 60px;
    background-color: var(--white);
    font-size: 40px;
    color: var(--navy);
    -unity-text-align: middle-center;
}

/* Wide: five cards from rookie at the left to legend, and the bar to the next league under them. */
.menu__leagues--wide .menu__leagues-body {
    left: 200px;
    right: 200px;
}

.menu__leagues--wide .menu__leagues-list {
    flex-direction: row-reverse;
    flex-grow: 0;
    padding-bottom: 0;
    height: 1040px;
    margin-top: 30px;
}

.menu__league-card-item {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 20px;
}

.menu__league-card-item.menu__league-item--current { translate: 0 -24px; }

.menu__league-card-item > .menu__league-face {
    flex-direction: column;
    padding: 100px 20px 50px 20px;
}

.menu__league-card-badge {
    min-width: 240px;
    height: 206px;
    padding: 0 34px;
    border-width: 10px;
    border-bottom-width: 10px;
    border-radius: 60px;
}

.menu__league-card-badge .level-badge__value { font-size: 104px; }

.menu__league-card-emblem {
    width: 280px;
    height: 280px;
    margin: 20px 0 10px 0;
}

.menu__league-card-name {
    font-size: 86px;
    -unity-text-outline-width: 16px;
    text-shadow: 0 10px 0 rgb(29, 43, 79);
}

.menu__league-card-item .menu__league-from {
    margin-top: 16px;
    font-size: 40px;
    padding: 4px 26px 8px 26px;
}

.menu__league-card-item .menu__league-done {
    width: 130px;
    height: 130px;
    border-radius: 65px;
    border-width: 10px;
}

.menu__league-card-item .menu__league-tick {
    width: 70px;
    height: 70px;
}

.menu__league-card-item .menu__league-lock {
    height: 122px;
    padding: 0 38px 0 24px;
    border-width: 10px;
    border-radius: 61px;
}

.menu__league-card-item .menu__league-lock-icon {
    width: 70px;
    height: 70px;
}

.menu__league-card-item .menu__league-lock-text { font-size: 54px; }

.menu__league-card-item .menu__league-you {
    font-size: 54px;
    padding: 10px 40px 14px 40px;
    border-width: 10px;
    border-radius: 61px;
}

.menu__leagues--wide .menu__leagues-progress {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin: 60px 20px 0 20px;
}

.menu__leagues-progress .menu__league-track {
    flex-grow: 1;
    margin: 0 30px;
}

.menu__leagues-progress-badge {
    min-width: 128px;
    height: 108px;
    padding: 0 18px;
    border-width: 7px;
    border-bottom-width: 7px;
    border-radius: 32px;
}

.menu__leagues-progress-badge .level-badge__value { font-size: 50px; }

/* -- DAILY, on top of the right rail, and its gift (macket MenuB_Daily) ------------------------------------------------ */

/* The tile: a gift box, the time to the next gift on a navy pill across its bottom edge, READY on a green one and the
   red dot while today's waits. Its key goes to the top left: the pill takes the bottom. */
.menu__tile--daily .menu__tile-caption { margin-top: 26px; }

.menu__daily-time {
    position: absolute;
    bottom: -26px;
    align-self: center;
    padding: 2px 16px 4px 16px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--navy);
    font-size: 28px;
    color: var(--white);
    white-space: nowrap;
}

.menu__tile--daily-ready .menu__daily-time { background-color: var(--green); }

/* The popup: a gold tilted title over the calendar. */
.menu__daily-popup .menu__sheet-head { margin-bottom: 4px; }
.menu__daily-popup .menu__sheet-head > .stroke { rotate: -4deg; }
.menu__daily-popup .menu__sheet-title { color: var(--gold); }
.menu--wide .menu__daily-popup .menu__sheet { width: 1760px; }

.menu__daily-streak {
    align-self: center;
    margin: 0 0 30px 0;
    padding: 4px 28px 6px 28px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--orange);
    font-size: 34px;
    color: var(--navy);
    rotate: -2deg;
}

/* Four cells a row upright (the last day two wide), the seven days in one row sideways. */
.menu__daily-days {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.menu__daily-day {
    width: 23%;
    height: 250px;
    margin: 12px 1%;
    padding: 10px 0 12px 0;
    align-items: center;
    justify-content: space-between;
    border-width: 6px;
    border-bottom-width: 11px;
    border-color: var(--navy);
    border-radius: 30px;
    background-color: var(--white);
}

.menu__daily-day--big { width: 48%; background-color: var(--purple); }
.menu--wide .menu__daily-day { width: 11.5%; margin: 12px 0.5%; }
.menu--wide .menu__daily-day--big { width: 23.5%; }

.menu__daily-caption {
    margin: 0;
    padding: 0;
    font-size: 30px;
    color: var(--muted);
}

.menu__daily-art {
    flex-grow: 1;
    align-self: stretch;
    align-items: center;
    justify-content: center;
}

.menu__daily-amount {
    margin: 0;
    padding: 0;
    font-size: 42px;
    color: var(--navy);
    white-space: nowrap;
}

.menu__daily-day--big .menu__daily-caption,
.menu__daily-day--big .menu__daily-amount { color: var(--white); }
.menu__daily-day--big .menu__daily-amount { font-size: 34px; }

/* A pile of coins growing day by day (MenuDaily.CoinPile, painter2D), stood on the bottom of the art. */
.menu__daily-pile { width: 160px; height: 120px; flex-shrink: 1; }

.menu__daily-gift { width: 110px; height: 110px; }
.menu__daily-hat { width: 170px; height: 110px; }

/* Taken: pale, with a green tick in the corner. */
.menu__daily-tick {
    position: absolute;
    top: -18px;
    right: -14px;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--green);
    display: none;
}

.menu__daily-tick .mission__mark { opacity: 1; border-color: var(--white); width: 11px; height: 20px; border-right-width: 5px; border-bottom-width: 5px; }

.menu__daily-day--done { background-color: #e3e8f1; }
.menu__daily-day--done.menu__daily-day--big { background-color: #b9a6d9; }
.menu__daily-day--done .menu__daily-caption,
.menu__daily-day--done .menu__daily-art,
.menu__daily-day--done .menu__daily-amount { opacity: 0.55; }
.menu__daily-day--done .menu__daily-tick { display: flex; }
/* The pile draws itself pale: under opacity its overlapping coins would show each other's outlines. */
.menu__daily-day--done .menu__daily-art--pile { opacity: 1; }

/* Today: cream, ringed in gold and lifted. */
.menu__daily-day--today {
    border-color: var(--gold);
    border-width: 9px;
    border-bottom-width: 14px;
    background-color: #fff4c7;
    translate: 0 -12px;
    scale: 1.06 1.06;
}

.menu__daily-day--today .menu__daily-caption,
.menu__daily-day--today .menu__daily-amount { color: var(--navy); }

/* The hat just given: a pale face, the hat and its name at full strength. */
.menu__daily-day--hat.menu__daily-day--big { background-color: #efe6ff; }
.menu__daily-day--hat .menu__daily-art { opacity: 1; }
.menu__daily-day--hat .menu__daily-amount { opacity: 1; color: var(--navy); }
.menu__daily-day--hat .menu__daily-caption { color: var(--navy); }
.menu__daily-day--today.menu__daily-day--done { translate: 0 0; scale: 1 1; border-color: var(--navy); border-width: 6px; border-bottom-width: 11px; }

.menu__daily-hint {
    margin: 26px 0 34px 0;
    padding: 0;
    font-size: 36px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* CLAIM ×2 (purple, a gold AD tag at the top left) and CLAIM side by side; CLAIM alone fills the row. Well clear of
   the calendar: the AD tag and the key caps on their top edges stand 26px over the buttons. */
.menu__daily-buttons { flex-direction: row; margin-top: 58px; }

.menu__daily-double,
.menu__daily-claim {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 160px;
    padding: 0 24px 20px 24px;
}

.menu__daily-double { flex-grow: 1.3; margin-right: 26px; }
.menu__daily-double .double__play { flex-shrink: 0; width: 64px; height: 64px; margin-right: 14px; }

.menu__daily-label { flex-grow: 0; flex-shrink: 1; min-width: 0; }

/* CLAIM, then a coin and the amount it gives (CLAIM x2's already doubled), together in the middle of the button. */
.menu__daily-double,
.menu__daily-claim { justify-content: center; }

.menu__daily-sum {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-left: 18px;
}

.menu__daily-sum-coin {
    width: 56px;
    height: 56px;
    margin-right: 10px;
}

.menu__daily-label-text {
    font-size: 64px;
    -unity-text-outline-width: 11px;
    text-shadow: 0 6px 0 rgb(29, 43, 79);
}

.menu__daily-label-text.stroke__face { -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.menu__daily-ad {
    position: absolute;
    top: -26px;
    left: 24px;
    padding: 2px 16px 4px 16px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--gold);
    font-size: 28px;
    color: var(--navy);
}

.menu__daily-key {
    display: none;
    position: absolute;
    top: -22px;
    right: 24px;
    margin: 0;
    padding: 0 12px 2px 12px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
}

.menu__daily-key .key__text { font-size: 26px; }
.menu--desktop .menu__daily-key { display: flex; }

.menu__daily-continue {
    align-self: center;
    min-width: 60%;
    height: 130px;
    padding: 0 60px 16px 60px;
}

.menu__daily-continue-label { font-size: 52px; color: var(--navy); }
