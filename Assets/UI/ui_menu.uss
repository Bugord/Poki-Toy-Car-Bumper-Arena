/* The main menu (MenuView builds it): a showroom over the drifting checker of the garage and the lobby, on the sky
   blue of the theme. The player's car turns on a 3D pedestal over slow white rays in the middle, the level, XP and coins run along the top, a rail of tiles (GARAGE, MISSIONS, AWARDS) stands at the left,
   and the nearest mission, the mode and PLAY sit at the bottom. The design is MenuB in Claude Design
   (claude.ai/artifact/PWuwUnPztaKrVyjfKk4Xev).

   A sticker's dark drop here is its own layer behind the face (menu__drop), never a thicker bottom border, so the
   content stays centred on the face. Sizes are reference pixels of the 1080x1920 panel; MenuView scales the anchored
   groups up on a phone held sideways, where the Expand panel is small. */

.menu {
    background-color: var(--blue);
    color: var(--navy);
    overflow: hidden;
}

.menu__spacer {
    flex-grow: 1;
}

/* -- Stickers ------------------------------------------------------------------------------------------------------ */

.menu__sticker {
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.menu__drop {
    position: absolute;
    left: 0;
    right: 0;
    top: 14px;
    bottom: -14px;
    border-radius: 40px;
    background-color: var(--navy);
}

.menu__face {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 40px;
    background-color: var(--white);
    align-items: center;
    justify-content: center;
    transition-property: translate;
    transition-duration: 0.08s;
}

.menu__sticker:hover > .menu__face { background-color: var(--soft); }
.menu__sticker:active > .menu__face { translate: 0 10px; }

/* -- Top bar ------------------------------------------------------------------------------------------------------- */

.menu__top {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 40px;
    flex-direction: row;
    align-items: center;
    transform-origin: left top;
}

.menu__level {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    width: 640px;
    height: 120px;
}

.menu__level-badge {
    position: absolute;
    left: 0;
    top: 0;
}

.menu__level .level-badge {
    min-width: 120px;
    height: 120px;
    border-width: 8px;
    border-bottom-width: 8px;
    border-radius: 30px;
}

.menu__level .level-badge__value { font-size: 64px; }

.menu__xp {
    flex-grow: 1;
    height: 84px;
    margin-left: 94px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    overflow: hidden;
}

.menu__xp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--gold);
}

.menu__xp-text {
    position: absolute;
    left: 46px;
    right: 24px;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.menu__rank,
.menu__xp-count {
    margin: 0;
    padding: 0;
    font-size: 36px;
    color: var(--navy);
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.menu__xp-count { -unity-text-align: middle-right; }

.menu__coins {
    flex-direction: row;
    align-items: center;
    height: 96px;
    margin-left: 24px;
    padding: 0 30px 0 18px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
}

.menu__coins-count {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 48px;
    color: var(--navy);
}

.menu__gear {
    width: 112px;
    height: 112px;
    margin: 0 0 14px 24px;
}

.menu__gear > .menu__drop,
.menu__gear > .menu__face { border-radius: 999px; }

/* -- Rail ---------------------------------------------------------------------------------------------------------- */

.menu__rail {
    position: absolute;
    left: 40px;
    top: 220px;
    align-items: center;
    transform-origin: left top;
}

.menu__tile {
    align-items: center;
    margin-bottom: 26px;
}

.menu__tile-button {
    width: 150px;
    height: 150px;
    margin-bottom: 14px;
}

.menu__tile-caption {
    margin: 6px 0 0 0;
    padding: 0;
    font-size: 36px;
    -unity-text-outline-width: 9px;
    text-shadow: 0 7px 0 rgb(29, 43, 79);
}

.menu__tile-caption.stroke__face { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.menu__tile--locked .menu__face { background-color: #dfe6f1; }

.menu__icon {
    width: 86px;
    height: 86px;
}

.menu__new {
    position: absolute;
    top: -24px;
    right: -30px;
    padding: 2px 16px 4px 16px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--gold);
    font-size: 28px;
    color: var(--navy);
    display: none;
}

.menu__dot {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 46px;
    height: 46px;
    border-width: 6px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--red);
    display: none;
}

.menu__tile--new .menu__new { display: flex; }
.menu__tile--dot .menu__dot { display: flex; }
/* NEW sits in the corner the dot would take; the dot moves down under it. */
.menu__tile--new.menu__tile--dot .menu__dot { top: 36px; right: -24px; }

.menu__key {
    position: absolute;
    right: -18px;
    bottom: -10px;
    margin: 0;
    padding: 0 12px 2px 12px;
    border-width: 5px;
    border-bottom-width: 9px;
    border-radius: 12px;
    display: none;
}

.menu__key .key__text { font-size: 28px; }

.menu--desktop .menu__key { display: flex; }

/* -- The car -------------------------------------------------------------------------------------------------------- */

.menu__stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 240px;
    bottom: 560px;
}

.menu__rays {
    position: absolute;
    transform-origin: center;
}

.menu__plinth {
    position: absolute;
    left: 50%;
    bottom: 150px;
    width: 600px;
    height: 220px;
    translate: -50% 0;
    transform-origin: center bottom;
}

.menu__plinth-base,
.menu__plinth-top {
    position: absolute;
    left: 0;
    right: 0;
    height: 150px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 50%;
}

.menu__plinth-base {
    bottom: 0;
    background-color: var(--shade);
}

.menu__plinth-side {
    position: absolute;
    left: 0;
    right: 0;
    top: 75px;
    bottom: 75px;
    border-left-width: 8px;
    border-right-width: 8px;
    border-color: var(--navy);
    background-color: var(--shade);
}

.menu__plinth-top {
    top: 0;
    background-color: var(--white);
}

.menu__hero {
    position: absolute;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.menu__hero-portrait {
    position: absolute;
    width: 600px;
    height: 600px;
}

.menu__car-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    align-items: center;
}

.menu__car-name-text {
    margin: 0;
    padding: 0;
    font-size: 96px;
    -unity-text-outline-width: 16px;
    text-shadow: 0 14px 0 rgb(29, 43, 79);
}

/* -- Bottom: the nearest mission, the mode and PLAY ----------------------------------------------------------------- */

.menu__bottom {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 50px;
    transform-origin: left bottom;
}

.menu__mission {
    height: 150px;
    margin-bottom: 40px;
}

.menu__mission > .menu__face {
    flex-direction: row;
    padding: 0 30px 0 22px;
    justify-content: flex-start;
}

.menu__mission-icon {
    width: 82px;
    height: 82px;
    flex-shrink: 0;
}

.menu__mission-body {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 20px;
}

.menu__mission-head {
    flex-direction: row;
    align-items: center;
}

.menu__mission-task {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: var(--navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.menu__mission-count {
    flex-shrink: 0;
    margin: 0 0 0 14px;
    padding: 0;
    font-size: 38px;
    color: var(--muted);
}

.menu__bar {
    height: 30px;
    margin-top: 8px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--track);
    overflow: hidden;
}

.menu__bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background-color: var(--gold);
}

.menu__reward {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.menu__reward-count {
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 40px;
    color: var(--navy);
}

.menu__actions {
    flex-direction: row;
    align-items: stretch;
    height: 210px;
}

.menu__mode {
    width: 420px;
    height: 196px;
    margin-right: 30px;
}

.menu__mode > .menu__face {
    flex-direction: row;
    justify-content: space-between;
    padding: 0 26px 0 36px;
}

.menu__mode-caption {
    margin: 0;
    padding: 0;
    font-size: 30px;
    letter-spacing: 2px;
    color: var(--muted);
}

/* Shrinks with the card, so a long name (BYSTRYI MATCH) shrinks instead of running under the chevron. */
.menu__mode-texts {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 10px;
}

.menu__mode-name {
    margin: 0;
    padding: 0;
    font-size: 46px;
    color: var(--navy);
    white-space: nowrap;
    -unity-text-auto-size: best-fit 26px 46px;
}

.menu__chevron {
    flex-shrink: 0;
    width: 40px;
    height: 56px;
}

.menu__play {
    flex-grow: 1;
    min-width: 0;
    height: 210px;
    padding-bottom: 40px;
}

.menu__play .button__label { font-size: 112px; }

.menu__play-key {
    position: absolute;
    top: -40px;
    right: 30px;
    margin: 0;
    display: none;
}

.menu--desktop .menu__play-key { display: flex; }

/* Wide: one row at the bottom, the mission at the left and the mode and PLAY at the right. */
.menu--wide .menu__bottom {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.menu--wide .menu__mission {
    width: 860px;
    margin: 0 0 30px 0;
}

.menu--wide .menu__actions { width: 1060px; }

.menu--wide .menu__stage {
    top: 260px;
    bottom: 330px;
}

/* -- Popups: the missions and the modes over a dim, in a white card ----------------------------------------------- */

.menu__popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(29, 43, 79, 0.6);
    display: none;
}

.menu__popup--open { display: flex; }

.menu__sheet {
    width: 960px;
    padding: 40px 44px 50px 44px;
    align-items: stretch;
    transform-origin: center;
}

.menu__sheet-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 120px;
    margin-bottom: 26px;
}

.menu__sheet-title {
    margin: 0;
    padding: 0;
    font-size: 76px;
    -unity-text-outline-width: 14px;
    text-shadow: 0 12px 0 rgb(29, 43, 79);
}

.menu__close {
    width: 112px;
    height: 112px;
    margin-bottom: 14px;
}

.menu__close > .menu__drop,
.menu__close > .menu__face { border-radius: 999px; }

.menu__close-bar {
    position: absolute;
    width: 52px;
    height: 13px;
    border-radius: 7px;
    background-color: var(--navy);
    rotate: 45deg;
}

.menu__close-bar--turned { rotate: -45deg; }

.menu__sheet .mission {
    height: 120px;
    padding: 0 26px;
    margin-bottom: 18px;
    border-radius: 36px;
    background-color: var(--soft);
}

.menu__sheet .mission__check {
    width: 64px;
    height: 64px;
}

.menu__sheet .mission__task {
    font-size: 40px;
    white-space: normal;
}

.menu__sheet .mission__progress {
    font-size: 42px;
    margin: 0 18px;
}

.menu__sheet .menu__reward-count { font-size: 42px; }

.menu__modes-play {
    height: 190px;
    margin-top: 24px;
    padding-bottom: 36px;
}

.menu__modes-play .button__label { font-size: 96px; }

.menu__mode-card {
    flex-direction: row;
    align-items: center;
    min-height: 170px;
    margin-bottom: 20px;
    padding: 20px 26px 20px 34px;
    border-width: 8px;
    border-color: var(--navy);
    border-radius: 40px;
    background-color: var(--soft);
}

.menu__mode-card--selected {
    min-height: 230px;
    border-color: var(--green-shade);
    background-color: var(--white);
}

.menu__mode-card--locked { opacity: 0.85; }

.menu__mode-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.menu__mode-card-name {
    margin: 0;
    padding: 0;
    font-size: 54px;
    color: var(--navy);
}

.menu__mode-card--locked .menu__mode-card-name { font-size: 44px; color: var(--muted); }

.menu__mode-hint {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 32px;
    color: var(--muted);
    white-space: normal;
}

.menu__mode-portrait {
    flex-shrink: 0;
    width: 220px;
    height: 180px;
}

.menu__mode-lock {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    margin-right: 22px;
}

.menu__tag {
    flex-shrink: 0;
    margin: 0 0 0 16px;
    padding: 4px 18px 6px 18px;
    border-width: 5px;
    border-color: var(--navy);
    border-radius: 999px;
    background-color: var(--white);
    font-size: 28px;
    color: var(--navy);
}

.menu__tag--selected {
    position: absolute;
    top: -22px;
    right: 30px;
    margin: 0;
    background-color: var(--green);
    color: var(--navy);
}
