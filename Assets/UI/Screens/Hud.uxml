<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud" picking-mode="Ignore" class="hud">
        <Style src="../ui_screens.uss" />
        <ui:VisualElement name="time-pill" picking-mode="Ignore" class="pill hud__timer">
            <ui:VisualElement picking-mode="Ignore" class="watch">
                <ui:VisualElement picking-mode="Ignore" class="watch__knob" />
                <ui:VisualElement picking-mode="Ignore" class="watch__hand" />
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="stroke hud__time">
                <ui:Label name="time" text="0:00" picking-mode="Ignore" class="hud__time-text" />
                <ui:Label name="time-face" text="0:00" picking-mode="Ignore" class="hud__time-text stroke__face" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cars-plate" picking-mode="Ignore" class="plate hud__cars">
            <ui:VisualElement name="pips" picking-mode="Ignore" class="hud__pips" />
            <ui:Label name="cars" text="0 LEFT" picking-mode="Ignore" class="hud__cars-text" />
        </ui:VisualElement>
        <ui:VisualElement name="ko-badge" picking-mode="Ignore" class="pill hud__ko">
            <ui:VisualElement picking-mode="Ignore" class="ko-star">
                <ui:VisualElement picking-mode="Ignore" class="ko-star__back" />
                <ui:VisualElement picking-mode="Ignore" class="ko-star__back ko-star__turned" />
                <ui:VisualElement picking-mode="Ignore" class="ko-star__front" />
                <ui:VisualElement picking-mode="Ignore" class="ko-star__front ko-star__turned" />
            </ui:VisualElement>
            <ui:Label name="ko" text="KO 0" picking-mode="Ignore" class="hud__ko-text" />
        </ui:VisualElement>
        <ui:VisualElement name="ko-layer" picking-mode="Ignore" class="hud__popups" />
        <ui:VisualElement name="boost-button" class="hud__boost">
            <ui:VisualElement name="boost-charge" picking-mode="Ignore" class="hud__boost-charge" />
            <ui:VisualElement picking-mode="Ignore" class="stroke hud__boost-label">
                <ui:Label text="BOOST" picking-mode="Ignore" class="hud__boost-text" />
                <ui:Label text="BOOST" picking-mode="Ignore" class="hud__boost-text stroke__face" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
