<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud" picking-mode="Ignore" class="hud">
        <Style src="../ui_screens.uss" />
        <ui:VisualElement name="name-layer" picking-mode="Ignore" class="hud__popups" />
        <ui:VisualElement name="shield" picking-mode="Ignore" class="hud__shield">
            <ui:VisualElement picking-mode="Ignore" class="hud__shield-sticker">
                <ui:VisualElement picking-mode="Ignore" class="stroke">
                    <ui:Label text="SAFE" picking-mode="Ignore" class="hud__shield-text">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="hud.safe" />
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="SAFE" picking-mode="Ignore" class="hud__shield-text stroke__face">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="hud.safe" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="hud__shield-bar">
                    <ui:VisualElement name="shield-fill" picking-mode="Ignore" class="hud__shield-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="emotion-layer" picking-mode="Ignore" class="hud__popups" />
        <ui:VisualElement name="feed" picking-mode="Ignore" class="feed" />
        <ui:VisualElement name="scoreboard" picking-mode="Ignore" class="scoreboard" />
        <ui:VisualElement name="hud-bar" picking-mode="Ignore" class="pill hud__bar">
        <ui:VisualElement name="time-pill" picking-mode="Ignore" class="hud__section hud__timer">
            <ui:VisualElement picking-mode="Ignore" class="watch">
                <ui:VisualElement picking-mode="Ignore" class="watch__knob" />
                <ui:VisualElement picking-mode="Ignore" class="watch__hand" />
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="stroke hud__time">
                <ui:Label name="time" text="0:00" picking-mode="Ignore" class="hud__time-text" />
                <ui:Label name="time-face" text="0:00" picking-mode="Ignore" class="hud__time-text stroke__face" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cars-pill" picking-mode="Ignore" class="hud__section hud__cars">
            <ui:VisualElement picking-mode="Ignore" class="hud__sep" />
            <ui:VisualElement name="chips" picking-mode="Ignore" class="hud__chips" />
            <ui:Label name="cars-left" text="0" picking-mode="Ignore" class="hud__cars-count" />
        </ui:VisualElement>
        <ui:VisualElement name="ko-badge" picking-mode="Ignore" class="hud__section hud__ko">
            <ui:VisualElement picking-mode="Ignore" class="hud__sep" />
            <ui:VisualElement picking-mode="Ignore" class="ko-star">
                <ui:VisualElement picking-mode="Ignore" class="ko-star__back" />
                <ui:VisualElement picking-mode="Ignore" class="ko-star__back ko-star__turned" />
                <ui:VisualElement picking-mode="Ignore" class="ko-star__front" />
                <ui:VisualElement picking-mode="Ignore" class="ko-star__front ko-star__turned" />
            </ui:VisualElement>
            <ui:Label name="ko" text="0" picking-mode="Ignore" class="hud__ko-text" />
        </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="start" picking-mode="Ignore" class="hud__start">
            <ui:VisualElement name="start-goal" picking-mode="Ignore" class="stroke hud__start-goal">
                <ui:Label text="PUSH EVERYONE OFF!" picking-mode="Ignore" class="hud__start-goal-text">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.goal" />
                    </Bindings>
                </ui:Label>
                <ui:Label text="PUSH EVERYONE OFF!" picking-mode="Ignore" class="hud__start-goal-text stroke__face">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.goal" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="stroke hud__start-prompt">
                <ui:Label name="start-text" text="TAP TO START" picking-mode="Ignore" class="hud__start-text" />
                <ui:Label name="start-text-face" text="TAP TO START" picking-mode="Ignore" class="hud__start-text stroke__face" />
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="hud__start-hint hud__start-hint--touch">
                <ui:VisualElement picking-mode="Ignore" class="hud__start-boost-dot" />
                <ui:Label text="TAP TO BOOST" picking-mode="Ignore" class="hud__start-hint-text hud__start-boost-text">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.tap_to_boost" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="hud__start-hint hud__start-hint--desktop">
                <ui:VisualElement picking-mode="Ignore" class="hud__start-mouse">
                    <ui:VisualElement picking-mode="Ignore" class="hud__start-mouse-button" />
                    <ui:VisualElement picking-mode="Ignore" class="hud__start-mouse-line" />
                </ui:VisualElement>
                <ui:Label text="HOLD TO DRIVE" picking-mode="Ignore" class="hud__start-hint-text">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.hold_to_drive" />
                    </Bindings>
                </ui:Label>
                <ui:VisualElement picking-mode="Ignore" class="key hud__start-key">
                    <ui:Label text="SPACE" picking-mode="Ignore" class="key__text">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="common.space" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Label text="BOOST" picking-mode="Ignore" class="hud__start-hint-text hud__start-boost-text">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.boost" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ghost" picking-mode="Ignore" class="hud__ghost hud__stick--shown">
            <ui:VisualElement name="ghost-stick" picking-mode="Ignore" class="hud__ghost-stick">
                <ui:VisualElement name="ghost-base" picking-mode="Ignore" class="hud__stick-base" />
                <ui:VisualElement name="ghost-knob" picking-mode="Ignore" class="hud__stick-knob" />
            </ui:VisualElement>
            <ui:VisualElement name="ghost-finger" picking-mode="Ignore" class="hud__ghost-finger" />
            <ui:VisualElement picking-mode="Ignore" class="stroke hud__ghost-caption">
                <ui:Label text="DRAG TO DRIVE" picking-mode="Ignore" class="hud__teaching-text">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.drag_to_drive" />
                    </Bindings>
                </ui:Label>
                <ui:Label text="DRAG TO DRIVE" picking-mode="Ignore" class="hud__teaching-text stroke__face">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.drag_to_drive" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="stick" picking-mode="Ignore" class="hud__stick">
            <ui:VisualElement name="stick-base" picking-mode="Ignore" class="hud__stick-base" />
            <ui:VisualElement name="stick-knob" picking-mode="Ignore" class="hud__stick-knob" />
        </ui:VisualElement>
        <ui:VisualElement name="tap-hint" picking-mode="Ignore" class="hud__tap-hint">
            <ui:VisualElement picking-mode="Ignore" class="stroke">
                <ui:Label text="TAP TO BOOST" picking-mode="Ignore" class="hud__teaching-text">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.tap_to_boost" />
                    </Bindings>
                </ui:Label>
                <ui:Label text="TAP TO BOOST" picking-mode="Ignore" class="hud__teaching-text stroke__face">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.tap_to_boost" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="settings-button" class="pill gear-button hud__settings">
            <ui:VisualElement picking-mode="Ignore" class="gear">
                <ui:VisualElement picking-mode="Ignore" class="gear__tooth" />
                <ui:VisualElement picking-mode="Ignore" class="gear__tooth gear__tooth--45" />
                <ui:VisualElement picking-mode="Ignore" class="gear__tooth gear__tooth--90" />
                <ui:VisualElement picking-mode="Ignore" class="gear__tooth gear__tooth--135" />
                <ui:VisualElement picking-mode="Ignore" class="gear__hub">
                    <ui:VisualElement picking-mode="Ignore" class="gear__hole" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:Button>
        <ui:VisualElement name="ko-layer" picking-mode="Ignore" class="hud__popups" />
        <ui:VisualElement name="respawn" picking-mode="Ignore" class="hud__respawn">
            <ui:VisualElement picking-mode="Ignore" class="pill hud__respawn-sticker">
                <ui:Label text="BACK IN" picking-mode="Ignore" class="hud__respawn-text">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="hud.back_in" />
                    </Bindings>
                </ui:Label>
                <ui:VisualElement picking-mode="Ignore" class="stroke hud__respawn-count">
                    <ui:Label name="respawn-count" text="2" picking-mode="Ignore" class="hud__respawn-number" />
                    <ui:Label name="respawn-count-face" text="2" picking-mode="Ignore" class="hud__respawn-number stroke__face" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="boost-slot" picking-mode="Ignore" class="hud__boost-slot">
            <ui:VisualElement name="power" picking-mode="Ignore" class="pill hud__power">
                <ui:VisualElement name="power-icon" picking-mode="Ignore" class="hud__power-icon">
                    <ui:VisualElement picking-mode="Ignore" class="hud__power-glyph" />
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="hud__power-info">
                    <ui:Label name="power-name" text="HEAVY!" picking-mode="Ignore" class="hud__power-name" />
                    <ui:VisualElement picking-mode="Ignore" class="hud__power-bar">
                        <ui:VisualElement name="power-fill" picking-mode="Ignore" class="hud__power-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="item-button" class="hud__item">
                <ui:VisualElement name="item-icon" picking-mode="Ignore" class="hud__item-icon">
                    <ui:VisualElement picking-mode="Ignore" class="hud__item-glyph">
                        <ui:VisualElement picking-mode="Ignore" class="hud__item-glyph-part" />
                    </ui:VisualElement>
                    <ui:Label text="?" picking-mode="Ignore" class="hud__item-mark" />
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="key hud__item-key">
                    <ui:Label text="E" picking-mode="Ignore" class="key__text hud__item-key-text" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="item-hint" picking-mode="Ignore" class="hud__item-hint">
                <ui:VisualElement picking-mode="Ignore" class="pill hud__item-hint-label">
                    <ui:VisualElement picking-mode="Ignore" class="stroke">
                        <ui:Label name="item-hint-text" text="TAP TO USE" picking-mode="Ignore" class="hud__teaching-text hud__item-hint-text" />
                        <ui:Label name="item-hint-face" text="TAP TO USE" picking-mode="Ignore" class="hud__teaching-text hud__item-hint-text stroke__face" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="hud__boost-hint-arrow hud__item-hint-arrow">
                    <ui:VisualElement picking-mode="Ignore" class="hud__boost-hint-arrow-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="boost-button" class="hud__boost">
                <ui:VisualElement name="boost-charge" picking-mode="Ignore" class="hud__boost-charge" />
                <ui:VisualElement picking-mode="Ignore" class="stroke hud__boost-label">
                    <ui:Label text="BOOST" picking-mode="Ignore" class="hud__boost-text">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="hud.boost" />
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="BOOST" picking-mode="Ignore" class="hud__boost-text stroke__face">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="hud.boost" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="key hud__boost-key">
                    <ui:Label text="SPACE" picking-mode="Ignore" class="key__text hud__boost-key-text">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="common.space" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="boost-hint" picking-mode="Ignore" class="hud__boost-hint">
                <ui:VisualElement picking-mode="Ignore" class="pill hud__boost-hint-label">
                    <ui:VisualElement picking-mode="Ignore" class="stroke">
                        <ui:Label text="TAP!" picking-mode="Ignore" class="hud__teaching-text">
                            <Bindings>
                                <Bugord.App.Localization.LocalizedText property="text" key="hud.tap" />
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="TAP!" picking-mode="Ignore" class="hud__teaching-text stroke__face">
                            <Bindings>
                                <Bugord.App.Localization.LocalizedText property="text" key="hud.tap" />
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="hud__boost-hint-arrow">
                    <ui:VisualElement picking-mode="Ignore" class="hud__boost-hint-arrow-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
