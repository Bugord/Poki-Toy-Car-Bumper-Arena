<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="garage" class="screen garage">
        <Style src="../ui_screens.uss" />
        <ui:VisualElement picking-mode="Ignore" class="stroke garage__title">
            <ui:Label text="GARAGE" picking-mode="Ignore" class="display garage__title-text" />
            <ui:Label text="GARAGE" picking-mode="Ignore" class="display garage__title-text stroke__face" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="garage__preview">
            <ui:VisualElement name="garage-preview" picking-mode="Ignore" class="car-portrait garage__preview-car" />
            <ui:VisualElement picking-mode="Ignore" class="garage__preview-copy">
                <ui:Label text="DRIVING NEXT" picking-mode="Ignore" class="garage__preview-caption" />
                <ui:VisualElement picking-mode="Ignore" class="stroke">
                    <ui:Label name="garage-preview-name" picking-mode="Ignore" class="display garage__preview-name" />
                    <ui:Label name="garage-preview-name-face" picking-mode="Ignore" class="display garage__preview-name stroke__face" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="garage-colors" picking-mode="Ignore" class="garage__colors" />
        <ui:VisualElement name="garage-grid" picking-mode="Ignore" class="garage__grid" />
        <ui:Button name="garage-play" class="button button--green button--big garage__play">
            <ui:VisualElement picking-mode="Ignore" class="button__face" />
            <ui:VisualElement picking-mode="Ignore" class="stroke">
                <ui:Label text="NEXT MATCH" picking-mode="Ignore" class="button__label" />
                <ui:Label text="NEXT MATCH" picking-mode="Ignore" class="button__label stroke__face" />
            </ui:VisualElement>
        </ui:Button>
        <ui:Button name="settings-button" class="pill gear-button garage__settings">
            <ui:VisualElement picking-mode="Ignore" class="gear">
                <ui:VisualElement picking-mode="Ignore" class="gear__tooth" />
                <ui:VisualElement picking-mode="Ignore" class="gear__tooth gear__tooth--45" />
                <ui:VisualElement picking-mode="Ignore" class="gear__tooth gear__tooth--90" />
                <ui:VisualElement picking-mode="Ignore" class="gear__tooth gear__tooth--135" />
                <ui:VisualElement picking-mode="Ignore" class="gear__hub">
                    <ui:VisualElement picking-mode="Ignore" class="gear__hole" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:Button>
        <ui:Button name="garage-close" class="pill garage__close">
            <ui:VisualElement picking-mode="Ignore" class="garage__close-bar" />
            <ui:VisualElement picking-mode="Ignore" class="garage__close-bar garage__close-bar--turned" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
