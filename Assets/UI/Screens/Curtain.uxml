<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="curtain" class="curtain">
        <Style src="../ui_screens.uss" />
        <ui:VisualElement name="lobby" class="lobby" picking-mode="Ignore">
            <ui:Label name="lobby-title" text="FINDING PLAYERS..." class="lobby__title display stroke">
                <ui:Label name="lobby-title-face" text="FINDING PLAYERS..." class="lobby__title display stroke__face" />
            </ui:Label>
            <ui:VisualElement name="lobby-arena" class="lobby__arena" picking-mode="Ignore" />
            <ui:VisualElement name="lobby-rows" class="lobby__rows" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
