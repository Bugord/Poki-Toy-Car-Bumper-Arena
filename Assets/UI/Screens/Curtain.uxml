<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="curtain" class="curtain">
        <Style src="../ui_screens.uss" />
        <ui:VisualElement name="lobby" class="lobby" picking-mode="Ignore">
            <ui:VisualElement name="lobby-title" picking-mode="Ignore" class="stroke lobby__title">
                <ui:Label text="MATCH FOUND!" picking-mode="Ignore" class="display lobby__title-text" />
                <ui:Label text="MATCH FOUND!" picking-mode="Ignore" class="display lobby__title-text stroke__face" />
            </ui:VisualElement>
            <ui:VisualElement name="lobby-arena" class="lobby__arena" picking-mode="Ignore" />
            <ui:VisualElement name="lobby-rows" class="lobby__rows" />
            <ui:VisualElement class="lobby__loading" picking-mode="Ignore">
                <ui:VisualElement class="lobby__bar" picking-mode="Ignore">
                    <ui:VisualElement name="lobby-bar-fill" class="lobby__bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="lobby-loading-text" text="PLAYERS 1/7" class="lobby__loading-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="lobby-tip" class="lobby__tip" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
