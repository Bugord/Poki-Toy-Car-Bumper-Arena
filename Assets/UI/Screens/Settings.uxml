<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="settings" class="screen screen--dimmed settings">
        <Style src="../ui_screens.uss" />
        <ui:VisualElement class="card settings__card">
            <ui:VisualElement picking-mode="Ignore" class="stroke settings__title">
                <ui:Label text="SETTINGS" picking-mode="Ignore" class="display settings__title-text">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="settings.title" />
                    </Bindings>
                </ui:Label>
                <ui:Label text="SETTINGS" picking-mode="Ignore" class="display settings__title-text stroke__face">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="settings.title" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement class="settings__toggles">
                <ui:VisualElement class="settings__column">
                    <ui:Button name="music-toggle" class="settings__toggle settings__toggle--music">
                        <ui:VisualElement picking-mode="Ignore" class="settings__toggle-icon" />
                    </ui:Button>
                    <ui:Label text="MUSIC" picking-mode="Ignore" class="caption settings__caption">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="settings.music" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement class="settings__column settings__column--second">
                    <ui:Button name="sound-toggle" class="settings__toggle settings__toggle--sound">
                        <ui:VisualElement picking-mode="Ignore" class="settings__toggle-icon" />
                    </ui:Button>
                    <ui:Label text="SOUND" picking-mode="Ignore" class="caption settings__caption">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="settings.sound" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement class="settings__column settings__column--second">
                    <ui:Button name="language-toggle" class="settings__toggle settings__toggle--language">
                        <ui:VisualElement name="language-flag" picking-mode="Ignore" class="language-flag settings__language-flag" />
                        <ui:VisualElement picking-mode="Ignore" class="settings__language-badge">
                            <ui:VisualElement picking-mode="Ignore" class="settings__language-chevron" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Label text="LANGUAGE" picking-mode="Ignore" class="caption settings__caption">
                        <Bindings>
                            <Bugord.App.Localization.LocalizedText property="text" key="settings.language" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="settings-back" class="button button--white settings__back">
                <ui:VisualElement picking-mode="Ignore" class="button__face" />
                <ui:Label text="BACK" picking-mode="Ignore" class="button__label settings__back-label">
                    <Bindings>
                        <Bugord.App.Localization.LocalizedText property="text" key="common.back" />
                    </Bindings>
                </ui:Label>
            </ui:Button>
            <ui:VisualElement name="language-list" class="language-list">
                <ui:VisualElement picking-mode="Ignore" name="language-notch" class="language-list__notch" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
