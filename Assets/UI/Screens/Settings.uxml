<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="settings" class="screen screen--dimmed settings">
        <Style src="../ui_screens.uss" />
        <ui:VisualElement class="card settings__card">
            <ui:VisualElement picking-mode="Ignore" class="stroke settings__title">
                <ui:Label text="SETTINGS" picking-mode="Ignore" class="display settings__title-text" />
                <ui:Label text="SETTINGS" picking-mode="Ignore" class="display settings__title-text stroke__face" />
            </ui:VisualElement>
            <ui:VisualElement class="settings__toggles">
                <ui:VisualElement class="settings__column">
                    <ui:Button name="music-toggle" class="settings__toggle">
                        <ui:VisualElement picking-mode="Ignore" class="note">
                            <ui:VisualElement picking-mode="Ignore" class="note__head" />
                            <ui:VisualElement picking-mode="Ignore" class="note__head note__head--second" />
                            <ui:VisualElement picking-mode="Ignore" class="note__stem" />
                            <ui:VisualElement picking-mode="Ignore" class="note__stem note__stem--second" />
                            <ui:VisualElement picking-mode="Ignore" class="note__beam" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="settings__slash" />
                    </ui:Button>
                    <ui:Label text="MUSIC" picking-mode="Ignore" class="caption settings__caption" />
                </ui:VisualElement>
                <ui:VisualElement class="settings__column settings__column--second">
                    <ui:Button name="sound-toggle" class="settings__toggle">
                        <ui:VisualElement picking-mode="Ignore" class="speaker">
                            <ui:VisualElement picking-mode="Ignore" class="speaker__box" />
                            <ui:VisualElement picking-mode="Ignore" class="speaker__cone" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="settings__slash" />
                    </ui:Button>
                    <ui:Label text="SOUND" picking-mode="Ignore" class="caption settings__caption" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="settings-back" class="button button--green settings__back">
                <ui:VisualElement picking-mode="Ignore" class="button__face" />
                <ui:VisualElement picking-mode="Ignore" class="stroke">
                    <ui:Label text="BACK" picking-mode="Ignore" class="button__label" />
                    <ui:Label text="BACK" picking-mode="Ignore" class="button__label stroke__face" />
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
